+) -> Iterator[None]:
+    """Observe the two direct validation subprocesses without changing their Boolean results."""
+    sources = {
+        "compiler.EggLogCompiler": "lib/compiler/EggLogCompiler.py",
+        "patterns.PatternUtils": "lib/patterns/PatternUtils.py",
