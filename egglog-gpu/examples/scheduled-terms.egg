; Each path creates a term. Multiple derivations of the same application must
; intern one id; equality then propagates through constructor views.
(datatype Term (Node i64) (Pair Term Term))
(relation edge (i64 i64))
(relation path (i64 i64))
(relation made (Term))
(ruleset seed)
(ruleset close)
(ruleset build)
(rule ((edge a b)) ((path a b)) :ruleset seed)
(rule ((path a b) (edge b c)) ((path a c)) :ruleset close)
(rule ((path a b)) ((made (Pair (Node a) (Node b)))) :ruleset build)
(edge 1 2)
(edge 2 3)
(run-schedule (run seed) (saturate close) (run build))
(check (made (Pair (Node 1) (Node 3))))
; A later writer must wake a previously saturated reader.
(edge 3 4)
(run-schedule (run seed) (saturate close) (repeat 2 (run build)))
(check (made (Pair (Node 1) (Node 4))))
(union (Node 3) (Node 4))
(run 1)
(check (= (Pair (Node 1) (Node 3)) (Pair (Node 1) (Node 4))))
(print-size Pair)
