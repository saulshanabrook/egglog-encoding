(datatype T (A) (B))
(sort TVec (Vec T))
(sort TSet (Set T))
(sort TMap (Map T T))
(sort TPair (Pair T T))
(sort TNested (Vec TVec))
(constructor V (TVec) T)
(constructor S (TSet) T)
(constructor M (TMap) T)
(constructor P (TPair) T)
(constructor N (TNested) T)
(V (vec-of (A))) (V (vec-of (B)))
(S (set-of (A) (B))) (S (set-of (B)))
(M (map-insert (map-empty) (A) (A)))
(M (map-insert (map-empty) (B) (B)))
(P (pair (A) (B))) (P (pair (B) (A)))
(N (vec-of (vec-of (A)))) (N (vec-of (vec-of (B))))
(push)
(union (A) (B))
(run 1)
(check (= (V (vec-of (A))) (V (vec-of (B)))))
(check (= (S (set-of (A) (B))) (S (set-of (B)))))
(check (= (M (map-insert (map-empty) (A) (A)))
          (M (map-insert (map-empty) (B) (B)))))
(check (= (P (pair (A) (B))) (P (pair (B) (A)))))
(check (= (N (vec-of (vec-of (A)))) (N (vec-of (vec-of (B))))))
(pop)
(fail (check (= (A) (B))))
(fail (check (= (V (vec-of (A))) (V (vec-of (B))))))
