)

(check
  (= churchroad_reproduction_3_s0 (PrimitiveInterfaceDSP churchroad_reproduction_3_s1 churchroad_reproduction_3_s2))
  (= churchroad_reproduction_3_s2 (Wire churchroad_reproduction_3_s3 churchroad_reproduction_3_s4))
  (= churchroad_reproduction_3_s4 16)
  (= churchroad_reproduction_3_s3 "v1-1790317574095254000")
  (= churchroad_reproduction_3_s1 (Wire churchroad_reproduction_3_s5 churchroad_reproduction_3_s4))
  (= churchroad_reproduction_3_s5 "v0-1790317574095254000")
  (= churchroad_reproduction_3_o0 (PrimitiveInterfaceDSP churchroad_reproduction_3_o1 churchroad_reproduction_3_o2))
  (= churchroad_reproduction_3_o2 (Var churchroad_reproduction_3_o3 churchroad_reproduction_3_o4))
  (= churchroad_reproduction_3_o4 16)
  (= churchroad_reproduction_3_o3 "b")
  (= churchroad_reproduction_3_o1 (Var churchroad_reproduction_3_o5 churchroad_reproduction_3_o4))
  (= churchroad_reproduction_3_o5 "a")
  (= churchroad_reproduction_3_o0 churchroad_reproduction_3_s0)
)

