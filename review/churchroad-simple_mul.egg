  (= churchroad_reproduction_0_s6 "a")
  (= churchroad_reproduction_0_s1 (Mul))
  (= churchroad_reproduction_0_o0 (PrimitiveInterfaceDSP churchroad_reproduction_0_o1 churchroad_reproduction_0_o2))
  (= churchroad_reproduction_0_o2 (Var churchroad_reproduction_0_o3 churchroad_reproduction_0_o4))
