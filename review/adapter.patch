+def test_eggcc_dag_lookups_reject_disconnected_selected_facts(eggcc_lookup_inputs: tuple) -> None:
+    source, graph, trace, checks, roots, anchors = copy.deepcopy(eggcc_lookup_inputs)
+    trace = trace.replace(
