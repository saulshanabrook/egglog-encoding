  (= churchroad_reproduction_0_s12 (Var churchroad_reproduction_0_s13 churchroad_reproduction_0_s14))
  (= churchroad_reproduction_0_s14 16)
  (= churchroad_reproduction_0_s13 "a")
  (= churchroad_reproduction_0_s1 (Mul))
  (= churchroad_reproduction_0_o0 (PrimitiveInterfaceDSP churchroad_reproduction_0_o1 churchroad_reproduction_0_o2))
  (= churchroad_reproduction_0_o2 (Op1 churchroad_reproduction_0_o3 churchroad_reproduction_0_o4))
  (= churchroad_reproduction_0_o4 (Var churchroad_reproduction_0_o5 churchroad_reproduction_0_o6))
  (= churchroad_reproduction_0_o6 32)
  (= churchroad_reproduction_0_o5 "b")
  (= churchroad_reproduction_0_o3 (Extract churchroad_reproduction_0_o7 churchroad_reproduction_0_o8))
  (= churchroad_reproduction_0_o8 0)
  (= churchroad_reproduction_0_o7 15)
