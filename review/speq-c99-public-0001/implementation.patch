+def test_fresh_frontends_use_exact_scoped_flags_and_full_comparison(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    calls = []
+
+    def application(*args: Any, **kwargs: Any) -> list[str]:
