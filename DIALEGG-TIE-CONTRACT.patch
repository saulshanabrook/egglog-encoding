+def _sexpr(tokens: list[str]) -> list[Any]:
+    """Parse already-tokenized closed forms for typed constructor accounting."""
+    stack: list[list[Any]] = [[]]
+    for token in tokens:
+        if token == "(":
+            child: list[Any] = []
+            stack[-1].append(child)
+            stack.append(child)
+        elif token == ")":
+            stack.pop()
+        else:
+            stack[-1].append(token)
+    return cast(list[Any], stack[0][0])
