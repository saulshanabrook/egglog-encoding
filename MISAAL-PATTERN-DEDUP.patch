+def test_failed_phase_is_retained_and_restores(original: tuple[ModuleType, dict[str, Any]]) -> None:
+    module, request = original
+    record: dict[str, Any] = {}
+    original_function = module.create_patterns
+    with (
+        pytest.raises(KeyError),
