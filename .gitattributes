# Syrupy's Amber serializer indents blank snapshot lines by design.
benchmarking/tests/__snapshots__/*.ambr -whitespace

# Prepared compiler inputs are data; source adaptations retain upstream whitespace.
benchmarks/corpus/**/*.egg linguist-generated=true -whitespace
# Frozen Slotted programs/specs are generated; review their source and manifests.
benchmarks/slotted/inputs/**/*.egg linguist-generated=true
benchmarks/slotted/inputs/**/*.ref linguist-generated=true
benchmarks/slotted/correctness/**/*.egg linguist-generated=true
benchmarks/slotted/correctness/**/*.ref linguist-generated=true
benchmarks/lmfao/*.conf -whitespace
benchmarks/lmfao/workload.json linguist-generated=true
benchmarks/lmfao/inputs/*.egg linguist-generated=true
benchmarks/reproduction/patches/*.diff -whitespace
benchmarks/reproduction/lmfao/*.patch -whitespace
benchmarks/reproduction/fixtures/** -whitespace
egglog-experimental/tests/slotted/snapshots/*.snap linguist-generated=true
