{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Math absolute runtime and peak RSS distributions use standard gray/black boxplots with medians, interquartile ranges, 1.5-IQR whiskers and generated outliers only. Four explicitly labelled engine/proof conditions share each metric axis. Within-engine checked/off ratios are arithmetic-mean estimates with capped independent Fieller 95% intervals and a 1x guide. Actual means and Student-t mean intervals remain in the numeric exports.",
  "data": {
    "url": "../../.reports-grouped.json",
    "format": {"type": "json"}
  },
  "params": [
    {"name": "target_label", "value": "figures"},
    {"name": "timeout_sec", "value": 500},
    {"name": "rounds", "value": 10},
    {"name": "t_critical", "value": 2.2621571628540993},
    {"name": "selected_inputs", "value": []},
    {"name": "source_blockers", "value": []}
  ],
  "config": {
    "font": "Arial",
    "boxplot": {"box": {"color": "#333333"}},
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 13, "gridColor": "#e8eaed", "titlePadding": 10, "titleFontWeight": "normal"},
    "legend": {"labelFontSize": 13, "title": null, "orient": "top"},
    "title": {"anchor": "start", "fontSize": 18, "subtitleFontSize": 13, "subtitlePadding": 8, "subtitleLineHeight": 16}
  },
  "transform": [
    {"calculate": "[datum.groups, [null]]", "as": "batches"},
    {"flatten": [ "batches" ], "as": [ "candidates" ]},
    {"flatten": [ "candidates" ], "as": [ "group" ]},
    {"filter": "!isValid(datum.group) || (indexof(datum.group.labels, target_label) >= 0 && datum.group.key.disequality_encoding === 'ee')"},
    {"calculate": "isValid(datum.group) ? datum.group.key.file_sha256 + '/' + datum.group.key.treatment + '/' + datum.group.key.binary_sha256 : ''", "as": "group_id"},
    {
      "aggregate": [{"op": "values", "as": "observed"}]
    },
    {"calculate": "pluck(datum.observed, 'group_id')", "as": "group_ids"},
    {"calculate": "pluck(datum.observed, 'group')", "as": "groups"},
    {"calculate": "selected_inputs", "as": "inputs"},
    {"flatten": [ "inputs" ], "as": [ "input" ]},
    {"calculate": "datum.input.file_sha256 + '/' + datum.input.treatment + '/' + datum.input.binary_sha256", "as": "input_id"},
    {"calculate": "indexof(datum.group_ids, datum.input_id)", "as": "group_index"},
    {"calculate": "datum.group_index >= 0 ? datum.groups[datum.group_index] : null", "as": "group"},
    {"calculate": "isValid(datum.group)", "as": "eligible_group"},
    {"calculate": "datum.eligible_group ? datum.group.samples : []", "as": "observations"},
    {"calculate": "datum.eligible_group ? datum.input.selected_row_indices : []", "as": "sample_indices"},
    {"calculate": "length(datum.sample_indices)", "as": "sample_n"},
    {"calculate": "datum.input.validation_issue || (indexof(['proofs','proof-extraction','proof-testing'], datum.input.treatment) >= 0 && datum.eligible_group && datum.input.validation_failures ? datum.input.validation_failures[datum.group.key.binary_sha256 + '/ee'] || '' : '')", "as": "validation_issue"},
    {"calculate": "datum.sample_n ? datum.sample_indices : [null]", "as": "runs"},
    {"flatten": [ "runs" ], "as": [ "row_index" ]},
    {"calculate": "isValid(datum.row_index) ? datum.observations[indexof(pluck(datum.observations, 'row_index'), datum.row_index)] : null", "as": "run"},
    {"calculate": "['Runtime','Peak RSS']", "as": "metrics"},
    {"flatten": [ "metrics" ], "as": [ "metric" ]},
    {"calculate": "isValid(datum.run) && datum.run.status === 'success' ? (datum.metric === 'Runtime' ? (isValid(datum.run.wall_sec) && isFinite(datum.run.wall_sec) && datum.run.wall_sec >= 0 ? datum.run.wall_sec : null) : (isValid(datum.run.max_rss_bytes) && isFinite(datum.run.max_rss_bytes) && datum.run.max_rss_bytes > 0 ? datum.run.max_rss_bytes / 1048576 : null)) : null", "as": "value"},
    {"calculate": "isValid(datum.run) && datum.run.status !== 'success' ? 1 : 0", "as": "failed"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'timed-out' ? 1 : 0", "as": "timed_out"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'memory-limited' ? 1 : 0", "as": "memory_limited"},
    {
      "joinaggregate": [{"op": "valid", "field": "value", "as": "valid_n"}, {"op": "mean", "field": "value", "as": "sample_mean"}, {"op": "variance", "field": "value", "as": "sample_variance"}, {"op": "sum", "field": "failed", "as": "failed_n"}, {"op": "sum", "field": "timed_out", "as": "timeout_n"}, {"op": "sum", "field": "memory_limited", "as": "memory_limit_n"}],
      "groupby": ["input_id", "metric"]
    },
    {"calculate": "!datum.input.exclusion && datum.sample_n === rounds && datum.valid_n === rounds && !datum.validation_issue", "as": "complete"},
    {"calculate": "datum.complete ? datum.sample_mean : null", "as": "mean"},
    {"calculate": "datum.complete && rounds > 1 ? datum.sample_variance / rounds : null", "as": "var_mean"},
    {"calculate": "datum.complete && rounds > 1 ? datum.mean - t_critical * sqrt(datum.var_mean) : null", "as": "ci_low"},
    {"calculate": "datum.complete && rounds > 1 ? datum.mean + t_critical * sqrt(datum.var_mean) : null", "as": "ci_high"},
    {"calculate": "datum.input.exclusion ? 'excluded (' + datum.input.exclusion.kind + '): ' + datum.input.exclusion.reason : (datum.validation_issue || (datum.failed_n ? datum.sample_n + '/' + rounds + ' observations; ' + datum.failed_n + ' failed' + (datum.timeout_n ? ', ' + datum.timeout_n + ' timeout' : '') + (datum.memory_limit_n ? ', ' + datum.memory_limit_n + ' memory limit' : '') + '; estimate unavailable' : datum.valid_n < datum.sample_n ? datum.sample_n + '/' + rounds + ' observations; measurement unavailable; no estimate' : datum.sample_n < rounds ? datum.sample_n + '/' + rounds + ' observations; estimate unavailable' : rounds === 1 ? 'n=1; CI unavailable' : '') )", "as": "issue"},
    {
      "window": [{"op": "row_number", "as": "run_number"}],
      "sort": [{"field": "run.row_index", "order": "ascending"}],
      "groupby": ["input_id", "metric"]
    },
    {"calculate": "indexof(['egg','egg-proof-testing'],datum.input.treatment) >= 0 ? 'Egg' : 'Egglog'", "as": "engine"},
    {"calculate": "indexof(['egg','off'],datum.input.treatment) >= 0 ? 'Off' : 'Checked'", "as": "mode"},
    {"calculate": "datum.mode + ' · ' + datum.engine", "as": "condition"},
    {"calculate": "datum.condition + ': ' + datum.issue", "as": "condition_status"},
    {"calculate": "isValid(datum.value) ? datum.value : 0", "as": "absolute_high"},
    {"calculate": "datum.engine + ': ' + (datum.input.exclusion ? 'excluded (' + datum.input.exclusion.kind + ')' : datum.validation_issue ? 'strict proof validation failed' : datum.failed_n ? datum.sample_n + '/' + rounds + '; ' + datum.failed_n + ' failed' + (datum.timeout_n ? ', ' + datum.timeout_n + ' timeout' : '') + (datum.memory_limit_n ? ', ' + datum.memory_limit_n + ' memory limit' : '') : datum.valid_n < datum.sample_n ? 'metric unavailable' : datum.sample_n < rounds ? datum.sample_n + '/' + rounds + ' runs' : 'n=1; CI unavailable')", "as": "issue_lines"},
    {"calculate": "datum.metric === 'Runtime' ? datum.absolute_high : 0", "as": "runtime_absolute_high"},
    {"extent": "runtime_absolute_high", "param": "runtime_absolute_high_extent"},
    {"calculate": "datum.metric === 'Peak RSS' ? datum.absolute_high : 0", "as": "memory_absolute_high"},
    {"extent": "memory_absolute_high", "param": "memory_absolute_high_extent"}
  ],
  "vconcat": [
    {
      "facet": {
        "column": {
          "field": "metric",
          "type": "nominal",
          "sort": ["Runtime", "Peak RSS"],
          "header": {"title": null, "labelFontSize": 14, "labelFontWeight": "bold", "labels": true}
        }
      },
      "spec": {
        "width": 230,
        "height": {"step": 32},
        "layer": [
          {
            "name": "absolute_boxplots",
            "transform": [{"filter": "datum.complete"}],
            "mark": {
              "type": "boxplot",
              "extent": 1.5,
              "size": 18,
              "box": {"color": "#d9d9d9", "stroke": "#333333", "strokeWidth": 1},
              "median": {"color": "#111111", "strokeWidth": 1.3},
              "rule": {"color": "#333333", "strokeWidth": 1},
              "ticks": {"color": "#333333", "size": 10, "strokeWidth": 1},
              "outliers": {"color": "#111111", "filled": true, "size": 14}
            },
            "encoding": {
              "x": {"field": "value"}
            }
          },
          {
            "name": "absolute_status",
            "transform": [{"filter": "datum.run_number === 1 && datum.issue"}],
            "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 10, "fontWeight": "bold"},
            "encoding": {
              "x": {"value": 0},
              "text": {"field": "issue_lines"},
              "tooltip": [{"field": "condition_status"}]
            }
          }
        ],
        "encoding": {
          "x": {
            "field": "value",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": {"expr": "[0, (parent.metric === 'Runtime' ? runtime_absolute_high_extent : memory_absolute_high_extent)[1] > 0 ? (parent.metric === 'Runtime' ? runtime_absolute_high_extent : memory_absolute_high_extent)[1] : 1]"},
              "padding": 6,
              "nice": false
            },
            "axis": {
              "format": "~f",
              "tickCount": 5,
              "grid": false,
              "title": {"expr": "parent.metric === 'Runtime' ? 'Time (s)' : 'Peak RSS (MiB)'"},
              "offset": 20
            }
          },
          "y": {
            "field": "condition",
            "type": "nominal",
            "title": null,
            "axis": {"labelLimit": 190, "minExtent": 158, "maxExtent": 158, "labelExpr": "replace(replace(datum.label,'Off · ','Proofs off · '),'Checked · ','Checked proofs · ')"},
            "scale": {"domain": [ "Off · Egg", "Off · Egglog", "Checked · Egg", "Checked · Egglog" ]}
          }
        }
      },
      "resolve": {
        "scale": {"x": "independent"}
      },
      "spacing": 24
    },
    {
      "transform": [
        {"filter": "datum.run_number === 1"},
        {
          "aggregate": [{"op": "values", "as": "conditions"}],
          "groupby": ["engine", "metric"]
        },
        {"calculate": "datum.conditions[indexof(pluck(datum.conditions,'mode'),'Off')]", "as": "baseline"},
        {"calculate": "datum.conditions[indexof(pluck(datum.conditions,'mode'),'Checked')]", "as": "candidate"},
        {"calculate": "isValid(datum.candidate) && datum.candidate.input.exclusion ? datum.candidate : isValid(datum.baseline) && datum.baseline.input.exclusion ? datum.baseline : null", "as": "ratio_excluded"},
        {"calculate": "isValid(datum.baseline) && isValid(datum.candidate) && datum.baseline.complete && datum.candidate.complete && datum.baseline.mean > 0 ? datum.candidate.mean / datum.baseline.mean : null", "as": "ratio"},
        {"calculate": "isValid(datum.baseline) ? datum.baseline.mean * datum.baseline.mean - t_critical * t_critical * datum.baseline.var_mean : null", "as": "a"},
        {"calculate": "isValid(datum.candidate) ? datum.candidate.mean * datum.candidate.mean - t_critical * t_critical * datum.candidate.var_mean : null", "as": "d"},
        {"calculate": "isValid(datum.baseline) && isValid(datum.candidate) ? pow(datum.baseline.mean * datum.candidate.mean,2) - datum.a * datum.d : null", "as": "radicand"},
        {"calculate": "isValid(datum.ratio) && rounds > 1 && datum.a > 0 && datum.radicand >= 0", "as": "bounded"},
        {"calculate": "datum.bounded ? (datum.baseline.mean * datum.candidate.mean - sqrt(datum.radicand)) / datum.a : null", "as": "ratio_low"},
        {"calculate": "datum.bounded ? (datum.baseline.mean * datum.candidate.mean + sqrt(datum.radicand)) / datum.a : null", "as": "ratio_high"},
        {"calculate": "datum.engine + ': ' + (isValid(datum.ratio_excluded) ? 'Ratio unavailable: ' + datum.ratio_excluded.condition + ': ' + datum.ratio_excluded.issue : !isValid(datum.ratio) ? 'Ratio unavailable: incomplete or invalid sample' : rounds === 1 ? format(datum.ratio,'.3g') + '×; CI unavailable (n=1)' : !datum.bounded ? format(datum.ratio,'.3g') + '×; Fieller interval unbounded or unavailable' : format(datum.ratio,'.3g') + '× [' + format(datum.ratio_low,'.3g') + ', ' + format(datum.ratio_high,'.3g') + ']')", "as": "ratio_summary"},
        {"calculate": "max(1, isValid(datum.ratio) ? datum.ratio : 0, isValid(datum.ratio_high) ? datum.ratio_high : 0)", "as": "ratio_upper"},
        {"calculate": "min(0, isValid(datum.ratio_low) ? datum.ratio_low : 0)", "as": "ratio_lower"},
        {"calculate": "datum.metric === 'Runtime' ? datum.ratio_lower : 0", "as": "runtime_ratio_low"},
        {"extent": "runtime_ratio_low", "param": "runtime_ratio_low_extent"},
        {"calculate": "datum.metric === 'Runtime' ? datum.ratio_upper : 0", "as": "runtime_ratio_high"},
        {"extent": "runtime_ratio_high", "param": "runtime_ratio_high_extent"},
        {"calculate": "datum.metric === 'Peak RSS' ? datum.ratio_lower : 0", "as": "memory_ratio_low"},
        {"extent": "memory_ratio_low", "param": "memory_ratio_low_extent"},
        {"calculate": "datum.metric === 'Peak RSS' ? datum.ratio_upper : 0", "as": "memory_ratio_high"},
        {"extent": "memory_ratio_high", "param": "memory_ratio_high_extent"},
        {"calculate": "isValid(datum.ratio_excluded) ? 'Ratio unavailable\\n' + datum.ratio_excluded.mode + ' excluded (' + datum.ratio_excluded.input.exclusion.kind + ')' : !isValid(datum.ratio) ? 'Ratio unavailable\\nIncomplete or invalid sample' : rounds === 1 ? format(datum.ratio,'.3g') + '×; CI unavailable (n=1)' : !datum.bounded ? format(datum.ratio,'.3g') + '×; Fieller interval unbounded\\nor unavailable' : format(datum.ratio,'.3g') + '× [' + format(datum.ratio_low,'.3g') + ', ' + format(datum.ratio_high,'.3g') + ']'", "as": "ratio_label"}
      ],
      "facet": {
        "column": {
          "field": "metric",
          "type": "nominal",
          "sort": ["Runtime", "Peak RSS"],
          "header": {"title": null, "labelFontSize": 14, "labelFontWeight": "bold", "labels": false}
        }
      },
      "spec": {
        "width": 230,
        "height": {"step": 52},
        "encoding": {
          "x": {
            "field": "ratio",
            "type": "quantitative",
            "title": "Checked / off",
            "scale": {
              "domain": {"expr": "[min(0, (parent.metric === 'Runtime' ? runtime_ratio_low_extent : memory_ratio_low_extent)[0]), (parent.metric === 'Runtime' ? runtime_ratio_high_extent : memory_ratio_high_extent)[1] > 0 ? (parent.metric === 'Runtime' ? runtime_ratio_high_extent : memory_ratio_high_extent)[1] : 1]"},
              "padding": 6,
              "nice": false
            },
            "axis": {"labelExpr": "format(datum.value, '~f') + '×'", "tickCount": 4, "grid": false, "offset": 20}
          },
          "y": {
            "field": "engine",
            "type": "nominal",
            "title": null,
            "axis": {"minExtent": 112, "maxExtent": 112},
            "scale": {"domain": [ "Egg", "Egglog" ]}
          }
        },
        "layer": [
          {
            "name": "ratio_equal",
            "transform": [
              {"window": [{"op": "row_number", "as": "reference_index"}], "groupby": ["metric"]},
              {"filter": "datum.reference_index === 1"}
            ],
            "mark": {"type": "rule", "strokeWidth": 1, "color": "#727880", "strokeDash": [ 3, 3 ]},
            "encoding": {
              "x": {"datum": 1},
              "y": {"value": 0},
              "y2": {
                "value": 104
              }
            }
          },
          {
            "name": "ratio_intervals",
            "transform": [{"filter": "datum.bounded"}],
            "mark": {"type": "rule", "strokeWidth": 1.2, "color": "#111111"},
            "encoding": {
              "x": {"field": "ratio_low"},
              "x2": {"field": "ratio_high"}
            }
          },
          {
            "name": "ratio_cap_low",
            "transform": [{"filter": "datum.bounded"}],
            "mark": {"type": "tick", "orient": "vertical", "size": 8, "thickness": 1.2, "color": "#111111"},
            "encoding": {
              "x": {"field": "ratio_low"}
            }
          },
          {
            "name": "ratio_cap_high",
            "transform": [{"filter": "datum.bounded"}],
            "mark": {"type": "tick", "orient": "vertical", "size": 8, "thickness": 1.2, "color": "#111111"},
            "encoding": {
              "x": {"field": "ratio_high"}
            }
          },
          {
            "name": "ratio_points",
            "transform": [{"filter": "isValid(datum.ratio)"}],
            "mark": {"type": "point", "filled": true, "size": 28, "color": "#111111", "shape": "square"},
            "encoding": {
              "x": {"field": "ratio"},
              "tooltip": [{"field": "metric"}, {"field": "engine"}, {"field": "ratio"}, {"field": "ratio_low"}, {"field": "ratio_high"}]
            }
          },
          {
            "name": "ratio_status",
            "mark": {"type": "text", "align": "left", "baseline": "top", "dy": 13, "fontSize": 12, "lineBreak": "\n", "lineHeight": 13},
            "encoding": {
              "x": {"value": 0},
              "text": {"field": "ratio_label"},
              "tooltip": [{"field": "ratio_summary"}]
            },
            "transform": [{"filter": "!datum.bounded"}]
          }
        ]
      },
      "resolve": {
        "scale": {"x": "independent"}
      },
      "spacing": 24
    }
  ],
  "spacing": 18
}
