{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Paper figure. Shared cache selection supplies row IDs; the visible Vega transforms compute statistics. The runner binds selected_inputs, the report URL and scalar invocation parameters.",
  "data": {
    "url": "../../.reports-grouped.json",
    "format": {
      "type": "json"
    }
  },
  "params": [
    {"name": "target_label", "value": "figures"},
    {"name": "timeout_sec", "value": 300},
    {"name": "rounds", "value": 10},
    {"name": "t_critical", "value": 2.2621571628540993},
    {"name": "selected_inputs", "value": []},
    {"name": "source_blockers", "value": []}
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e8eaed",
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 11,
      "title": null,
      "orient": "top"
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 11,
      "subtitlePadding": 8
    }
  },
  "title": {
    "text": "Math: runtime",
    "subtitle": [
      "Twelve fixed rounds · same four configurations and process executions in runtime and memory figures",
      "Dots: runs. Absolute intervals: 95% Student-t. Ratio intervals: independent-sample 95% Fieller."
    ]
  },
  "transform": [
    {"calculate": "[datum.groups, [null]]", "as": "batches"},
    {"flatten": ["batches"], "as": ["candidates"]},
    {"flatten": ["candidates"], "as": ["group"]},
    {"filter": "!isValid(datum.group) || (indexof(datum.group.labels, target_label) >= 0 && datum.group.key.disequality_encoding === 'nee')"},
    {"calculate": "isValid(datum.group) ? datum.group.key.file_sha256 + '/' + datum.group.key.fact_directory_sha256 + '/' + datum.group.key.treatment : ''", "as": "group_id"},
    {"aggregate": [{"op": "values", "as": "observed"}]},
    {"calculate": "pluck(datum.observed, 'group_id')", "as": "group_ids"},
    {"calculate": "pluck(datum.observed, 'group')", "as": "groups"},
    {"calculate": "selected_inputs", "as": "inputs"},
    {"flatten": ["inputs"], "as": ["input"]},
    {"calculate": "datum.input.file_sha256 + '/' + datum.input.fact_directory_sha256 + '/' + datum.input.treatment", "as": "input_id"},
    {"calculate": "indexof(datum.group_ids, datum.input_id)", "as": "group_index"},
    {"calculate": "datum.group_index >= 0 ? datum.groups[datum.group_index] : null", "as": "group"},
    {"calculate": "isValid(datum.group)", "as": "eligible_group"},
    {"calculate": "datum.eligible_group ? datum.group.samples : []", "as": "observations"},
    {"calculate": "datum.eligible_group ? datum.input.selected_row_indices : []", "as": "sample_indices"},
    {"calculate": "length(datum.sample_indices)", "as": "sample_n"},
    {"calculate": "datum.input.treatment === 'proof-testing' && datum.eligible_group && datum.input.validation_failures ? datum.input.validation_failures[datum.group.key.binary_sha256 + '/nee'] || '' : ''", "as": "validation_issue"},
    {"calculate": "datum.sample_n ? datum.sample_indices : [null]", "as": "runs"},
    {"flatten": ["runs"], "as": ["row_index"]},
    {"calculate": "isValid(datum.row_index) ? datum.observations[indexof(pluck(datum.observations, 'row_index'), datum.row_index)] : null", "as": "run"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'success' && isValid(datum.run.wall_sec) && isFinite(datum.run.wall_sec) && datum.run.wall_sec >= 0 ? datum.run.wall_sec : null", "as": "value"},
    {"calculate": "isValid(datum.run) && datum.run.status !== 'success' ? 1 : 0", "as": "failed"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'timed-out' ? 1 : 0", "as": "timed_out"},
    {"calculate": "isValid(datum.run) && (datum.run.error_exit_code === 86 || datum.run.error_message && (indexof(datum.run.error_message, 'process-group RSS') >= 0 || indexof(datum.run.error_message, 'memory-limit') >= 0 || indexof(datum.run.error_message, 'memory limit') >= 0)) ? 1 : 0", "as": "memory_limited"},
    {"joinaggregate": [{"op": "valid", "field": "value", "as": "valid_n"}, {"op": "mean", "field": "value", "as": "sample_mean"}, {"op": "variance", "field": "value", "as": "sample_variance"}, {"op": "sum", "field": "failed", "as": "failed_n"}, {"op": "sum", "field": "timed_out", "as": "timeout_n"}, {"op": "sum", "field": "memory_limited", "as": "memory_limit_n"}], "groupby": ["input_id"]},
    {"calculate": "datum.sample_n === rounds && datum.valid_n === rounds && !datum.validation_issue", "as": "complete"},
    {"calculate": "datum.complete ? datum.sample_mean : null", "as": "mean"},
    {"calculate": "datum.complete && rounds > 1 ? datum.sample_variance / rounds : null", "as": "var_mean"},
    {"calculate": "datum.complete && rounds > 1 ? datum.mean - t_critical * sqrt(datum.var_mean) : null", "as": "ci_low"},
    {"calculate": "datum.complete && rounds > 1 ? datum.mean + t_critical * sqrt(datum.var_mean) : null", "as": "ci_high"},
    {"calculate": "datum.validation_issue || (datum.failed_n ? datum.sample_n + '/' + rounds + ' observations; ' + datum.failed_n + ' failed' + (datum.timeout_n ? ', ' + datum.timeout_n + ' timeout' : '') + (datum.memory_limit_n ? ', ' + datum.memory_limit_n + ' memory limit' : '') + '; estimate unavailable' : datum.valid_n < datum.sample_n ? datum.sample_n + '/' + rounds + ' observations; measurement unavailable; no estimate' : datum.sample_n < rounds ? datum.sample_n + '/' + rounds + ' observations; estimate unavailable' : rounds === 1 ? 'n=1; CI unavailable' : '')", "as": "issue"},
    {"window": [{"op": "row_number", "as": "run_number"}], "sort": [{"field": "run.row_index", "order": "ascending"}], "groupby": ["input_id"]},
    {"calculate": "indexof(['egg','egg-proof-testing'],datum.input.treatment) >= 0 ? 'Egg' : 'Egglog'", "as": "engine"},
    {"calculate": "indexof(['egg','off'],datum.input.treatment) >= 0 ? 'Off' : 'Checked'", "as": "mode"},
    {"calculate": "datum.mode + ' · ' + datum.engine", "as": "condition"},
    {"calculate": "datum.condition + ': ' + datum.issue", "as": "condition_status"},
    {"calculate": "(datum.run_number % 5 - 2) * 3", "as": "jitter"},
    {"calculate": "min(0, isValid(datum.ci_low) ? datum.ci_low : 0)", "as": "absolute_low"},
    {"calculate": "max(1, isValid(datum.value) ? datum.value : 0, isValid(datum.ci_high) ? datum.ci_high : 0)", "as": "absolute_high"},
    {"extent": "absolute_low", "param": "absolute_low_extent"},
    {"extent": "absolute_high", "param": "absolute_high_extent"}
  ],
  "vconcat": [
    {
      "width": 650,
      "height": {
        "step": 36
      },
      "layer": [
        {
          "name": "absolute_runs",
          "transform": [
            {
              "filter": "isValid(datum.value) && !datum.validation_issue"
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "opacity": 0.55,
            "size": 38
          },
          "encoding": {
            "x": {
              "field": "value",
              "type": "quantitative",
              "title": "Whole-process wall time (s)",
              "scale": {
                "domain": {
                  "expr": "[min(0, absolute_low_extent[0]), max(1, absolute_high_extent[1])]"
                }
              },
              "axis": {
                "format": "~g",
                "tickCount": 5
              }
            },
            "y": {
              "field": "condition",
              "type": "nominal",
              "title": null,
              "sort": [
                "Off · Egg",
                "Checked · Egg",
                "Off · Egglog",
                "Checked · Egglog"
              ],
              "axis": {
                "labelLimit": 180
              },
              "scale": {
                "domain": [
                  "Off · Egg",
                  "Checked · Egg",
                  "Off · Egglog",
                  "Checked · Egglog"
                ]
              }
            },
            "color": {
              "field": "engine",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Egg",
                  "Egglog"
                ],
                "range": [
                  "#2a6f97",
                  "#b75d19"
                ]
              },
              "legend": null
            },
            "yOffset": {
              "field": "jitter",
              "type": "quantitative",
              "scale": null
            },
            "tooltip": [
              {
                "field": "condition"
              },
              {
                "field": "value",
                "format": ".5g"
              },
              {
                "field": "sample_n"
              },
              {
                "field": "run.row_index"
              }
            ]
          }
        },
        {
          "name": "absolute_intervals",
          "transform": [
            {
              "filter": "datum.run_number === 1 && isValid(datum.ci_low)"
            }
          ],
          "mark": {
            "type": "rule",
            "strokeWidth": 2,
            "color": "#20252b"
          },
          "encoding": {
            "x": {
              "field": "ci_low",
              "type": "quantitative",
              "title": "Whole-process wall time (s)",
              "scale": {
                "domain": {
                  "expr": "[min(0, absolute_low_extent[0]), max(1, absolute_high_extent[1])]"
                }
              },
              "axis": {
                "format": "~g",
                "tickCount": 5
              }
            },
            "x2": {
              "field": "ci_high"
            },
            "y": {
              "field": "condition",
              "type": "nominal",
              "title": null,
              "sort": [
                "Off · Egg",
                "Checked · Egg",
                "Off · Egglog",
                "Checked · Egglog"
              ],
              "axis": {
                "labelLimit": 180
              },
              "scale": {
                "domain": [
                  "Off · Egg",
                  "Checked · Egg",
                  "Off · Egglog",
                  "Checked · Egglog"
                ]
              }
            }
          }
        },
        {
          "name": "absolute_means",
          "transform": [
            {
              "filter": "datum.run_number === 1 && datum.complete"
            }
          ],
          "mark": {
            "type": "tick",
            "thickness": 2.5,
            "size": 20,
            "color": "#20252b"
          },
          "encoding": {
            "x": {
              "field": "mean",
              "type": "quantitative",
              "title": "Whole-process wall time (s)",
              "scale": {
                "domain": {
                  "expr": "[min(0, absolute_low_extent[0]), max(1, absolute_high_extent[1])]"
                }
              },
              "axis": {
                "format": "~g",
                "tickCount": 5
              }
            },
            "y": {
              "field": "condition",
              "type": "nominal",
              "title": null,
              "sort": [
                "Off · Egg",
                "Checked · Egg",
                "Off · Egglog",
                "Checked · Egglog"
              ],
              "axis": {
                "labelLimit": 180
              },
              "scale": {
                "domain": [
                  "Off · Egg",
                  "Checked · Egg",
                  "Off · Egglog",
                  "Checked · Egglog"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.run_number === 1"
        },
        {
          "aggregate": [
            {
              "op": "values",
              "as": "conditions"
            }
          ],
          "groupby": [
            "engine"
          ]
        },
        {
          "calculate": "datum.conditions[indexof(pluck(datum.conditions,'mode'),'Off')]",
          "as": "baseline"
        },
        {
          "calculate": "datum.conditions[indexof(pluck(datum.conditions,'mode'),'Checked')]",
          "as": "candidate"
        },
        {
          "calculate": "datum.baseline.complete && datum.candidate.complete && datum.baseline.mean > 0 ? datum.candidate.mean / datum.baseline.mean : null",
          "as": "ratio"
        },
        {
          "calculate": "datum.baseline.mean * datum.baseline.mean - t_critical * t_critical * datum.baseline.var_mean",
          "as": "a"
        },
        {
          "calculate": "datum.candidate.mean * datum.candidate.mean - t_critical * t_critical * datum.candidate.var_mean",
          "as": "d"
        },
        {
          "calculate": "pow(datum.baseline.mean * datum.candidate.mean,2) - datum.a * datum.d",
          "as": "radicand"
        },
        {
          "calculate": "isValid(datum.ratio) && rounds > 1 && datum.a > 0 && datum.radicand >= 0",
          "as": "bounded"
        },
        {
          "calculate": "datum.bounded ? (datum.baseline.mean * datum.candidate.mean - sqrt(datum.radicand)) / datum.a : null",
          "as": "ratio_low"
        },
        {
          "calculate": "datum.bounded ? (datum.baseline.mean * datum.candidate.mean + sqrt(datum.radicand)) / datum.a : null",
          "as": "ratio_high"
        },
        {
          "calculate": "datum.engine + ': ' + (!isValid(datum.ratio) ? 'Ratio unavailable: incomplete or invalid sample' : rounds === 1 ? format(datum.ratio,'.3g') + '×; CI unavailable (n=1)' : !datum.bounded ? format(datum.ratio,'.3g') + '×; Fieller interval unbounded or unavailable' : format(datum.ratio,'.3g') + '× [' + format(datum.ratio_low,'.3g') + ', ' + format(datum.ratio_high,'.3g') + ']')",
          "as": "ratio_summary"
        },
        {
          "calculate": "max(1, isValid(datum.ratio) ? datum.ratio : 0, isValid(datum.ratio_high) ? datum.ratio_high : 0)",
          "as": "ratio_upper"
        },
        {
          "calculate": "min(0, isValid(datum.ratio_low) ? datum.ratio_low : 0)",
          "as": "ratio_lower"
        },
        {
          "extent": "ratio_upper",
          "param": "math_ratio_upper"
        },
        {
          "extent": "ratio_lower",
          "param": "math_ratio_lower"
        }
      ],
      "hconcat": [
        {
          "width": 350,
          "height": 110,
          "layer": [
            {
              "mark": {
                "type": "rule",
                "color": "#707780",
                "strokeDash": [
                  4,
                  3
                ]
              },
              "encoding": {
                "x": {
                  "datum": 1
                }
              }
            },
            {
              "name": "ratio_intervals",
              "transform": [
                {
                  "filter": "datum.bounded"
                }
              ],
              "mark": {
                "type": "rule",
                "strokeWidth": 2,
                "color": "#20252b"
              },
              "encoding": {
                "x": {
                  "field": "ratio_low",
                  "type": "quantitative",
                  "title": "Checked / off (ratio of means)",
                  "scale": {
                    "domain": {
                      "expr": "[min(0,math_ratio_lower[0]), max(1,math_ratio_upper[1])]"
                    }
                  },
                  "axis": {
                    "labelExpr": "format(datum.value, '~g') + '×'",
                    "tickCount": 4
                  }
                },
                "x2": {
                  "field": "ratio_high"
                },
                "y": {
                  "field": "engine",
                  "type": "nominal",
                  "sort": [
                    "Egg",
                    "Egglog"
                  ],
                  "title": null,
                  "scale": {
                    "domain": [
                      "Egg",
                      "Egglog"
                    ]
                  }
                }
              }
            },
            {
              "name": "ratio_points",
              "transform": [
                {
                  "filter": "isValid(datum.ratio)"
                }
              ],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 75,
                "color": "#20252b"
              },
              "encoding": {
                "x": {
                  "field": "ratio",
                  "type": "quantitative",
                  "title": "Checked / off (ratio of means)",
                  "scale": {
                    "domain": {
                      "expr": "[min(0,math_ratio_lower[0]), max(1,math_ratio_upper[1])]"
                    }
                  },
                  "axis": {
                    "labelExpr": "format(datum.value, '~g') + '×'",
                    "tickCount": 4
                  }
                },
                "y": {
                  "field": "engine",
                  "type": "nominal",
                  "sort": [
                    "Egg",
                    "Egglog"
                  ],
                  "title": null,
                  "scale": {
                    "domain": [
                      "Egg",
                      "Egglog"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "name": "ratio_status",
          "width": 270,
          "height": 110,
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10
          },
          "encoding": {
            "y": {
              "field": "engine",
              "type": "nominal",
              "sort": [
                "Egg",
                "Egglog"
              ],
              "title": null,
              "axis": null,
              "scale": {
                "domain": [
                  "Egg",
                  "Egglog"
                ]
              }
            },
            "text": {
              "field": "ratio_summary"
            },
            "x": {
              "value": 0
            }
          }
        }
      ]
    },
    {
      "name": "math_status",
      "transform": [
        {
          "filter": "datum.run_number === 1 && datum.issue"
        }
      ],
      "width": 650,
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "color": "#9a3e1c"
      },
      "encoding": {
        "y": {
          "field": "condition",
          "type": "nominal",
          "sort": [
            "Off · Egg",
            "Checked · Egg",
            "Off · Egglog",
            "Checked · Egglog"
          ],
          "axis": null,
          "scale": {
            "domain": [
              "Off · Egg",
              "Checked · Egg",
              "Off · Egglog",
              "Checked · Egglog"
            ]
          }
        },
        "text": {
          "field": "condition_status"
        },
        "x": {
          "value": 0
        }
      }
    }
  ],
  "spacing": 18
}
