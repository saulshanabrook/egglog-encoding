{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Per-kernel/phase arithmetic-mean runtime ratios of extlog to the Slotted reference implementation, sorted in increasing ratio order. Uniform black squares show estimates with capped independent Fieller 95% intervals and a 1x guide. No lines connect workloads. Unavailable and unbounded statuses remain visible; companion exports retain all runtime and peak RSS observations and statistics.",
  "data": {
    "url": "../../data-cache/reports-grouped.json",
    "format": {"type": "json"}
  },
  "params": [
    {"name": "target_label", "value": "figures"},
    {"name": "timeout_sec", "value": 500},
    {"name": "rounds", "value": 10},
    {"name": "t_critical", "value": 2.2621571628540993},
    {"name": "selected_inputs", "value": []},
    {"name": "source_blockers", "value": []}
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 13, "gridColor": "#e8eaed", "titlePadding": 10, "titleFontWeight": "normal", "grid": false},
    "legend": {"labelFontSize": 13, "title": null, "orient": "top", "symbolSize": 45},
    "title": {"anchor": "start", "fontSize": 15, "subtitleFontSize": 12, "subtitlePadding": 8}
  },
  "transform": [
    {"calculate": "[datum.groups, [null]]", "as": "batches"},
    {"flatten": [ "batches" ], "as": [ "candidates" ]},
    {"flatten": [ "candidates" ], "as": [ "group" ]},
    {"filter": "!isValid(datum.group) || indexof(datum.group.labels, target_label) >= 0"},
    {"calculate": "isValid(datum.group) ? datum.group.key.file_sha256 + '/' + datum.group.key.treatment + '/' + datum.group.key.binary_sha256 : ''", "as": "group_id"},
    {
      "aggregate": [{"op": "values", "as": "observed"}]
    },
    {"calculate": "pluck(datum.observed, 'group_id')", "as": "group_ids"},
    {"calculate": "pluck(datum.observed, 'group')", "as": "groups"},
    {"calculate": "selected_inputs", "as": "inputs"},
    {"flatten": [ "inputs" ], "as": [ "input" ]},
    {"calculate": "datum.input.file_sha256 + '/' + datum.input.treatment + '/' + datum.input.binary_sha256", "as": "input_id"},
    {"calculate": "indexof(datum.group_ids, datum.input_id)", "as": "group_index"},
    {"calculate": "datum.group_index >= 0 ? datum.groups[datum.group_index] : null", "as": "group"},
    {"calculate": "isValid(datum.group)", "as": "eligible_group"},
    {"calculate": "datum.eligible_group ? datum.group.samples : []", "as": "observations"},
    {"calculate": "datum.eligible_group ? datum.input.selected_row_indices : []", "as": "sample_indices"},
    {"calculate": "length(datum.sample_indices)", "as": "sample_n"},
    {"calculate": "datum.sample_n ? datum.sample_indices : [null]", "as": "runs"},
    {"flatten": [ "runs" ], "as": [ "row_index" ]},
    {"calculate": "isValid(datum.row_index) ? datum.observations[indexof(pluck(datum.observations, 'row_index'), datum.row_index)] : null", "as": "run"},
    {"calculate": "['Runtime']", "as": "metrics"},
    {"flatten": [ "metrics" ], "as": [ "metric" ]},
    {"calculate": "isValid(datum.run) && datum.run.status === 'success' ? (datum.metric === 'Runtime' ? (isValid(datum.run.wall_sec) && isFinite(datum.run.wall_sec) && datum.run.wall_sec >= 0 ? datum.run.wall_sec : null) : (isValid(datum.run.max_rss_bytes) && isFinite(datum.run.max_rss_bytes) && datum.run.max_rss_bytes > 0 ? datum.run.max_rss_bytes / 1048576 : null)) : null", "as": "value"},
    {"calculate": "isValid(datum.run) && datum.run.status !== 'success' ? 1 : 0", "as": "failed"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'timed-out' ? 1 : 0", "as": "timed_out"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'memory-limited' ? 1 : 0", "as": "memory_limited"},
    {"calculate": "datum.timed_out ? datum.run.timeout_sec : null", "as": "observed_timeout"},
    {"calculate": "isValid(datum.run) ? datum.run.memory_limit_bytes : null", "as": "observed_memory_limit"},
    {
      "joinaggregate": [{"op": "valid", "field": "value", "as": "valid_n"}, {"op": "mean", "field": "value", "as": "sample_mean"}, {"op": "variance", "field": "value", "as": "sample_variance"}, {"op": "sum", "field": "failed", "as": "failed_n"}, {"op": "sum", "field": "timed_out", "as": "timeout_n"}, {"op": "sum", "field": "memory_limited", "as": "memory_limit_n"}, {"op": "max", "field": "observed_timeout", "as": "timeout_bound"}, {"op": "max", "field": "observed_memory_limit", "as": "memory_limit_bytes"}],
      "groupby": ["input_id", "metric"]
    },
    {"calculate": "!datum.input.exclusion && datum.sample_n === rounds && datum.valid_n === rounds", "as": "complete"},
    {"calculate": "datum.complete ? datum.sample_mean : null", "as": "mean"},
    {"calculate": "datum.complete && rounds > 1 ? datum.sample_variance / rounds : null", "as": "var_mean"},
    {"calculate": "datum.complete && rounds > 1 ? datum.mean - t_critical * sqrt(datum.var_mean) : null", "as": "ci_low"},
    {"calculate": "datum.complete && rounds > 1 ? datum.mean + t_critical * sqrt(datum.var_mean) : null", "as": "ci_high"},
    {"calculate": "datum.input.exclusion ? 'excluded (' + datum.input.exclusion.kind + '): ' + datum.input.exclusion.reason : (rounds === 1 && datum.failed_n ? datum.timeout_n ? 'timeout (' + format(datum.timeout_bound,'~f') + ' s)' : datum.memory_limit_n ? 'memory limit' + (isValid(datum.memory_limit_bytes) ? ' (' + format(datum.memory_limit_bytes / pow(1024,3),'~f') + ' GiB)' : '') : 'failed' : (datum.failed_n ? datum.sample_n + '/' + rounds + '; ' + datum.failed_n + ' failed' + (datum.timeout_n ? ', ' + datum.timeout_n + ' timeout' : '') + (datum.memory_limit_n ? ', ' + datum.memory_limit_n + ' memory limit' : '') : !datum.sample_n ? '0/' + rounds + ' runs; missing' : datum.valid_n < datum.sample_n ? datum.sample_n + '/' + rounds + ' runs; metric missing' : datum.sample_n < rounds ? datum.sample_n + '/' + rounds + ' runs; partial' : '') )", "as": "issue"},
    {
      "window": [{"op": "row_number", "as": "run_number"}],
      "sort": [{"field": "run.row_index", "order": "ascending"}],
      "groupby": ["input_id", "metric"]
    },
    {"calculate": "datum.input.logical_id", "as": "logical_id"},
    {"calculate": "replace(replace(datum.input.label, regexp('^.*[/]'), ''), regexp('[.]egg$'), '')", "as": "basename"},
    {"calculate": "indexof(datum.basename,'goal-2d-4f-N') === 0 ? 'Array' : indexof(datum.basename,'-44rules') >= 0 ? 'SDQL' : indexof(datum.basename,'first-order-logic') === 0 ? 'Logic' : 'Other'", "as": "suite"},
    {"calculate": "replace(datum.basename,regexp('_(1st|2nd)-44rules$'),'')", "as": "kernel"},
    {
      "calculate": "(datum.suite === 'SDQL' ? '' : datum.suite + ' · ') + (datum.suite === 'Array' ? replace(datum.basename,'goal-2d-4f-N','N=') : datum.suite === 'SDQL' ? ({'batax':'BATAX','mmm':'MMM','mmm_sum':'ΣMMM','mttkrp':'MTTKRP','ttm':'TTM'}[datum.kernel] || datum.kernel) + (indexof(datum.basename,'_1st-') >= 0 ? ' · 1st' : ' · 2nd') : datum.basename)",
      "as": "workload"
    },
    {"calculate": "indexof(datum.input.treatment,'ref-') >= 0 ? 'Reference' : 'extlog'", "as": "series"},
    {"filter": "datum.run_number === 1"},
    {
      "aggregate": [{"op": "values", "as": "conditions"}],
      "groupby": ["logical_id", "suite", "workload", "metric"]
    },
    {"calculate": "datum.conditions[indexof(pluck(datum.conditions,'series'),'Reference')]", "as": "baseline"},
    {"calculate": "datum.conditions[indexof(pluck(datum.conditions,'series'),'extlog')]", "as": "candidate"},
    {"calculate": "isValid(datum.baseline) && isValid(datum.candidate) && datum.baseline.complete && datum.candidate.complete && datum.baseline.mean > 0 ? datum.candidate.mean / datum.baseline.mean : null", "as": "ratio"},
    {"calculate": "isValid(datum.ratio) && isFinite(datum.ratio) ? datum.ratio : 1e308", "as": "order"},
    {"calculate": "isValid(datum.baseline) ? datum.baseline.mean * datum.baseline.mean - t_critical * t_critical * datum.baseline.var_mean : null", "as": "a"},
    {"calculate": "isValid(datum.candidate) ? datum.candidate.mean * datum.candidate.mean - t_critical * t_critical * datum.candidate.var_mean : null", "as": "d"},
    {"calculate": "isValid(datum.baseline) && isValid(datum.candidate) ? pow(datum.baseline.mean * datum.candidate.mean,2) - datum.a * datum.d : null", "as": "radicand"},
    {"calculate": "isValid(datum.ratio) && isFinite(datum.ratio) && rounds > 1 && datum.a > 0 && datum.radicand >= 0", "as": "bounded"},
    {"calculate": "datum.bounded ? (datum.baseline.mean * datum.candidate.mean - sqrt(datum.radicand)) / datum.a : null", "as": "ratio_low"},
    {"calculate": "datum.bounded ? (datum.baseline.mean * datum.candidate.mean + sqrt(datum.radicand)) / datum.a : null", "as": "ratio_high"},
    {"calculate": "!isValid(datum.ratio) ? (!isValid(datum.baseline) ? 'Reference missing' : !datum.baseline.complete ? 'Reference: ' + datum.baseline.issue : datum.baseline.mean <= 0 ? 'Reference mean ≤0' : '') + (!isValid(datum.candidate) || !datum.candidate.complete ? (!isValid(datum.baseline) || !datum.baseline.complete || datum.baseline.mean <= 0 ? '\\n' : '') + 'extlog: ' + (isValid(datum.candidate) ? datum.candidate.issue : 'missing') : '') : rounds === 1 ? 'n=1; CI unavailable' : !datum.bounded ? 'CI unbounded or unavailable' : ''", "as": "summary"},
    {"calculate": "max(1, isValid(datum.ratio) ? datum.ratio : 0, isValid(datum.ratio_high) ? datum.ratio_high : 0)", "as": "ratio_upper"},
    {"calculate": "min(0, isValid(datum.ratio_low) ? datum.ratio_low : 0)", "as": "ratio_lower"},
    {"extent": "ratio_lower", "param": "ratio_low_extent"},
    {"extent": "ratio_upper", "param": "ratio_high_extent"}
  ],
  "spacing": 24,
  "resolve": {
    "scale": {"x": "shared", "y": "shared"}
  },
  "facet": {
    "column": {
      "field": "metric",
      "type": "nominal",
      "sort": ["Runtime"],
      "header": {"title": null, "labelFontSize": 14, "labelFontWeight": "bold"}
    }
  },
  "spec": {
    "width": 500,
    "height": {"step": 30},
    "encoding": {
      "x": {
        "type": "quantitative",
        "scale": {
          "domain": {"expr": "[min(0, ratio_low_extent[0]), max(1, ratio_high_extent[1]) * 1.05]"},
          "type": "symlog",
          "constant": 0.1,
          "padding": 6,
          "nice": false
        },
        "axis": {"title": "extlog / Reference (symlog)", "labelExpr": "format(datum.value,',~f') + '×'", "values": [ -1024, -256, -64, -16, -4, -1, -0.25, 0, 0.1, 0.25, 0.5, 0.75, 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024 ], "labelOverlap": "greedy", "labelFlush": 20, "labelOffset": {"expr": "datum.value === 0.75 ? -2 : datum.value === 1 ? 2 : 0"}, "grid": true, "gridWidth": 0.7}
      },
      "y": {
        "field": "workload",
        "type": "nominal",
        "sort": {"field": "order", "op": "min", "order": "ascending"},
        "title": null,
        "axis": {"labelLimit": 160, "labelPadding": 5, "minExtent": 104},
        "bandPosition": 0.5
      }
    },
    "layer": [
      {
        "name": "slotted_equal",
        "mark": {"type": "rule", "color": "#8c9198", "strokeDash": [ 3, 3 ]},
        "encoding": {
          "x": {"datum": 1},
          "color": {"value": "#727880"},
          "y": {"value": 0},
          "y2": {
            "value": {"expr": "datum.row_count * 30"}
          }
        },
        "transform": [
          {
            "aggregate": [{"op": "distinct", "field": "workload", "as": "row_count"}],
            "groupby": ["metric"]
          }
        ]
      },
      {
        "name": "slotted_ratio_intervals",
        "mark": {"type": "rule", "strokeWidth": 1.2, "color": "#111111"},
        "encoding": {
          "x": {"field": "ratio_low"},
          "x2": {"field": "ratio_high"}
        },
        "transform": [{"filter": "datum.bounded"}]
      },
      {
        "name": "slotted_ratio_cap_low",
        "mark": {"type": "tick", "orient": "vertical", "size": 8, "thickness": 1.2, "color": "#111111"},
        "encoding": {
          "x": {"field": "ratio_low"}
        },
        "transform": [{"filter": "datum.bounded"}]
      },
      {
        "name": "slotted_ratio_cap_high",
        "mark": {"type": "tick", "orient": "vertical", "size": 8, "thickness": 1.2, "color": "#111111"},
        "encoding": {
          "x": {"field": "ratio_high"}
        },
        "transform": [{"filter": "datum.bounded"}]
      },
      {
        "name": "slotted_ratio_points",
        "mark": {"type": "point", "filled": true, "size": 28, "shape": "square", "color": "#111111"},
        "encoding": {
          "x": {"field": "ratio"},
          "tooltip": [{"field": "workload"}, {"field": "candidate.input.label", "title": "Full source name"}, {"field": "metric"}, {"field": "ratio"}, {"field": "ratio_low"}, {"field": "ratio_high"}]
        },
        "transform": [{"filter": "isValid(datum.ratio) && isFinite(datum.ratio)"}]
      },
      {
        "name": "slotted_ratio_status",
        "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 10,
          "dy": {"expr": "indexof(datum.summary, '\\n') >= 0 ? -5 : 0"}, "lineHeight": 11, "lineBreak": "\n", "fontWeight": "bold", "color": "#444444"},
        "encoding": {
          "x": {"value": 4},
          "text": {"field": "summary"},
          "tooltip": [{"field": "summary"}]
        },
        "transform": [{"filter": "datum.summary"}]
      }
    ]
  }
}
