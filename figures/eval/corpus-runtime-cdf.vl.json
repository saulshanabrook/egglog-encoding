    {
      "name": "cdf_coverage",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "cohort_n",
              "as": "cohort_n"
            },
            {
              "op": "max",
              "field": "measured_n",
              "as": "measured_n"
            },
            {
              "op": "max",
              "field": "saved_n",
              "as": "saved_n"
            },
            {
              "op": "max",
              "field": "too_fast_n",
              "as": "too_fast_n"
            },
            {
              "op": "max",
              "field": "unresolved_n",
              "as": "unresolved_n"
            }
          ],
          "groupby": [
            "mode"
          ]
        },
        {
          "calculate": "datum.mode + ': ' + datum.measured_n + '/' + datum.cohort_n + ' valid; saved ' + datum.saved_n + ', too fast ' + datum.too_fast_n + ', unresolved baseline ' + datum.unresolved_n + (datum.measured_n < ceil(0.5 * datum.cohort_n) ? '; 50% not established' : '') + (datum.measured_n < ceil(0.95 * datum.cohort_n) ? '; 95% not established' : '')",
          "as": "coverage"
        }
      ],
      "width": 650,
      "height": {
        "step": 18
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10
      },
      "encoding": {
        "y": {
          "field": "mode",
          "axis": null
        },
        "text": {
          "field": "coverage"
        },
        "x": {
          "value": 0
        }
      }
    },
    {
      "name": "cdf_thresholds",
      "transform": [
        {
          "aggregate": [
            {
              "op": "values",
              "as": "items"
            }
          ],
          "groupby": [
            "mode",
            "cohort_n",
            "measured_n"
          ]
        },
        {
          "calculate": "[0.5,0.95]",
          "as": "percentiles"
        },
        {
          "flatten": [
            "percentiles"
          ],
          "as": [
            "percentile"
          ]
        },
        {
          "calculate": "datum.items",
          "as": "entries"
        },
        {
          "flatten": [
            "entries"
          ],
          "as": [
            "entry"
          ]
        },
        {
          "filter": "datum.entry.valid"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "entry.ratio",
              "order": "ascending"
            }
          ],
          "groupby": [
            "mode",
            "percentile"
          ]
        },
        {
          "filter": "datum.rank === ceil(datum.percentile * datum.cohort_n)"
        },
        {
          "calculate": "datum.mode + ': ' + format(datum.percentile,'.0%') + (datum.measured_n === datum.cohort_n ? ' percentile ≤ ' : ' measured coverage ≤ ') + format(datum.entry.ratio,'.3g') + '×'",
          "as": "threshold"
        }
      ],
      "width": 650,
      "height": {
        "step": 18
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10
      },
      "encoding": {
        "y": {
          "field": "threshold",
          "axis": null
        },
        "text": {
          "field": "threshold"
        },
        "x": {
          "value": 0
        }
      }
    },
    {
      "name": "family_coverage",
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "saved"
            },
            {
              "op": "sum",
              "field": "selected",
              "as": "selected"
            },
            {
              "op": "sum",
              "field": "valid",
              "as": "valid"
            },
            {
              "op": "sum",
              "field": "too_fast",
              "as": "too_fast"
            },
            {
              "op": "sum",
              "field": "unresolved",
              "as": "unresolved"
            },
            {
              "op": "sum",
              "field": "failed_outcome",
              "as": "failed"
            },
            {
              "op": "sum",
              "field": "missing_outcome",
              "as": "missing"
            }
          ],
          "groupby": [
            "family",
            "mode"
          ]
        },
        {
          "aggregate": [
            {
              "op": "values",
              "as": "outcomes"
            }
          ],
          "groupby": [
            "family"
          ]
        },
        {
          "calculate": "datum.outcomes[indexof(pluck(datum.outcomes,'mode'),'Congruence')]",
          "as": "term"
        },
        {
          "calculate": "datum.outcomes[indexof(pluck(datum.outcomes,'mode'),'Checked proofs')]",
          "as": "proof"
        },
        {
          "calculate": "datum.term.saved + ' / ' + datum.term.selected + ' / ' + datum.term.too_fast + ' / ' + datum.term.unresolved",
          "as": "population"
        },
        {
          "calculate": "datum.term.valid + ' / ' + datum.term.failed + ' / ' + datum.term.missing",
          "as": "term_counts"
        },
        {
          "calculate": "datum.proof.valid + ' / ' + datum.proof.failed + ' / ' + datum.proof.missing",
          "as": "proof_counts"
        }
      ],
      "spacing": 12,
      "hconcat": [
        {
          "title": {
            "text": "Family",
            "fontSize": 10,
            "anchor": "start"
          },
          "width": 78,
          "height": {
            "step": 18
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "field": "family",
              "type": "nominal",
              "axis": null,
              "sort": "ascending"
            },
            "text": {
              "field": "family"
            }
          }
        },
        {
          "title": {
            "text": "Saved / selected / fast / unresolved",
            "fontSize": 10,
            "anchor": "start"
          },
          "width": 190,
          "height": {
            "step": 18
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "field": "family",
              "type": "nominal",
              "axis": null,
              "sort": "ascending"
            },
            "text": {
              "field": "population"
            }
          }
        },
        {
          "title": {
            "text": "Congruence: valid / failed / missing",
            "fontSize": 10,
            "anchor": "start"
          },
          "width": 190,
          "height": {
            "step": 18
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "field": "family",
              "type": "nominal",
              "axis": null,
              "sort": "ascending"
            },
            "text": {
              "field": "term_counts"
            }
          }
        },
        {
          "title": {
            "text": "Checked: valid / failed / missing",
            "fontSize": 10,
            "anchor": "start"
          },
          "width": 185,
          "height": {
            "step": 18
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "y": {
              "field": "family",
              "type": "nominal",
              "axis": null,
              "sort": "ascending"
            },
            "text": {
              "field": "proof_counts"
            }
          }
        }
      ]
    }
  ],
  "spacing": 16
}
