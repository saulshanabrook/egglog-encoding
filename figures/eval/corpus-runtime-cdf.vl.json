              },
              "encoding": {
                "y": {
                  "datum": 0.5
                }
              }
            },
            {
              "mark": {
                "type": "rule",
                "color": "#aeb4bb",
                "strokeDash": [
                  2,
                  3
                ]
              },
              "encoding": {
                "y": {
                  "datum": 0.95
                }
              }
            },
            {
              "name": "cdf_full",
              "transform": [
                {
                  "filter": "datum.valid"
                },
                {
                  "window": [
                    {
                      "op": "rank",
                      "as": "rank"
                    },
                    {
                      "op": "count",
                      "as": "ties"
                    }
                  ],
                  "sort": [
                    {
                      "field": "ratio",
                      "order": "ascending"
                    }
                  ],
                  "groupby": [
                    "mode"
                  ],
                  "frame": [
                    null,
                    0
                  ],
                  "ignorePeers": false
                },
                {
                  "calculate": "datum.ties / datum.cohort_n",
                  "as": "cdf"
                },
                {
                  "aggregate": [
                    {
                      "op": "values",
                      "as": "items"
                    },
                    {
                      "op": "max",
                      "field": "cdf",
                      "as": "maximum_cdf"
                    },
                    {
                      "op": "max",
                      "field": "ratio",
                      "as": "maximum_ratio"
                    }
                  ],
                  "groupby": [
                    "mode"
                  ]
                },
                {
                  "calculate": "[[{ratio:0,cdf:0}], datum.items, datum.maximum_ratio <= max(1.1, ratio_extent[1] * 1.08) ? [{ratio:max(1.1, ratio_extent[1] * 1.08),cdf:datum.maximum_cdf}] : []]",
                  "as": "curve_batches"
                },
                {
                  "flatten": [
                    "curve_batches"
                  ],
                  "as": [
                    "curve"
                  ]
                },
                {
                  "flatten": [
                    "curve"
                  ],
                  "as": [
                    "point"
                  ]
                }
              ],
              "mark": {
                "type": "line",
                "interpolate": "step-after",
                "strokeWidth": 2,
                "clip": true
              },
              "encoding": {
                "x": {
                  "field": "point.ratio",
                  "type": "quantitative",
                  "title": "Runtime / baseline",
                  "scale": {
                    "domain": {
                      "expr": "[0, max(1.1, isValid(ratio_extent[1]) ? ratio_extent[1] * 1.08 : 1.1)]"
                    }
                  },
                  "axis": {
                    "labelExpr": "format(datum.value,'~g') + '×'",
                    "tickCount": 5
                  }
                },
                "y": {
                  "field": "point.cdf",
                  "type": "quantitative",
                  "title": "Share of selected replays",
                  "scale": {
                    "domain": [
                      0,
                      1
                    ]
                  },
                  "axis": {
                    "format": ".0%",
                    "values": [
                      0,
                      0.5,
                      0.95,
                      1
                    ]
                  }
                },
                "color": {
                  "field": "mode",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Congruence",
                      "Checked proofs"
                    ],
                    "range": [
                      "#2a6f97",
                      "#b75d19"
                    ]
                  },
                  "legend": {
                    "orient": "top"
                  }
                },
                "strokeDash": {
                  "field": "mode",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Congruence",
                      "Checked proofs"
                    ],
                    "range": [
                      [
                        1,
                        0
                      ],
                      [
                        6,
                        3
                      ]
                    ]
                  },
                  "legend": {
                    "orient": "top"
                  }
                },
                "order": {
                  "field": "point.ratio"
                }
              }
            },
            {
              "name": "cdf_points",
              "transform": [
                {
                  "filter": "datum.valid"
                },
                {
                  "window": [
                    {
