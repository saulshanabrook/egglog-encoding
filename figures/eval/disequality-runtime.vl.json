{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Runtime and peak RSS distributions for native DE, native NEE and relation-based Egglog NEE. Standard gray/black boxes show medians and interquartile ranges, with 1.5-IQR whiskers and only generated outlier points. Individual non-outlier observations are not overlaid. Means and native-DE ratio intervals remain in companion exports.",
  "data": {
    "url": "../../.reports-grouped.json",
    "format": {"type": "json"}
  },
  "params": [
    {"name": "target_label", "value": "figures"},
    {"name": "timeout_sec", "value": 500},
    {"name": "rounds", "value": 10},
    {"name": "t_critical", "value": 2.2621571628540993},
    {"name": "selected_inputs", "value": []},
    {"name": "source_blockers", "value": []}
  ],
  "config": {
    "font": "Arial",
    "boxplot": {"box": {"color": "#333333"}},
    "view": {"stroke": null},
    "axis": {"labelFontSize": 13, "titleFontSize": 13, "gridColor": "#e8eaed", "titlePadding": 10, "titleFontWeight": "normal"},
    "legend": {"labelFontSize": 13, "title": null, "orient": "top"},
    "title": {"anchor": "start", "fontSize": 18, "subtitleFontSize": 13, "subtitlePadding": 8, "subtitleLineHeight": 16}
  },
  "transform": [
    {"calculate": "[datum.groups, [null]]", "as": "batches"},
    {"flatten": [ "batches" ], "as": [ "candidates" ]},
    {"flatten": [ "candidates" ], "as": [ "group" ]},
    {"filter": "!isValid(datum.group) || indexof(datum.group.labels, target_label) >= 0"},
    {"calculate": "isValid(datum.group) ? datum.group.key.file_sha256 + '/' + datum.group.key.treatment + '/' + datum.group.key.binary_sha256 : ''", "as": "group_id"},
    {
      "aggregate": [{"op": "values", "as": "observed"}]
    },
    {"calculate": "pluck(datum.observed, 'group_id')", "as": "group_ids"},
    {"calculate": "pluck(datum.observed, 'group')", "as": "groups"},
    {"calculate": "selected_inputs", "as": "inputs"},
    {"flatten": [ "inputs" ], "as": [ "input" ]},
    {"calculate": "datum.input.file_sha256 + '/' + datum.input.treatment + '/' + datum.input.binary_sha256", "as": "input_id"},
    {"calculate": "indexof(datum.group_ids, datum.input_id)", "as": "group_index"},
    {"calculate": "datum.group_index >= 0 ? datum.groups[datum.group_index] : null", "as": "group"},
    {"calculate": "isValid(datum.group)", "as": "eligible_group"},
    {"calculate": "datum.eligible_group ? datum.group.samples : []", "as": "observations"},
    {"calculate": "datum.eligible_group ? datum.input.selected_row_indices : []", "as": "sample_indices"},
    {"calculate": "length(datum.sample_indices)", "as": "sample_n"},
    {"calculate": "datum.input.validation_issue || (indexof(['proofs','proof-extraction','proof-testing'], datum.input.treatment) >= 0 && datum.eligible_group && datum.input.validation_failures ? datum.input.validation_failures[datum.group.key.binary_sha256] || '' : '')", "as": "validation_issue"},
    {"calculate": "datum.sample_n ? datum.sample_indices : [null]", "as": "runs"},
    {"flatten": [ "runs" ], "as": [ "row_index" ]},
    {"calculate": "isValid(datum.row_index) ? datum.observations[indexof(pluck(datum.observations, 'row_index'), datum.row_index)] : null", "as": "run"},
    {"calculate": "['Runtime','Peak RSS']", "as": "metrics"},
    {"flatten": [ "metrics" ], "as": [ "metric" ]},
    {"calculate": "isValid(datum.run) && datum.run.status === 'success' ? (datum.metric === 'Runtime' ? (isValid(datum.run.wall_sec) && isFinite(datum.run.wall_sec) && datum.run.wall_sec >= 0 ? datum.run.wall_sec : null) : (isValid(datum.run.max_rss_bytes) && isFinite(datum.run.max_rss_bytes) && datum.run.max_rss_bytes > 0 ? datum.run.max_rss_bytes / 1048576 : null)) : null", "as": "value"},
    {"calculate": "isValid(datum.run) && datum.run.status !== 'success' ? 1 : 0", "as": "failed"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'timed-out' ? 1 : 0", "as": "timed_out"},
    {"calculate": "isValid(datum.run) && datum.run.status === 'memory-limited' ? 1 : 0", "as": "memory_limited"},
    {
      "joinaggregate": [{"op": "valid", "field": "value", "as": "valid_n"}, {"op": "mean", "field": "value", "as": "sample_mean"}, {"op": "variance", "field": "value", "as": "sample_variance"}, {"op": "sum", "field": "failed", "as": "failed_n"}, {"op": "sum", "field": "timed_out", "as": "timeout_n"}, {"op": "sum", "field": "memory_limited", "as": "memory_limit_n"}],
      "groupby": ["input_id", "metric"]
    },
    {"calculate": "!datum.input.exclusion && datum.sample_n === rounds && datum.valid_n === rounds && !datum.validation_issue", "as": "complete"},
    {"calculate": "datum.complete ? datum.sample_mean : null", "as": "mean"},
    {"calculate": "datum.input.exclusion ? 'excluded (' + datum.input.exclusion.kind + '): ' + datum.input.exclusion.reason : (datum.validation_issue || (datum.failed_n ? datum.sample_n + '/' + rounds + ' observations; ' + datum.failed_n + ' failed (' + datum.timeout_n + ' timeout); estimate unavailable' : datum.valid_n < datum.sample_n ? datum.sample_n + '/' + rounds + ' observations; measurement unavailable; no estimate' : datum.sample_n < rounds ? datum.sample_n + '/' + rounds + ' observations; estimate unavailable' : rounds === 1 ? 'n=1; CI unavailable' : '') )", "as": "issue"},
    {
      "window": [{"op": "row_number", "as": "run_number"}],
      "sort": [{"field": "run.row_index", "order": "ascending"}],
      "groupby": ["input_id", "metric"]
    },
    {
      "calculate": "{'egg-de':'DE · Disegg', 'egg-nee':'NEE · Egg', 'off':'NEE · Egglog'}[datum.input.treatment] || datum.input.treatment",
      "as": "condition"
    },
    {"calculate": "datum.condition + ': ' + datum.issue", "as": "summary"},
    {"calculate": "isValid(datum.value) ? datum.value : 0", "as": "absolute_high"},
    {"calculate": "datum.input.exclusion ? 'Excluded (' + datum.input.exclusion.kind + ')' : datum.validation_issue ? 'Strict proof validation failed' : datum.failed_n ? datum.sample_n + '/' + rounds + ' observations\\n' + datum.failed_n + ' failed' + (datum.timeout_n ? ', ' + datum.timeout_n + ' timeout' : '') + (datum.memory_limit_n ? ', ' + datum.memory_limit_n + ' memory limit' : '') : datum.valid_n < datum.sample_n ? datum.valid_n + '/' + datum.sample_n + ' valid measurements\\nEstimate unavailable' : datum.sample_n < rounds ? datum.sample_n + '/' + rounds + ' observations\\nEstimate unavailable' : 'n=1; CI unavailable'", "as": "issue_lines"},
    {"calculate": "datum.metric === 'Runtime' ? datum.absolute_high : 0", "as": "runtime_absolute_high"},
    {"extent": "runtime_absolute_high", "param": "runtime_absolute_high_extent"},
    {"calculate": "datum.metric === 'Peak RSS' ? datum.absolute_high : 0", "as": "memory_absolute_high"},
    {"extent": "memory_absolute_high", "param": "memory_absolute_high_extent"}
  ],
  "spacing": 24,
  "facet": {
    "column": {
      "field": "metric",
      "type": "nominal",
      "sort": ["Runtime", "Peak RSS"],
      "header": {"title": null, "labelFontSize": 14, "labelFontWeight": "bold", "labels": true}
    }
  },
  "spec": {
    "width": 230,
    "height": {"step": 62},
    "layer": [
      {
        "name": "absolute_boxplots",
        "transform": [{"filter": "datum.complete"}],
        "mark": {
          "type": "boxplot",
          "extent": 1.5,
          "size": 18,
          "box": {"color": "#d9d9d9", "stroke": "#333333", "strokeWidth": 1},
          "median": {"color": "#111111", "strokeWidth": 1.3},
          "rule": {"color": "#333333", "strokeWidth": 1},
          "ticks": {"color": "#333333", "size": 10, "strokeWidth": 1},
          "outliers": {"color": "#111111", "filled": true, "size": 14}
        },
        "encoding": {
          "x": {"field": "value"}
        }
      },
      {
        "name": "absolute_status",
        "transform": [{"filter": "datum.run_number === 1 && datum.issue"}],
        "mark": {"type": "text", "align": "left", "baseline": "top", "dy": 13, "fontSize": 12, "color": "#9a3e1c", "lineBreak": "\n", "lineHeight": 13},
        "encoding": {
          "x": {"value": 0},
          "text": {"field": "issue_lines"},
          "tooltip": [{"field": "summary"}]
        }
      }
    ],
    "encoding": {
      "x": {
        "field": "value",
        "type": "quantitative",
        "title": null,
        "scale": {
          "domain": {"expr": "[0, (parent.metric === 'Runtime' ? runtime_absolute_high_extent : memory_absolute_high_extent)[1] > 0 ? (parent.metric === 'Runtime' ? runtime_absolute_high_extent : memory_absolute_high_extent)[1] : 1]"},
          "padding": 6,
          "nice": false
        },
        "axis": {
          "format": "~f",
          "tickCount": 5,
          "grid": false,
          "title": {"expr": "parent.metric === 'Runtime' ? 'Time (s)' : 'Peak RSS (MiB)'"},
          "offset": 20
        }
      },
      "y": {
        "field": "condition",
        "type": "nominal",
        "title": null,
        "axis": {"labelLimit": 180, "minExtent": 112, "maxExtent": 112},
        "scale": {"domain": [ "DE · Disegg", "NEE · Egg", "NEE · Egglog" ]}
      }
    }
  },
  "resolve": {
    "scale": {"x": "independent"}
  }
}
