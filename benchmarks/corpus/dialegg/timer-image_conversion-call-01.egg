;;;; arith dialect ;;;;
(constructor arith_constant (AttrPair Type) Op)
(constructor arith_divsi (Op Op Type) Op :cost 2)
(constructor arith_shrsi (Op Op Type) Op)

;; OPS HERE ;;
; image_conversion_func.func
(let $op0 (Value 0 (RankedTensor (vec-of 3840 2160 3) (I64))))
(let $op1 (arith_constant (NamedAttr "value" (IntegerAttr 0 (Index))) (Index)))
(let $op2 (arith_constant (NamedAttr "value" (IntegerAttr 1 (Index))) (Index)))
(let $op3 (arith_constant (NamedAttr "value" (IntegerAttr 2 (Index))) (Index)))
(let $op4 (arith_constant (NamedAttr "value" (IntegerAttr 3840 (Index))) (Index)))
(let $op5 (arith_constant (NamedAttr "value" (IntegerAttr 2160 (Index))) (Index)))
(let $op6 (Value 6 (RankedTensor (vec-of 3840 2160) (I64))))
(let $op7 (Value 7 (RankedTensor (vec-of 3840 2160) (I64))))
(let $op8 (Value 8 (None)))

;; RULES HERE ;;
(ruleset rules)
(rule ; division by a power of 2 is equivalent to right shift
    ((= ?lhs (arith_divsi ?x (arith_constant (NamedAttr "value" (IntegerAttr ?n ?t)) ?t) ?t)) ; x / n
     (= ?lgn (log2 ?n)) ; if n = 2^k, then k = log2(n)
     (= ?n (<< 1 ?lgn))) ; check if n is a power of 2
    ((union ?lhs (arith_shrsi ?x (arith_constant (NamedAttr "value" (IntegerAttr ?lgn ?t)) ?t) ?t))) ; x / n = x >> lgn
    :ruleset rules
)

(run-schedule (saturate rules))

;; EXTRACTS HERE ;;
(check (= $op1 ( arith_constant ( NamedAttr "value" ( IntegerAttr 0 ( Index ) ) ) ( Index ) )))
(extract $op1)
(check (= $op2 ( arith_constant ( NamedAttr "value" ( IntegerAttr 1 ( Index ) ) ) ( Index ) )))
(extract $op2)
(check (= $op3 ( arith_constant ( NamedAttr "value" ( IntegerAttr 2 ( Index ) ) ) ( Index ) )))
(extract $op3)
(check (= $op4 ( arith_constant ( NamedAttr "value" ( IntegerAttr 3840 ( Index ) ) ) ( Index ) )))
(extract $op4)
(check (= $op5 ( arith_constant ( NamedAttr "value" ( IntegerAttr 2160 ( Index ) ) ) ( Index ) )))
(extract $op5)
