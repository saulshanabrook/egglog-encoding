    ; Loop context unions
    

    ; Function inlining unions
    
(set (reproduction_root_0) __tmp486)
(set (reproduction_root_1) __tmp829)
(set (reproduction_root_2) __tmp847)
(set (reproduction_root_3) __tmp864)
(set (reproduction_root_4) __tmp884)
