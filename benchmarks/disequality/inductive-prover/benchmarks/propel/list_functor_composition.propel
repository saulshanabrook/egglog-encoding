(type nat {Z (S nat)})
(type list {Nil (Cons nat list)})

(def fmap (fun (fun nat nat) list list)
  (lambda (f (fun nat nat)) (x list)
    (cases x
      [Nil Nil]
      [(Cons x xs) (Cons (f x) (fmap f xs))])))

(prop-for fmap
  (forall (x list) (f (fun nat nat)) (g (fun nat nat))
    (== (fmap (lambda (y nat) (f (g y))) x) (fmap f (fmap g x)))))
