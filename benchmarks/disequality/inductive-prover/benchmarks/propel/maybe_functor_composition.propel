(type nat {Z (S nat)})
(type maybe {Nothing (Just nat)})

(def fmap (fun (fun nat nat) maybe maybe)
  (lambda (f (fun nat nat)) (x maybe)
    (cases x
      [Nothing Nothing]
      [(Just x) (Just (f x))])))

(prop-for fmap
  (forall (x maybe) (f (fun nat nat)) (g (fun nat nat))
    (== (fmap (lambda (y nat) (f (g y))) x) (fmap f (fmap g x)))))
