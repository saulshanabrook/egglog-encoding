(type nat {Z (S nat)})
(type maybe {Nothing (Just nat)})

(def return (lambda (x nat) (Just x)))

(def >>= (fun maybe (fun nat maybe) maybe)
  (lambda (x maybe) (f (fun nat maybe))
    (cases x
      [Nothing Nothing]
      [(Just x) (f x)])))

(prop-for >>=
  (forall (m maybe) (f (fun nat maybe)) (g (fun nat maybe))
    (== (>>= (>>= m f) g) (>>= m (lambda (x nat) (>>= (f x) g))))))
