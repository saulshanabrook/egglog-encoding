(def tip_nat_leq (fun (rec X {(S X) Z}) (rec X {(S X) Z}) {True False})
  (lambda (x (rec X {(S X) Z})) (y (rec X {(S X) Z})) (cases x
    [Z True]
    [(S z) (cases y
      [Z False]
      [(S x2) (tip_nat_leq z x2)])])))

(def tip_nat_min
  (lambda [comm] (x (rec X {(S X) Z})) (y (rec X {(S X) Z}))
    (if (tip_nat_leq x y) x y)))
