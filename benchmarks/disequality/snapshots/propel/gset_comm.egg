; Generic host language used by the disequality case studies.
(sort BenchmarkTerm)
(sort BenchmarkTerms (Vec BenchmarkTerm))
(constructor BenchmarkNode (String BenchmarkTerms) BenchmarkTerm)
(constructor BenchmarkWitness (i64) BenchmarkTerm)

(begin
  (let term0 (BenchmarkNode "x" (vec-of)))
  (let term1 (BenchmarkNode "n" (vec-of)))
  (let term2 (BenchmarkNode "@apply" (vec-of term0 term1)))
  (let term3 (BenchmarkNode "⊥" (vec-of)))
  (union term2 term3)
  (let term4 (BenchmarkNode "⊤" (vec-of)))
  (disequal term4 term3)
  (disequal term2 term4)
  (union term2 (BenchmarkWitness 0))
  (union term3 (BenchmarkWitness 1))
)

; Recheck one explicit host union as an equality proof witness.
(check (= (BenchmarkWitness 0) (BenchmarkWitness 1)))

; The command below records the expected graph consistency.
(check-disequalities)
