; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lambda (Var U) U :binder 0)
(constructor Sing (U U) U)
(constructor Add (U U) U)
(constructor Mult (U U) U)
(constructor Sub (U U) U)
(constructor Equality (U U) U)
(constructor Get (U U) U)
(constructor Range (U U) U)
(constructor App (U U) U)
(constructor IfThen (U U) U)
(constructor Binop (U U U) U)
(constructor SubArray (U U U) U)
(constructor Unique (U) U)
(constructor Sum (U Var Var U) U :binder 1 2)
(constructor Merge (U U Var Var Var U) U :binder 2 3 4)
(constructor Let (U Var U) U :binder 1)
(constructor Num (i64) U)
(constructor Symbol (String) U)
(constructor Null () U)
(rewrite ?r (Unique a2) :when ((= ?r (Add (V $x) b0)) (= ?r (Mult a1 b1)) (= ?r (Sub a2 b2)) (free $x a2)) :name "compiler-carried-slot-refinement")
(let _variable_seed (V $0))
(let _t0 (Add (V $0) (V $1)))
(let _t1 (Mult (V $2) (V $3)))
(let _t2 (Sub (V $4) (V $5)))
(union (Add (V $0) (V $1)) (Num 99))
(union (Mult (V $2) (V $3)) (Num 99))
(union (Sub (V $4) (V $5)) (Num 99))
(let _p0 (Num 99))
(let _p1 (Unique (V $4)))
(let _p2 (Null))
(run 2)
