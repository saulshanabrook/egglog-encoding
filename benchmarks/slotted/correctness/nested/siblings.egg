; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(let _variable_seed (V $0))
(union (G (V $0) (Null)) (Null))
(union (K (V $1) (Null)) (Null))
(let start (F (Null) (Null)))
(rewrite (F (G a n) (K b m)) (H a b))
(run 1)
