; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(let _variable_seed (V $0))
(union (F (V $0) (V $1)) (F (V $1) (V $0)))
(let start (G (V $0) (F (V $0) (V $1))))
(rewrite (G (V $x) (F a (V $x))) (H a (V $x)))
(run 1)
