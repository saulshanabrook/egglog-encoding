; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (App (Sym "map") (Lam $x (App f gx))) (Lam $in (App (App (Sym "map") f) (App (App (Sym "map") (Lam $x gx)) (V $in)))) :name "map-fission" :when ())
(let _variable_seed (V $0))
(let _t0 (App (Sym "map") (Lam $0 (App (App (Sym "f1") (V $0)) (Sym "f2")))))
(let _p0 (App (Sym "map") (Lam $0 (App (App (Sym "f1") (V $0)) (Sym "f2")))))
(let _p1 (Lam $1 (App (App (Sym "map") (App (Sym "f1") (V $0))) (App (App (Sym "map") (Lam $0 (Sym "f2"))) (V $1)))))
(let _p2 (App (Sym "map") (Lam $0 (App (App (Sym "f1") (V $0)) (Sym "f3")))))
(run 3)
