; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (App (Sym "map") (Lam $x (App f gx))) (Lam $in (App (App (Sym "map") f) (App (App (Sym "map") (Lam $x gx)) (V $in)))) :name "map-fission" :when ((not-free $x f)))
(let _variable_seed (V $0))
(let _t0 (App (Sym "map") (Lam $0 (App (Sym "f1") (App (Sym "f2") (V $0))))))
(let _p0 (App (Sym "map") (Lam $0 (App (Sym "f1") (App (Sym "f2") (V $0))))))
(let _p1 (Lam $1 (App (App (Sym "map") (Sym "f1")) (App (App (Sym "map") (Lam $0 (App (Sym "f2") (V $0)))) (V $1)))))
(let _p2 (Lam $1 (App (App (Sym "map") (Sym "f2")) (App (App (Sym "map") (Lam $0 (App (Sym "f1") (V $0)))) (V $1)))))
(run 3)
