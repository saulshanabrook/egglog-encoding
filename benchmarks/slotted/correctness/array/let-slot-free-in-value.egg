; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (Let $x b e) b :name "let-unused" :when ((not-free $x b)))
(let _variable_seed (V $0))
(let _t0 (App (Let $0 (App (Sym "f1") (V $0)) (V $0)) (V $0)))
(let _t1 (App (Let $0 (App (Sym "f1") (V $0)) (V $0)) (V $1)))
(let _p0 (App (Let $0 (App (Sym "f1") (V $0)) (V $0)) (V $0)))
(let _p1 (App (Let $0 (App (Sym "f1") (V $0)) (V $0)) (V $1)))
(let _p2 (App (Let $0 (App (Sym "f1") (V $0)) (V $0)) (Sym "cc")))
(run 8)
