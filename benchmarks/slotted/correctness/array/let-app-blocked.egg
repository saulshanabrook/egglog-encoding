; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (Let $x (App a b) e) (App (Let $x a e) (Let $x b e)) :name "let-app" :when ((free $x a b)))
(let _variable_seed (V $0))
(let _t0 (Let $0 (App (Sym "dd") (Sym "cc")) (Sym "aa")))
(let _p0 (Let $0 (App (Sym "dd") (Sym "cc")) (Sym "aa")))
(let _p1 (App (Let $0 (Sym "dd") (Sym "aa")) (Let $0 (Sym "cc") (Sym "aa"))))
(let _p2 (App (Sym "dd") (Sym "cc")))
(run 8)
