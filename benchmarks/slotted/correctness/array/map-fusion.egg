; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (App (App (Sym "map") f) (App (App (Sym "map") g) arg)) (App (App (Sym "map") (Lam $fu (App f (App g (V $fu))))) arg) :name "map-fusion")
(let _variable_seed (V $0))
(let _t0 (App (App (Sym "map") (Sym "f1")) (App (App (Sym "map") (Sym "f2")) (Sym "arr"))))
(let _p0 (App (App (Sym "map") (Sym "f1")) (App (App (Sym "map") (Sym "f2")) (Sym "arr"))))
(let _p1 (App (App (Sym "map") (Lam $0 (App (Sym "f1") (App (Sym "f2") (V $0))))) (Sym "arr")))
(let _p2 (App (App (Sym "map") (Lam $0 (App (Sym "f2") (App (Sym "f1") (V $0))))) (Sym "arr")))
(run 4)
