; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (App (Lam $x body) e) (Let $x body e) :name "let-intro")
(let _variable_seed (V $0))
(let _t0 (App (Lam $0 (App (Sym "f1") (V $0))) (Sym "aa")))
(let _p0 (App (Lam $0 (App (Sym "f1") (V $0))) (Sym "aa")))
(let _p1 (Let $0 (App (Sym "f1") (V $0)) (Sym "aa")))
(let _p2 (Let $0 (App (Sym "f1") (V $0)) (Sym "bb")))
(run 8)
