; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Sym (String) U)
(constructor Num (i64) U)
(rewrite (Let $x (Lam $y body) e) (Lam $y (Let $x body e)) :name "let-lam-diff" :when ((not-free $y e) (free $x body)))
(let _variable_seed (V $0))
(let _t0 (Let $0 (Lam $1 (App (V $1) (V $0))) (Sym "aa")))
(let _p0 (Let $0 (Lam $1 (App (V $1) (V $0))) (Sym "aa")))
(let _p1 (Lam $1 (Let $0 (App (V $1) (V $0)) (Sym "aa"))))
(let _p2 (Lam $1 (App (V $1) (Sym "aa"))))
(run 8)
