; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (Add b a) :when ((= p (Add a b))))
(rewrite q (K x y) :when ((= q (G x y))))
(let _variable_seed (V $0))
(let _t0 (Add (Sub (V $0) (V $0)) (G (V $1) (V $1))))
(let _p0 (Add (Sub (V $0) (V $0)) (G (V $1) (V $1))))
(let _p1 (Add (G (V $1) (V $1)) (Sub (V $0) (V $0))))
(let _p2 (Add (Sub (V $0) (V $0)) (K (V $1) (V $1))))
(let _p3 (K (V $1) (V $1)))
(run 10)
