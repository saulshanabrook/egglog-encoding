; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite x1 (H x2 x1) :when ((= x3 (H x1 x2))))
(let _variable_seed (V $0))
(union (H (Null) (V $0)) (Sub (V $0) (V $0)))
(union (G (Null) (V $2)) (Sub (V $0) (V $0)))
(let _p0 (H (Null) (V $0)))
(let _p1 (G (Null) (V $2)))
(let _p2 (Sub (V $0) (V $0)))
(let _p3 (H (V $0) (V $1)))
(let _p4 (H (V $0) (V $0)))
(let _p5 (Null))
(let _p6 (Sub (V $0) (V $0)))
(run 6)
