; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H x x) :when ((= p (F x x))))
(let _variable_seed (V $0))
(let _t0 (F (V $0) (V $1)))
(let _t1 (F (V $0) (V $0)))
(let _p0 (F (V $0) (V $1)))
(let _p1 (F (V $0) (V $0)))
(let _p2 (H (V $0) (V $0)))
(run 10)
