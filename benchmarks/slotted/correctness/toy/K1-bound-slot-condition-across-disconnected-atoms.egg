; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite v0 (H r1 r1) :when ((= r0 (Lam $s0 v0)) (= r1 (Sub2 a b)) (free $s0 a)))
(let _variable_seed (V $0))
(let _t0 (Lam $0 (V $2)))
(let _t1 (Sub2 (V $0) (V $1)))
(let _p0 (Lam $0 (V $2)))
(let _p1 (Sub2 (V $0) (V $1)))
(let _p2 (H (V $0) (V $1)))
(let _p3 (H (V $0) (V $0)))
(let _p4 (Null))
(run 6)
