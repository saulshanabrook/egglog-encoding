; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite x7 (H x2 x4) :when ((= x3 (K x1 x2)) (= x6 (K x4 x5)) (= x7 (H x3 x6))))
(let _variable_seed (V $0))
(let _t0 (H (K (V $0) (V $0)) (K (V $2) (V $0))))
(let _p0 (H (K (V $0) (V $0)) (K (V $2) (V $0))))
(let _p1 (H (V $0) (V $1)))
(let _p2 (H (V $0) (V $0)))
(let _p3 (Null))
(let _p4 (Sub (V $0) (V $0)))
(run 6)
