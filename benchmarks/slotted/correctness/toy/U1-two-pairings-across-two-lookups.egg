; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H y z) :when ((= p (F x y)) (= q (F x z))))
(let _variable_seed (V $0))
(let _t0 (F (K (V $0) (V $1)) (G (V $0) (V $1))))
(union (F (K (V $0) (V $1)) (G (V $0) (V $1))) (Null))
(let _p0 (F (K (V $0) (V $1)) (G (V $0) (V $1))))
(let _p1 (Null))
(let _p2 (H (G (V $0) (V $1)) (G (V $0) (V $1))))
(let _p3 (H (G (V $0) (V $1)) (G (V $1) (V $0))))
(run 10)
