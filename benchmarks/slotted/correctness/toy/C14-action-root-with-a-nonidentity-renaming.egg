; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite x1 (H x3 x2) :when ((= x3 (F x1 x2))))
(let _variable_seed (V $0))
(let _t0 (F (V $2) (Null)))
(let _t1 (K (V $2) (Null)))
(union (G (V $1) (Null)) (K (Null) (V $0)))
(let _p0 (F (V $2) (Null)))
(let _p1 (K (V $2) (Null)))
(let _p2 (G (V $1) (Null)))
(let _p3 (H (V $0) (V $1)))
(let _p4 (H (V $0) (V $0)))
(let _p5 (Null))
(let _p6 (Sub (V $0) (V $0)))
(run 6)
