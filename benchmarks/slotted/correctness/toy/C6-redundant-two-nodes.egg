; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H u u) :when ((= p (Add a b)) (= a (Sub u u)) (= b (Sub2 u u))))
(let _variable_seed (V $0))
(let _t0 (Add (Null) (Null)))
(union (Sub (V $0) (V $0)) (Null))
(union (Sub2 (V $1) (V $1)) (Null))
(let _p0 (Add (Null) (Null)))
(let _p1 (H (V $0) (V $0)))
(let _p2 (Null))
(run 10)
