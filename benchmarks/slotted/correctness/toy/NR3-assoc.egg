; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (Add (Add a b) c) :when ((= p (Add a x)) (= x (Add b c))))
(let _variable_seed (V $0))
(let _t0 (Add (Sub (V $0) (V $0)) (Add (G (V $1) (V $1)) (K (V $2) (V $2)))))
(let _p0 (Add (Sub (V $0) (V $0)) (Add (G (V $1) (V $1)) (K (V $2) (V $2)))))
(let _p1 (Add (Add (Sub (V $0) (V $0)) (G (V $1) (V $1))) (K (V $2) (V $2))))
(let _p2 (Add (Sub (V $0) (V $0)) (G (V $1) (V $1))))
(let _p3 (Null))
(run 10)
