; Frozen differential input; see generate_differential.py.
(sort U)
(constructor V (Var) U)
(constructor Lam (Var U) U :binder 0)
(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor Sub (U U) U)
(constructor Sub2 (U U) U)
(constructor Add (U U) U)
(constructor Num (i64) U)
(constructor Null () U)
(rewrite p (H a b) :when ((= p (Lam $s x)) (= x (F a b)) (free $s a b)))
(let _variable_seed (V $0))
(let _t0 (Lam $0 (F (G (V $0) (V $0)) (K (V $1) (V $1)))))
(let _t1 (Lam $0 (F (G (V $1) (V $1)) (K (V $1) (V $1)))))
(let _p0 (Lam $0 (F (G (V $0) (V $0)) (K (V $1) (V $1)))))
(let _p1 (H (G (V $0) (V $0)) (K (V $1) (V $1))))
(let _p2 (Lam $0 (F (G (V $1) (V $1)) (K (V $1) (V $1)))))
(let _p3 (H (G (V $1) (V $1)) (K (V $1) (V $1))))
(run 10)
