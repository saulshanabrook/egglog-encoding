+        prepass_probe: false,
+    });
+    let result = run.run().unwrap();
+    assert!(result.observation_evidence.is_none());
+    assert!(!never_created.exists());
+    assert!(serde_json::to_value(result)
+        .unwrap()
+        .get("observation_evidence")
+        .is_none());
+}
