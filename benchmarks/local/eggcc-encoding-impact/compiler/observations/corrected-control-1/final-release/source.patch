+            checks.append({'case': name, 'passed': False, 'reason': str(error)})
+        else:
+            checks.append({'case': name, 'passed': not reject, 'rejected': False})
+        (args.out / 'results.partial.json').write_text(json.dumps(checks, indent=2) + '\n')
