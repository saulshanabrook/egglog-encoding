+++ b/benchmarks/eggcc-encoding/active-noalias-controls.egg
@@ -0,0 +1,78 @@
+; Full unmodified schema/mem_simple rules plus reduced source-derived inputs.
+; This checks available inference and forbidden rewrites, not runtime execution.
+(include "source/schema.egg")
+(include "source/interval-bounds.egg")
+(include "source/mem_simple.egg")
+(relation HasArgType (Expr Type))
+(relation ContextOf (Expr Assumption))
+(ruleset peepholes)
+; Exact source: peepholes.egg:23-30.
+(rule ((= expr (Bop (Sub) x x))
+       (HasArgType expr ty)
+       (ContextOf expr ctx))
+      ((union expr (Const (Int 0) ty ctx))) :ruleset peepholes)
+
+(let ty (TupleT (TCons (PointerT (IntT))
+                 (TCons (PointerT (IntT))
+                   (TCons (IntT) (TCons (StateT) (TCons (PointerT (IntT)) (TNil))))))))
+(let ctx (InFunc "main"))
+(let args (Arg ty ctx))
+(let p (Get args 0))
+(let q (Get args 1))
+(let x (Get args 2))
+(let state (Get args 3))
+(let zero (Const (Int 0) ty ctx))
+(let two (Const (Int 2) ty ctx))
+(let minus-two (Const (Int -2) ty ctx))
+(let sym-zero (Bop (Sub) x x))
+(HasArgType sym-zero ty)
+(ContextOf sym-zero ctx)
+(let p0 (Bop (PtrAdd) p zero))
+(let p2 (Bop (PtrAdd) p two))
+(let pm2 (Bop (PtrAdd) p minus-two))
+(let ps0 (Bop (PtrAdd) p sym-zero))
+(let px (Bop (PtrAdd) p x))
+
+; Distinguishable stored values ensure that forwarding cannot pass by accident.
+(let old (Const (Int 17) ty ctx))
+(let new (Const (Int 99) ty ctx))
+(let write (Top (Write) p new state))
+(let load-positive (Bop (Load) p2 write))
+(let load-zero (Bop (Load) p0 write))
+(let load-sym-zero (Bop (Load) ps0 write))
+(let load-unknown (Bop (Load) q write))
+(let load-self (Bop (Load) p write))
+(run-schedule (saturate peepholes interval-analysis mem-simple))
+(check (NoAlias p p2))
+(check (NoAlias p pm2))
+(check (NoAlias p2 p))
+(check (= (Get load-positive 0) (Get (Bop (Load) p2 state) 0)))
+(check (DidMemOptimization "commute write then load"))
+(check (= (Get load-self 0) new))
+(fail (check (= (Get load-self 0) old)))
+(check (= sym-zero zero))
+(fail (check (NoAlias p p)))
+(fail (check (NoAlias p p0)))
+(fail (check (NoAlias p ps0)))
+(fail (check (NoAlias p px)))
+(fail (check (NoAlias p q)))
+(fail (check (= (Get load-zero 0) (Get (Bop (Load) p0 state) 0))))
+(fail (check (= (Get load-sym-zero 0) (Get (Bop (Load) ps0 state) 0))))
+(fail (check (= (Get load-unknown 0) (Get (Bop (Load) q state) 0))))
+; Distinct current IDs are not disequality or universal runtime nonalias.
+(check (!= p q))
+(check (!= p p0))
+(fail (check (known-disequal? p q)))
+(fail (check (known-disequal? p p0)))
+(fail (check (known-disequal? p px)))
+
+; Source branch propagation preserves the same restricted contract.
+(let pred (Const (Bool true) ty ctx))
+(let branch-args (Arg ty (InIf true pred args)))
+(let branch-unknown (Arg ty (InIf false pred args)))
+(If pred args (Single (Get branch-args 0)) (Single (Get branch-unknown 0)))
+(Get args 4) (Get branch-args 4)
+(NoAlias (Get args 0) (Get args 4))
+(run-schedule (saturate mem-simple))
+(check (NoAlias (Get branch-args 0) (Get branch-args 4)))
+(fail (check (NoAlias (Get branch-args 0) (Get branch-args 1))))
