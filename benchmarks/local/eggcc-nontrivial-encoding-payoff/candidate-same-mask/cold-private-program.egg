(datatype Scope (ThisScope))
(datatype Word)
(constructor Mask (Word Word) Word)
(constructor Leaf0 (Scope) Word)
(constructor Leaf1 (Scope) Word)
(constructor Leaf2 (Scope) Word)
(constructor Shift0 (Word) Word :injective)
(Leaf0 (ThisScope))
(Leaf1 (ThisScope))
(Leaf2 (ThisScope))
(Mask (Leaf0 (ThisScope)) (Leaf2 (ThisScope)))
(Mask (Leaf1 (ThisScope)) (Leaf2 (ThisScope)))
(Shift0 (Leaf0 (ThisScope)))
(Shift0 (Leaf1 (ThisScope)))
(disequal (Mask (Leaf0 (ThisScope)) (Leaf2 (ThisScope))) (Mask (Leaf1 (ThisScope)) (Leaf2 (ThisScope))))
(run-schedule (saturate injectivity))
