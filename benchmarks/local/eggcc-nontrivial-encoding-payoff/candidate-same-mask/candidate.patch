+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn loop_constant_requires_literal_and_same_index_passthrough() {
+        use crate::ast::*;
+        use crate::{parallel, tuplet};
+        let cases = [
+            (
+                parallel!(int(7), int(8)),
+                parallel!(tfalse(), getat(0), getat(1)),
+                Some(7),
+            ),
+            (
+                parallel!(int(9), int(8)),
+                parallel!(tfalse(), getat(0), getat(1)),
+                Some(9),
+            ),
+            (
+                parallel!(arg(), int(8)),
+                parallel!(tfalse(), getat(0), getat(1)),
+                None,
+            ),
+            (
+                parallel!(int(7), int(8)),
+                parallel!(tfalse(), add(getat(0), int(1)), getat(1)),
+                None,
+            ),
+            (
+                parallel!(int(7), int(8)),
+                parallel!(tfalse(), getat(1), getat(1)),
+                None,
+            ),
+        ];
+        for (input, body, expected) in cases {
+            let function = function(
+                "main",
+                base(intt()),
+                tuplet!(intt(), intt()),
+                dowhile(input, body),
+            )
+            .func_with_arg_types()
+            .func_add_ctx()
+            .0;
+            let program = function.func_to_program();
+            let found = loop_invariants(&program);
+            assert_eq!(
+                found.iter().find(|x| x.index == 0).map(|x| x.value),
+                expected
+            );
+            assert_eq!(
+                found.iter().find(|x| x.index == 1).map(|x| x.value),
+                Some(8)
+            );
+        }
+    }
+
+    #[test]
+    fn branch_input_transport_is_typed_and_context_exact() {
+        use crate::ast::*;
+        use crate::{parallel, tuplet};
+        let parent_scope = Assumption::InFunc("parent".to_owned());
+        let input = parallel!(int(7), int(8))
+            .with_arg_types(base(intt()), tuplet!(intt(), intt()))
+            .add_ctx(parent_scope.clone())
+            .0;
+        let predicate = eq(int(0), int(1))
+            .with_arg_types(base(intt()), base(boolt()))
+            .add_ctx(parent_scope.clone())
+            .0;
+        let child_scope = Assumption::InIf(false, predicate.clone(), input.clone());
+        let value = RcExpr::new(Expr::Get(
+            RcExpr::new(Expr::Arg(tuplet!(intt(), intt()), child_scope.clone())),
+            0,
+        ));
+        assert_eq!(
+            translate(&value, &parent_scope, Some((&child_scope, &input)), &[]),
+            Some(Word::Constant(7))
+        );
+        let sibling = Assumption::InIf(true, predicate, input.clone());
+        assert_eq!(
+            translate(&value, &parent_scope, Some((&sibling, &input)), &[]),
+            None
+        );
+        let invalid = RcExpr::new(Expr::Get(
+            RcExpr::new(Expr::Arg(tuplet!(boolt(), intt()), child_scope.clone())),
+            0,
+        ));
+        assert_eq!(
+            translate(&invalid, &parent_scope, Some((&child_scope, &input)), &[]),
+            None
+        );
+    }
+    fn words() -> (Word, Word, Word, Word) {
+        let x = Word::Slot(0);
+        let y = Word::Slot(1);
+        let m = Word::Slot(2);
+        (
+            Word::Mask(Box::new(x.clone()), Box::new(m.clone())),
+            Word::Mask(Box::new(y.clone()), Box::new(m)),
+            Word::Shift(7, Box::new(x)),
+            Word::Shift(7, Box::new(y)),
+        )
+    }
+    #[test]
+    fn generic_chain_and_causal_controls() {
+        let (a, b, x, y) = words();
+        for mode in [
+            Mode::Encoding,
+            Mode::Manual,
+            Mode::AnnotationOff,
+            Mode::SeedOnly,
+            Mode::QueryOff,
+            Mode::BridgeOff,
+        ] {
+            let (export, receipt) = prove((&a, &b), (&x, &y), mode).unwrap();
+            assert_eq!(
+                export,
+                matches!(mode, Mode::Encoding | Mode::Manual),
+                "{receipt}"
+            );
+            if mode == Mode::Encoding {
+                assert_eq!(receipt["child_known"], true);
+                assert_eq!(receipt["target_known"], true)
+            }
+            if mode == Mode::AnnotationOff {
+                assert_eq!(receipt["child_known"], true);
+                assert_eq!(receipt["target_known"], false)
+            }
+        }
+    }
+    #[test]
+    fn unsupported_laws_and_infeasible_seed_do_not_export() {
+        let (a, b, x, y) = words();
+        let other_mask = Word::Mask(Box::new(Word::Slot(1)), Box::new(Word::Slot(3)));
+        let other_shift = Word::Shift(8, Box::new(Word::Slot(1)));
+        for (left, right, tx, ty) in [
+            (&a, &other_mask, &x, &y),
+            (&a, &b, &x, &other_shift),
+            (&a, &a, &x, &y),
+        ] {
+            let (export, receipt) = prove((left, right), (tx, ty), Mode::Encoding).unwrap();
+            assert!(!export, "{receipt}");
+        }
+    }
+}
