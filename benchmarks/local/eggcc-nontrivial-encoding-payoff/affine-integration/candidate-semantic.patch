+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn affine_chain_causal_controls() {
+        for mode in [
+            Mode::Encoding,
+            Mode::Manual,
+            Mode::CancellationOff,
+            Mode::ForwardOff,
+            Mode::ReverseOff,
+            Mode::IdentityOff,
+            Mode::TargetRescue,
+            Mode::QueryOff,
+            Mode::PrimitiveOnly,
+            Mode::SeedOnly,
+            Mode::BridgeOff,
+            Mode::ApplicationOff,
+        ] {
+            let (export, receipt) = prove(mode).unwrap();
+            assert_eq!(
+                export,
+                matches!(
+                    mode,
+                    Mode::Encoding | Mode::Manual | Mode::TargetRescue | Mode::ApplicationOff
+                ),
+                "{receipt}",
+            );
+            if mode == Mode::CancellationOff {
+                assert_eq!(receipt["a_equal_c"], false);
+                assert_eq!(receipt["target_known_disequal"], false);
+            }
+            if mode == Mode::ForwardOff {
+                assert_eq!(receipt["z_known_disequal_w"], true);
+                assert_eq!(receipt["target_known_disequal"], false);
+            }
+            if mode == Mode::ReverseOff {
+                assert_eq!(receipt["a_equal_c"], true);
+                assert_eq!(receipt["z_known_disequal_w"], false);
+            }
+            if mode == Mode::IdentityOff {
+                assert_eq!(receipt["pair_equal"], true);
+                assert_eq!(receipt["a_equal_c"], false);
+            }
+            if mode == Mode::Encoding {
+                assert_eq!(
+                    receipt["manual_receipts"],
+                    json!([true, true, true, true, true, true, true]),
+                );
+                assert_eq!(receipt["bottom"], false);
+            }
+        }
+    }
+
+    #[test]
+    fn affine_manual_closure_respects_missing_edges() {
+        assert_eq!(manual(true, true, true, true, false).0, [true; 7]);
+        assert_eq!(
+            manual(false, true, true, true, false).0,
+            [true, false, false, true, true, false, false],
+        );
+        assert_eq!(
+            manual(true, false, true, true, false).0,
+            [true, true, true, true, true, true, false],
+        );
+        assert_eq!(
+            manual(true, true, false, true, false).0,
+            [true, true, true, true, true, false, false],
+        );
+        assert_eq!(
+            manual(true, true, true, false, false).0,
+            [false, false, false, true, true, false, false],
+        );
+    }
+}
