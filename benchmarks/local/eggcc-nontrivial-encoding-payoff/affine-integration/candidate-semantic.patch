+/// Admit only the exact nested affine-key, mixed-Add and odd-product chain.
+pub(crate) fn analyze(program: &TreeProgram) -> Vec<RcExpr> {
+    let mode = Mode::from_env();
+    if mode == Mode::Off {
+        return Vec::new();
+    }
+    static BOUNDARY: AtomicUsize = AtomicUsize::new(0);
+    let boundary = BOUNDARY.fetch_add(1, Ordering::Relaxed);
+    let types = program.typecheck();
+    let mut stack = vec![program.entry.clone()];
+    stack.extend(program.functions.clone());
+    let (mut seen, mut exports, mut receipts) = (BTreeSet::new(), Vec::new(), Vec::new());
+    while let Some(expr) = stack.pop() {
+        if !seen.insert(std::rc::Rc::as_ptr(&expr)) {
+            continue;
+        }
+        stack.extend(expr.children_exprs());
+        let Expr::If(target, _, _, _) = expr.as_ref() else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, target_left, target_right) = target.as_ref() else {
+            continue;
+        };
+        if types.get(&std::rc::Rc::as_ptr(target)) != Some(&Type::Base(BaseType::BoolT)) {
+            continue;
+        }
+        let target_scope = target.get_ctx();
+        let Assumption::InIf(false, mixed_predicate, mixed_input) = &target_scope else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, mixed_left, mixed_right) = mixed_predicate.as_ref() else {
+            continue;
+        };
+        let mixed_scope = mixed_predicate.get_ctx();
+        let Assumption::InIf(true, second_predicate, second_input) = &mixed_scope else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, second_left, second_right) = second_predicate.as_ref() else {
+            continue;
+        };
+        let second_scope = second_predicate.get_ctx();
+        let Assumption::InIf(true, first_predicate, first_input) = &second_scope else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, first_left, first_right) = first_predicate.as_ref() else {
+            continue;
+        };
+        let root = first_predicate.get_ctx();
+        let translated_first = (
+            translate(first_left, &root, &root),
+            translate(first_right, &root, &root),
+        );
+        let translated_second = (
+            translate(second_left, &root, &second_scope),
+            translate(second_right, &root, &second_scope),
+        );
+        let translated_mixed = (
+            translate(mixed_left, &root, &mixed_scope),
+            translate(mixed_right, &root, &mixed_scope),
+        );
+        let translated_target = (
+            translate(target_left, &root, &target_scope),
+            translate(target_right, &root, &target_scope),
+        );
+        let accepted = (|| {
+            let (Some(first_left), Some(first_right)) = &translated_first else {
+                return None;
+            };
+            let (mut left_pair, mut right_pair) =
+                (affine_first(first_left)?, affine_first(first_right)?);
+            let (Some(second_left), Some(second_right)) = &translated_second else {
+                return None;
+            };
+            let second_pairs = (affine_second(second_left)?, affine_second(second_right)?);
+            if second_pairs == (right_pair.clone(), left_pair.clone()) {
+                std::mem::swap(&mut left_pair, &mut right_pair);
+            } else if second_pairs != (left_pair.clone(), right_pair.clone()) {
+                return None;
+            }
+            let ((a, b), (c, d)) = (left_pair, right_pair);
+            if [a.clone(), b.clone(), c.clone(), d.clone()]
+                .iter()
+                .any(|word| matches!(word, Word::Constant(_)))
+                || a == c
+                || b == d
+            {
+                return None;
+            }
+            let (Some(mixed_left), Some(mixed_right)) = &translated_mixed else {
+                return None;
+            };
+            let (z, w) = if let (Some(z), Some(w)) =
+                (other_addend(mixed_left, &c), other_addend(mixed_right, &a))
+            {
+                (z, w)
+            } else {
+                (
+                    other_addend(mixed_right, &c)?,
+                    other_addend(mixed_left, &a)?,
+                )
+            };
+            if z == w || matches!(z, Word::Constant(_)) || matches!(w, Word::Constant(_)) {
+                return None;
+            }
+            let (Some(target_left), Some(target_right)) = &translated_target else {
+                return None;
+            };
+            let target_children = (odd_mul_child(target_left)?, odd_mul_child(target_right)?);
+            if target_children != (z.clone(), w.clone())
+                && target_children != (w.clone(), z.clone())
+            {
+                return None;
+            }
+            Some((a, b, c, d, z, w))
+        })();
+        let Some((a, b, c, d, z, w)) = accepted else {
+            receipts.push(json!({
+                "accepted":false,
+                "reason":"exact affine components, contexts, mixed Add, or odd target mismatch",
+                "first":format!("{translated_first:?}"),
+                "second":format!("{translated_second:?}"),
+                "mixed":format!("{translated_mixed:?}"),
+                "target":format!("{translated_target:?}"),
+            }));
+            continue;
+        };
+        let (export, mut receipt) = match prove(mode) {
+            Ok(value) => value,
+            Err(error) => (
+                false,
+                json!({"analysis_error":format!("{error:?}"),"export":false}),
+            ),
+        };
+        receipt["accepted"] = json!(true);
+        receipt["source_first_component"] = json!(first_predicate.to_string());
+        receipt["source_second_component"] = json!(second_predicate.to_string());
+        receipt["source_mixed_add"] = json!(mixed_predicate.to_string());
+        receipt["source_target"] = json!(target.to_string());
+        receipt["root_scope"] = json!(root.to_string());
+        receipt["second_scope"] = json!(second_scope.to_string());
+        receipt["mixed_scope"] = json!(mixed_scope.to_string());
+        receipt["target_scope"] = json!(target_scope.to_string());
+        receipt["first_input"] = json!(first_input.to_string());
+        receipt["second_input"] = json!(second_input.to_string());
+        receipt["mixed_input"] = json!(mixed_input.to_string());
+        receipt["translated_dynamic_words"] =
+            json!(format!("a={a:?},b={b:?},c={c:?},d={d:?},z={z:?},w={w:?}"));
+        receipts.push(receipt);
+        if export {
+            exports.push(target.clone());
+        }
+    }
+    if let Ok(directory) = std::env::var("EGGCC_SCOPED_EVIDENCE") {
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = Path::new(&directory).join(format!("boundary-{boundary:04}.json"));
+        assert!(!path.exists());
+        std::fs::write(
+            path,
+            serde_json::to_vec_pretty(&json!({
+                "boundary":boundary,
+                "mode":format!("{mode:?}"),
+                "queries":receipts,
+                "exports":exports.len(),
+            }))
+            .unwrap(),
+        )
+        .unwrap();
+    }
+    exports
+}
