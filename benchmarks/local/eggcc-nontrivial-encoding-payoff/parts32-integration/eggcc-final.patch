+            if mode == Mode::SeedOnly {
+                assert!(!r["program"].as_str().unwrap().contains("run-schedule"));
+                assert_eq!(r["bottom_checked"], false);
+                assert_eq!(r["manual_receipts"], serde_json::Value::Null);
+                assert_eq!(r["low_equal"], true);
+            }
+            if mode == Mode::PrimitiveOnly {
+                assert_eq!(r["word_seeded"], true);
+                assert_eq!(r["low_equal"], true);
+                assert_eq!(r["manual_closure_run"], false);
+                assert_eq!(r["engine_witness_queries_run"], false);
+                assert_eq!(r["primitive_only_marked_fields"], json!([]));
+            }
+            if mode == Mode::ForwardOff {
+                assert_eq!(r["parts_known"], false)
+            }
+            if mode == Mode::ReverseOff {
+                assert_eq!(r["parts_known"], true);
+                assert_eq!(r["high_known"], false)
+            }
+            if mode == Mode::Encoding {
+                assert_eq!(r["manual_receipts"], json!([true, true, true, true]));
+                assert_eq!(r["bottom"], false)
+            }
+        }
+    }
