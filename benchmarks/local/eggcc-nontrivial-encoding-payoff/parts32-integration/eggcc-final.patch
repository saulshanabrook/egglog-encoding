+    #[test]
+    fn loop_constant_requires_literal_and_same_index_passthrough() {
+        use crate::ast::*;
+        use crate::{parallel, tuplet};
+        let cases = [
+            (
+                parallel!(int(7), int(8)),
+                parallel!(tfalse(), getat(0), getat(1)),
+                Some(7),
+            ),
+            (
+                parallel!(int(9), int(8)),
+                parallel!(tfalse(), getat(0), getat(1)),
+                Some(9),
+            ),
+            (
+                parallel!(arg(), int(8)),
+                parallel!(tfalse(), getat(0), getat(1)),
+                None,
+            ),
+            (
+                parallel!(int(7), int(8)),
+                parallel!(tfalse(), add(getat(0), int(1)), getat(1)),
+                None,
+            ),
+            (
+                parallel!(int(7), int(8)),
+                parallel!(tfalse(), getat(1), getat(1)),
+                None,
+            ),
+        ];
+        for (input, body, expected) in cases {
+            let function = function(
+                "main",
+                base(intt()),
+                tuplet!(intt(), intt()),
+                dowhile(input, body),
+            )
+            .func_with_arg_types()
+            .func_add_ctx()
+            .0;
+            let program = function.func_to_program();
+            let found = loop_invariants(&program);
+            assert_eq!(
+                found.iter().find(|x| x.index == 0).map(|x| x.value),
+                expected
+            );
+            assert_eq!(
+                found.iter().find(|x| x.index == 1).map(|x| x.value),
+                Some(8)
+            );
+        }
+    }
