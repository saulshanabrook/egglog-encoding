+    #[test]
+    fn parts32_ee_matches_nee_on_consistent_causal_graphs() {
+        for mode in [
+            Mode::Encoding,
+            Mode::ForwardOff,
+            Mode::ReverseOff,
+            Mode::IdentityOff,
+            Mode::Rescue,
+        ] {
+            let (_, receipt) = prove(mode).unwrap();
+            let mut graph = new_experimental_egraph_with_options(false, DisequalityEncoding::Ee);
+            // EE's inherited support rules use global x/y names. Alpha-rename
+            // this diagnostic's bindings to avoid that independent collision.
+            let mut ee_program = receipt["program"].as_str().unwrap().to_owned();
+            for name in [
+                "x", "y", "lx", "ly", "hx", "hy", "px", "py", "pairx", "pairy",
+            ] {
+                ee_program = ee_program.replace(&format!(" {name}"), &format!(" p32-{name}"));
+            }
+            graph.parse_and_run_program(None, &ee_program).unwrap();
+            assert!(matches!(
+                graph.parse_and_run_program(None, "(check-contradiction)"),
+                Err(Error::CheckError(..))
+            ));
+            for (name, a, b, field) in [
+                ("EEWord", "x", "y", "word_known"),
+                ("EEParts", "px", "py", "parts_known"),
+                ("EEPair", "pairx", "pairy", "pair_known"),
+                ("EEHigh", "hx", "hy", "high_known"),
+            ] {
+                assert_eq!(
+                    query(
+                        &mut graph,
+                        name,
+                        &format!("p32-{a}"),
+                        &format!("p32-{b}"),
+                        !matches!(mode, Mode::ReverseOff | Mode::Rescue)
+                    )
+                    .unwrap(),
+                    receipt[field].as_bool().unwrap(),
+                    "{receipt}"
+                );
+            }
+        }
+    }
