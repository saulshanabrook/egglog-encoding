(datatype Scope (ThisScope))
(datatype Word)
(datatype Parts)
(constructor X (Scope) Word)
(constructor Y (Scope) Word)
(constructor Low (Word i64) Word)
(constructor High (Word i64 i64) Word)
(constructor Parts32 (Word) Parts :injective)
(constructor Pair (Word Word) Parts)
(let p32-x (X (ThisScope)))
(let p32-y (Y (ThisScope)))
(let p32-lx (Low p32-x 4294967295))
(let p32-ly (Low p32-y 4294967295))
(let p32-hx (High p32-x 4294967295 4294967296))
(let p32-hy (High p32-y 4294967295 4294967296))
(let p32-px (Parts32 p32-x))
(let p32-py (Parts32 p32-y))
(let p32-pairx (Pair p32-lx p32-hx))
(let p32-pairy (Pair p32-ly p32-hy))
(union p32-px p32-pairx)
(union p32-py p32-pairy)
(disequal p32-x p32-y)
(union p32-lx p32-ly)
(run-schedule (saturate injectivity))
(check (known-disequal? p32-hx p32-hy))
