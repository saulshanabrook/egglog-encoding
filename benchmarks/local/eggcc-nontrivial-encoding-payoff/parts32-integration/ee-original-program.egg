(datatype Scope (ThisScope))
(datatype Word)
(datatype Parts)
(constructor X (Scope) Word)
(constructor Y (Scope) Word)
(constructor Low (Word i64) Word)
(constructor High (Word i64 i64) Word)
(constructor Parts32 (Word) Parts :injective)
(constructor Pair (Word Word) Parts)
(let x (X (ThisScope)))
(let y (Y (ThisScope)))
(let lx (Low x 4294967295))
(let ly (Low y 4294967295))
(let hx (High x 4294967295 4294967296))
(let hy (High y 4294967295 4294967296))
(let px (Parts32 x))
(let py (Parts32 y))
(let pairx (Pair lx hx))
(let pairy (Pair ly hy))
(union px pairx)
(union py pairy)
(disequal x y)
(union lx ly)
(run-schedule (saturate injectivity))
