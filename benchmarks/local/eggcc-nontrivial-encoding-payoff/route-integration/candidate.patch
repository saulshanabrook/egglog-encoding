+    #[test]
+    fn route_chain_causal_controls() {
+        for mode in [
+            Mode::Encoding,
+            Mode::Manual,
+            Mode::CancellationOff,
+            Mode::ForwardOff,
+            Mode::ReverseOff,
+            Mode::IdentityOff,
+            Mode::EqualityRescue,
+            Mode::DisequalityRescue,
