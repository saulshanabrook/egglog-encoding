+                        | Mode::Manual
+                        | Mode::EqualityRescue
+                        | Mode::DisequalityRescue
+                        | Mode::ApplicationOff
+                ),
+                "{receipt}",
+            );
+            if mode == Mode::CancellationOff {
+                assert_eq!(receipt["a_equal_c"], false);
+                assert_eq!(receipt["target_known_disequal"], false);
+            }
+            if mode == Mode::ForwardOff {
+                assert_eq!(receipt["z_known_disequal_w"], true);
+                assert_eq!(receipt["target_known_disequal"], false);
+            }
+            if mode == Mode::ReverseOff {
+                assert_eq!(receipt["a_equal_c"], true);
+                assert_eq!(receipt["z_known_disequal_w"], false);
+            }
+            if mode == Mode::IdentityOff {
+                assert_eq!(receipt["pair_equal"], true);
+                assert_eq!(receipt["a_equal_c"], false);
+            }
+            if mode == Mode::PrimitiveOnly {
+                assert_eq!(receipt["fixed_primitive_column_comparisons"]["compared"], 8);
+                assert_eq!(receipt["fixed_primitive_column_comparisons"]["unequal"], 0);
+                assert_eq!(receipt["export"], false);
+            }
+            if mode == Mode::EqualityRescue {
+                assert_eq!(receipt["route_marked"], false);
+                assert_eq!(receipt["a_equal_c"], true);
+                assert_eq!(receipt["b_equal_d"], false);
+                assert_eq!(receipt["z_known_disequal_w"], true);
+            }
+            if mode == Mode::DisequalityRescue {
+                assert_eq!(receipt["route_marked"], false);
+                assert_eq!(receipt["reverse_enabled"], false);
+                assert_eq!(receipt["a_equal_c"], false);
+                assert_eq!(receipt["z_known_disequal_w"], true);
+            }
+            if mode == Mode::Encoding {
+                assert_eq!(receipt["bottom"], false);
+            }
+        }
+    }
+
+    #[test]
+    fn route_manual_closure_respects_missing_edges() {
+        assert_eq!(
+            manual(true, true, true, true, false, false, true).0,
+            [true; 7]
+        );
+        assert_eq!(
+            manual(false, true, true, true, false, false, true).0,
+            [true, false, false, true, true, false, false],
+        );
+        assert_eq!(
+            manual(true, false, true, true, false, false, true).0,
+            [true, true, true, true, true, true, false],
+        );
+        assert_eq!(
+            manual(true, true, false, true, false, false, true).0,
+            [true, true, true, true, true, false, false],
+        );
+        assert_eq!(
+            manual(true, true, true, false, false, false, true).0,
+            [false, false, false, true, true, false, false],
+        );
+    }
+}
