+//! Private, exact-scope experiment for a tagged paired routing key.
+//!
+//! Only a checked final `Eq=false` leaves this sidecar. Dynamic equalities and
+//! disequalities remain in a fresh graph for one source predicate.
+
+use crate::schema::{
+    Assumption, BaseType, BinaryOp, Constant, Expr, RcExpr, TernaryOp, TreeProgram, Type,
+};
+use egglog::{new_experimental_egraph_with_options, DisequalityEncoding, Error};
+use serde_json::json;
+use std::{
+    collections::BTreeSet,
+    path::Path,
+    sync::atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum Word {
+    Slot(usize),
+    Constant(i64),
+    Add(Box<Word>, Box<Word>),
+    Scale(Box<Word>, i64),
+    Select(Box<Selector>, Box<Word>, Box<Word>),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum Selector {
+    LessThan(Box<Word>, Box<Word>),
+}
+
+fn tuple_length(expr: &RcExpr) -> Option<usize> {
+    match expr.as_ref() {
+        Expr::Single(_) => Some(1),
+        Expr::Concat(a, b) => Some(tuple_length(a)? + tuple_length(b)?),
+        Expr::Empty(_, _) => Some(0),
+        Expr::Arg(Type::TupleT(fields), _) => Some(fields.len()),
+        _ => None,
+    }
+}
+
+/// Project through the branch input syntax without inventing tuple equalities.
+fn project(expr: &RcExpr, index: usize) -> Option<RcExpr> {
+    match expr.as_ref() {
+        Expr::Single(value) if index == 0 => Some(value.clone()),
+        Expr::Concat(left, right) => {
+            let length = tuple_length(left)?;
+            if index < length {
+                project(left, index)
+            } else {
+                project(right, index - length)
+            }
+        }
+        Expr::Arg(Type::TupleT(fields), _) if index < fields.len() => {
+            Some(RcExpr::new(Expr::Get(expr.clone(), index)))
+        }
+        _ => None,
+    }
+}
+
+/// Translate a pure integer expression through its exact enclosing If inputs.
+fn translate(expr: &RcExpr, root: &Assumption, expected: &Assumption) -> Option<Word> {
+    if expr.get_ctx() != expected {
+        return None;
+    }
+    match expr.as_ref() {
+        Expr::Const(Constant::Int(value), _, _) => Some(Word::Constant(*value)),
+        Expr::Arg(Type::Base(BaseType::IntT), ctx) if ctx == root => Some(Word::Slot(0)),
+        Expr::Get(arg, index) => {
+            let Expr::Arg(Type::TupleT(fields), ctx) = arg.as_ref() else {
+                return None;
+            };
+            if fields.get(*index) != Some(&BaseType::IntT) {
+                return None;
+            }
+            if ctx == root {
+                Some(Word::Slot(*index))
+            } else if let Assumption::InIf(_, _, input) = ctx {
+                translate(&project(input, *index)?, root, input.get_ctx())
+            } else {
+                None
+            }
+        }
+        Expr::Top(TernaryOp::Select, predicate, left, right) => {
+            let Expr::Bop(BinaryOp::LessThan, first, second) = predicate.as_ref() else {
+                return None;
+            };
+            if predicate.get_ctx() != expected {
+                return None;
+            }
+            Some(Word::Select(
+                Box::new(Selector::LessThan(
+                    Box::new(translate(first, root, expected)?),
+                    Box::new(translate(second, root, expected)?),
+                )),
+                Box::new(translate(left, root, expected)?),
+                Box::new(translate(right, root, expected)?),
+            ))
+        }
+        Expr::Bop(BinaryOp::Add, left, right) => Some(Word::Add(
+            Box::new(translate(left, root, expected)?),
+            Box::new(translate(right, root, expected)?),
+        )),
+        Expr::Bop(BinaryOp::Mul, left, right) => {
+            let left = translate(left, root, expected)?;
+            let right = translate(right, root, expected)?;
+            match (left, right) {
+                (Word::Constant(coefficient), value) | (value, Word::Constant(coefficient)) => {
+                    Some(Word::Scale(Box::new(value), coefficient))
+                }
+                _ => None,
+            }
+        }
+        _ => None,
+    }
+}
+
+/// Return the non-shared Add child, rejecting ambiguous double matches.
+fn other_addend(sum: &Word, shared: &Word) -> Option<Word> {
+    let Word::Add(left, right) = sum else {
+        return None;
+    };
+    match (left.as_ref() == shared, right.as_ref() == shared) {
+        (true, false) => Some(right.as_ref().clone()),
+        (false, true) => Some(left.as_ref().clone()),
+        _ => None,
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Mode {
+    Off,
+    SeedOnly,
+    PrimitiveOnly,
+    CancellationOff,
+    ForwardOff,
+    ReverseOff,
+    IdentityOff,
+    EqualityRescue,
+    DisequalityRescue,
+    QueryOff,
+    Manual,
+    Encoding,
+    BridgeOff,
+    ApplicationOff,
+}
+
+impl Mode {
+    fn from_env() -> Self {
+        match std::env::var("EGGCC_SCOPED_MODE")
+            .as_deref()
+            .unwrap_or("off")
+        {
+            "off" => Self::Off,
+            "seed-only" => Self::SeedOnly,
+            "primitive-only" => Self::PrimitiveOnly,
+            "cancellation-off" => Self::CancellationOff,
+            "forward-off" => Self::ForwardOff,
+            "reverse-off" => Self::ReverseOff,
+            "identity-off" => Self::IdentityOff,
+            "equality-rescue" => Self::EqualityRescue,
+            "disequality-rescue" => Self::DisequalityRescue,
+            "query-off" => Self::QueryOff,
+            "manual" => Self::Manual,
+            "encoding" => Self::Encoding,
+            "bridge-off" => Self::BridgeOff,
+            "application-off" => Self::ApplicationOff,
+            other => panic!("Unknown EGGCC_SCOPED_MODE: {other}"),
+        }
+    }
+}
+
+type ApplicationRow = (&'static str, Vec<usize>, Vec<i64>, usize, bool);
+
+fn merge(equality: &mut [usize], left: usize, right: usize) {
+    let old = equality[right];
+    let new = equality[left];
+    for value in equality {
+        if *value == old {
+            *value = new;
+        }
+    }
+}
+
+/// Independent finite closure over the same generic rows and committed seeds.
+fn manual(
+    route_marked: bool,
+    mul_marked: bool,
+    reverse: bool,
+    identity: bool,
+    equality_rescue: bool,
+    disequality_rescue: bool,
+    equality_reasoning: bool,
+) -> ([bool; 7], bool, usize, usize) {
+    // 0..5 a,b,c,d,z,w; 6..9 components; 10..13 key products;
+    // 14..15 mixed Adds; 16..17 odd products.
+    let rows: Vec<ApplicationRow> = vec![
+        ("Select", vec![18, 0, 1], vec![], 6, false),
+        ("Select", vec![18, 1, 0], vec![], 7, false),
+        ("Select", vec![18, 2, 3], vec![], 8, false),
+        ("Select", vec![18, 3, 2], vec![], 9, false),
+        ("Route", vec![18, 0, 1], vec![], 10, route_marked),
+        ("Route", vec![18, 2, 3], vec![], 11, route_marked),
+        ("Triple", vec![18, 6, 7], vec![], 12, false),
+        ("Triple", vec![18, 8, 9], vec![], 13, false),
+        ("Add", vec![2, 4], vec![], 14, false),
+        ("Add", vec![0, 5], vec![], 15, false),
+        ("OddMul", vec![4], vec![3], 16, mul_marked),
+        ("OddMul", vec![5], vec![3], 17, mul_marked),
+    ];
+    let mut equality = (0..19).collect::<Vec<_>>();
+    merge(&mut equality, 6, 8);
+    merge(&mut equality, 7, 9);
+    if identity {
+        merge(&mut equality, 10, 12);
+        merge(&mut equality, 11, 13);
+    }
+    let mut disequality = BTreeSet::from([(14, 15)]);
+    if equality_rescue {
+        merge(&mut equality, 0, 2);
+    }
+    if disequality_rescue {
+        disequality.insert((4, 5));
+    }
+    let mut primitive_comparisons = (0usize, 0usize);
+    loop {
+        let before = (equality.clone(), disequality.clone());
+        for (left_name, left_children, left_params, left_output, left_marked) in &rows {
+            for (right_name, right_children, right_params, right_output, _) in &rows {
+                if left_name != right_name {
+                    continue;
+                }
+                let mut primitive_match = left_params.len() == right_params.len();
+                for (left, right) in left_params.iter().zip(right_params) {
+                    primitive_comparisons.0 += 1;
+                    primitive_comparisons.1 += usize::from(left == right);
+                    primitive_match &= left == right;
+                }
+                if !primitive_match || (!equality_reasoning && !left_children.is_empty()) {
+                    continue;
+                }
+                if left_children
+                    .iter()
+                    .zip(right_children)
+                    .all(|(left, right)| equality[*left] == equality[*right])
+                {
+                    merge(&mut equality, *left_output, *right_output);
+                }
+                if *left_marked && equality[*left_output] == equality[*right_output] {
+                    for (left, right) in left_children.iter().zip(right_children) {
+                        merge(&mut equality, *left, *right);
+                    }
+                }
+            }
+        }
+        disequality = disequality
+            .into_iter()
+            .map(|(left, right)| {
+                let (left, right) = (equality[left], equality[right]);
+                (left.min(right), left.max(right))
+            })
+            .collect();
+        for (left_name, left_children, left_params, left_output, left_marked) in &rows {
+            for (right_name, right_children, right_params, right_output, _) in &rows {
+                if left_name != right_name {
+                    continue;
+                }
+                let mut primitive_match = left_params.len() == right_params.len();
+                for (left, right) in left_params.iter().zip(right_params) {
+                    primitive_comparisons.0 += 1;
+                    primitive_comparisons.1 += usize::from(left == right);
+                    primitive_match &= left == right;
+                }
+                if !primitive_match || (!equality_reasoning && !left_children.is_empty()) {
+                    continue;
+                }
+                let (left, right) = (equality[*left_output], equality[*right_output]);
+                let output = (left.min(right), left.max(right));
+                for (index, (left_child, right_child)) in
+                    left_children.iter().zip(right_children).enumerate()
+                {
+                    let (left, right) = (equality[*left_child], equality[*right_child]);
+                    let child = (left.min(right), left.max(right));
+                    if *left_marked && disequality.contains(&child) {
+                        disequality.insert(output);
+                    }
+                    if reverse
+                        && disequality.contains(&output)
+                        && left_children.iter().zip(right_children).enumerate().all(
+                            |(other, (left, right))| {
+                                other == index || equality[*left] == equality[*right]
+                            },
+                        )
+                    {
+                        disequality.insert(child);
+                    }
+                }
+            }
+        }
+        if before == (equality.clone(), disequality.clone()) {
+            break;
+        }
+    }
+    let equal = |left: usize, right: usize| equality[left] == equality[right];
+    let disequal = |left: usize, right: usize| {
+        let (left, right) = (equality[left], equality[right]);
+        disequality.contains(&(left.min(right), left.max(right)))
+    };
+    (
+        [
+            equal(10, 11),
+            equal(0, 2),
+            equal(1, 3),
+            equal(12, 13),
+            disequal(14, 15),
+            disequal(4, 5),
+            disequal(16, 17),
+        ],
+        disequality.iter().any(|(left, right)| left == right),
+        primitive_comparisons.0,
+        primitive_comparisons.1,
+    )
+}
+
+fn query_disequality(
+    graph: &mut egglog::EGraph,
+    name: &str,
+    left: &str,
+    right: &str,
+    reverse: bool,
+) -> Result<bool, Error> {
+    graph.parse_and_run_program(None,&format!("(relation {name} ())\n(ruleset {name}-query)\n(rule (({} {left} {right})) (({name})) :ruleset {name}-query :naive)\n(run-schedule (run {name}-query))",if reverse{"known-disequal?"}else{"known-disequal-forward-only?"}))?;
+    Ok(graph.get_size(name) > 0)
+}
+
+fn query_equality(
+    graph: &mut egglog::EGraph,
+    name: &str,
+    left: &str,
+    right: &str,
+) -> Result<bool, Error> {
+    graph.parse_and_run_program(
+        None,
+        &format!("(relation {name} ())\n(ruleset {name}-query)\n(rule ((= {left} {right})) (({name})) :ruleset {name}-query :naive)\n(run-schedule (run {name}-query))"),
+    )?;
+    Ok(graph.get_size(name) > 0)
+}
+
+fn prove(mode: Mode) -> Result<(bool, serde_json::Value), Error> {
+    let route_marked = !matches!(
+        mode,
+        Mode::CancellationOff | Mode::EqualityRescue | Mode::DisequalityRescue
+    );
+    let mul_marked = mode != Mode::ForwardOff;
+    let reverse = !matches!(mode, Mode::ReverseOff | Mode::DisequalityRescue);
+    let identity = mode != Mode::IdentityOff;
+    let equality_rescue = mode == Mode::EqualityRescue;
+    let disequality_rescue = mode == Mode::DisequalityRescue;
+    let mut program = format!(
+        "(datatype Scope (ThisScope))\n(datatype Word)\n(datatype Selector)\n(datatype Key)\n(constructor P (Scope) Selector)\n(constructor A (Scope) Word)\n(constructor B (Scope) Word)\n(constructor C (Scope) Word)\n(constructor D (Scope) Word)\n(constructor Z (Scope) Word)\n(constructor W (Scope) Word)\n(constructor Select (Selector Word Word) Word)\n(constructor Route (Selector Word Word) Key {})\n(constructor Triple (Selector Word Word) Key)\n(constructor Add (Word Word) Word)\n(constructor OddMul (Word i64) Word {})\n(let p (P (ThisScope)))\n(let a (A (ThisScope)))\n(let b (B (ThisScope)))\n(let c (C (ThisScope)))\n(let d (D (ThisScope)))\n(let z (Z (ThisScope)))\n(let w (W (ThisScope)))\n(let uab (Select p a b))\n(let vab (Select p b a))\n(let ucd (Select p c d))\n(let vcd (Select p d c))\n(let kab (Route p a b))\n(let kcd (Route p c d))\n(let pab (Triple p uab vab))\n(let pcd (Triple p ucd vcd))\n(let acz (Add c z))\n(let aaw (Add a w))\n(let mz (OddMul z 3))\n(let mw (OddMul w 3))\n",
+        if route_marked { ":injective" } else { "" },
+        if mul_marked { ":injective" } else { "" },
+    );
+    if identity {
+        program.push_str("(union kab pab)\n(union kcd pcd)\n");
+    }
+    program.push_str("(union uab ucd)\n(union vab vcd)\n(disequal acz aaw)\n");
+    if equality_rescue {
+        program.push_str("(union a c)\n");
+    }
+    if disequality_rescue {
+        program.push_str("(disequal z w)\n");
+    }
+    let run_engine = !matches!(mode, Mode::SeedOnly | Mode::PrimitiveOnly | Mode::Manual);
+    if run_engine {
+        program.push_str("(run-schedule (saturate injectivity))\n");
+    }
+    let mut graph = new_experimental_egraph_with_options(false, DisequalityEncoding::Nee);
+    graph.parse_and_run_program(None, &program)?;
+    let manual_result = if matches!(mode, Mode::Manual | Mode::PrimitiveOnly) {
+        Some(manual(
+            route_marked,
+            mul_marked,
+            reverse,
+            identity,
+            equality_rescue,
+            disequality_rescue,
+            mode == Mode::Manual,
+        ))
+    } else {
+        None
+    };
+    let bottom = if run_engine {
+        match graph.parse_and_run_program(None, "(check-contradiction)") {
+            Ok(_) => true,
+            Err(Error::CheckError(..)) => false,
+            Err(error) => return Err(error),
+        }
+    } else if mode == Mode::Manual {
+        manual_result.unwrap().1
+    } else {
+        false
+    };
+    let mut known = [false; 7];
+    let mut target_queried = false;
+    if !bottom {
+        if mode == Mode::Manual {
+            known = manual_result.unwrap().0;
+            target_queried = true;
+        } else if !matches!(mode, Mode::SeedOnly | Mode::PrimitiveOnly) {
+            known[0] = query_equality(&mut graph, "KeyEqual", "kab", "kcd")?;
+            known[1] = query_equality(&mut graph, "AEqual", "a", "c")?;
+            known[2] = query_equality(&mut graph, "BEqual", "b", "d")?;
+            known[3] = query_equality(&mut graph, "PairEqual", "pab", "pcd")?;
+            known[4] = query_disequality(&mut graph, "AddKnown", "acz", "aaw", reverse)?;
+            known[5] = query_disequality(&mut graph, "ZKnown", "z", "w", reverse)?;
+            if mode != Mode::QueryOff {
+                known[6] = query_disequality(&mut graph, "TargetKnown", "mz", "mw", reverse)?;
+                target_queried = true;
+            }
+        }
+    }
+    let export = !bottom && known[6] && mode != Mode::BridgeOff;
+    Ok((
+        export,
+        json!({
+            "mode":format!("{mode:?}"),
+            "encoding":"NEE",
+            "program":program,
+            "key_law":"Route(p,a,b)=(p,Select(p,a,b),Select(p,b,a))",
+            "selector_sort":"equality-sort Selector; opaque dynamic value",
+            "component_equal_seeds":[true,true],
+            "mixed_add_disequality_seed":true,
+            "key_equal":known[0],
+            "a_equal_c":known[1],
+            "b_equal_d":known[2],
+            "pair_equal":known[3],
+            "mixed_add_known_disequal":if matches!(mode,Mode::SeedOnly|Mode::PrimitiveOnly){None}else{Some(known[4])},
+            "z_known_disequal_w":if matches!(mode,Mode::SeedOnly|Mode::PrimitiveOnly){None}else{Some(known[5])},
+            "target_known_disequal":if target_queried{Some(known[6])}else{None},
+            "target_queried":target_queried,
+            "bottom":if matches!(mode,Mode::SeedOnly|Mode::PrimitiveOnly){None}else{Some(bottom)},
+            "manual_receipts":manual_result.map(|value|value.0),
+            "manual_bottom":manual_result.map(|value|value.1),
+            "fixed_primitive_column_comparisons":manual_result.map(|value| json!({"compared":value.2,"equal":value.3,"unequal":value.2-value.3,"column":"OddMul.coefficient","values":[3,3]})),
+            "export":export,
+            "application_enabled":mode!=Mode::ApplicationOff,
+            "route_marked":route_marked,
+            "odd_mul_marked":mul_marked,
+            "reverse_enabled":reverse,
+            "representation_identity":identity,
+            "intermediate_equality_rescue":equality_rescue,
+            "intermediate_disequality_rescue":disequality_rescue,
+            "injectivity_saturated":run_engine,
+            "engine_witness_queries_run":!matches!(mode,Mode::SeedOnly|Mode::PrimitiveOnly|Mode::Manual),
+            "manual_closure_run":mode==Mode::Manual,
+            "primitive_only_marked_primitive_fields":[3],
+            "primitive_only_same_rows_seeds_identities":mode==Mode::PrimitiveOnly,
+            "primitive_only_equality_sort_reasoning":false,
+            "primitive_only_dynamic_witness":false,
+        }),
+    ))
+}
+
+/// Admit only complementary Selects with a common localized tag and exact tail.
+pub(crate) fn analyze(program: &TreeProgram) -> Vec<RcExpr> {
+    let mode = Mode::from_env();
+    if mode == Mode::Off {
+        return Vec::new();
+    }
+    static BOUNDARY: AtomicUsize = AtomicUsize::new(0);
+    let boundary = BOUNDARY.fetch_add(1, Ordering::Relaxed);
+    let types = program.typecheck();
+    let mut stack = vec![program.entry.clone()];
+    stack.extend(program.functions.clone());
+    let (mut seen, mut exports, mut receipts) = (BTreeSet::new(), Vec::new(), Vec::new());
+    while let Some(expr) = stack.pop() {
+        if !seen.insert(std::rc::Rc::as_ptr(&expr)) {
+            continue;
+        }
+        stack.extend(expr.children_exprs());
+        let Expr::If(target, _, _, _) = expr.as_ref() else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, target_left, target_right) = target.as_ref() else {
+            continue;
+        };
+        if types.get(&std::rc::Rc::as_ptr(target)) != Some(&Type::Base(BaseType::BoolT)) {
+            continue;
+        }
+        let target_scope = target.get_ctx();
+        let Assumption::InIf(false, mixed_predicate, mixed_input) = &target_scope else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, mixed_left, mixed_right) = mixed_predicate.as_ref() else {
+            continue;
+        };
+        let mixed_scope = mixed_predicate.get_ctx();
+        let Assumption::InIf(true, second_predicate, second_input) = &mixed_scope else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, second_left, second_right) = second_predicate.as_ref() else {
+            continue;
+        };
+        let second_scope = second_predicate.get_ctx();
+        let Assumption::InIf(true, first_predicate, first_input) = &second_scope else {
+            continue;
+        };
+        let Expr::Bop(BinaryOp::Eq, first_left, first_right) = first_predicate.as_ref() else {
+            continue;
+        };
+        let root = first_predicate.get_ctx();
+        let translated_first = (
+            translate(first_left, root, root),
+            translate(first_right, root, root),
+        );
+        let translated_second = (
+            translate(second_left, root, second_scope),
+            translate(second_right, root, second_scope),
+        );
+        let translated_mixed = (
+            translate(mixed_left, root, mixed_scope),
+            translate(mixed_right, root, mixed_scope),
+        );
+        let translated_target = (
+            translate(target_left, root, target_scope),
+            translate(target_right, root, target_scope),
+        );
+        let accepted = (|| {
+            let (Some(first_left), Some(first_right)) = &translated_first else {
+                return None;
+            };
+            let (Word::Select(first_tag, a, b), Word::Select(right_tag, c, d)) =
+                (first_left, first_right)
+            else {
+                return None;
+            };
+            if first_tag != right_tag {
+                return None;
+            }
+            let (Some(second_left), Some(second_right)) = &translated_second else {
+                return None;
+            };
+            let expected_left = Word::Select(first_tag.clone(), b.clone(), a.clone());
+            let expected_right = Word::Select(first_tag.clone(), d.clone(), c.clone());
+            if !((second_left == &expected_left && second_right == &expected_right)
+                || (second_left == &expected_right && second_right == &expected_left))
+            {
+                return None;
+            }
+            let (a, b, c, d) = (
+                a.as_ref().clone(),
+                b.as_ref().clone(),
+                c.as_ref().clone(),
+                d.as_ref().clone(),
+            );
+            if [a.clone(), b.clone(), c.clone(), d.clone()]
+                .iter()
+                .any(|word| matches!(word, Word::Constant(_)))
+                || a == c
+                || b == d
+            {
+                return None;
+            }
+            let (Some(mixed_left), Some(mixed_right)) = &translated_mixed else {
+                return None;
+            };
+            let (z, w) = if let (Some(z), Some(w)) =
+                (other_addend(mixed_left, &c), other_addend(mixed_right, &a))
+            {
+                (z, w)
+            } else {
+                (
+                    other_addend(mixed_right, &c)?,
+                    other_addend(mixed_left, &a)?,
+                )
+            };
+            if z == w || matches!(z, Word::Constant(_)) || matches!(w, Word::Constant(_)) {
+                return None;
+            }
+            let (Some(target_left), Some(target_right)) = &translated_target else {
+                return None;
+            };
+            let (Word::Scale(left_child, 3), Word::Scale(right_child, 3)) =
+                (target_left, target_right)
+            else {
+                return None;
+            };
+            let target_children = (left_child.as_ref().clone(), right_child.as_ref().clone());
+            if target_children != (z.clone(), w.clone())
+                && target_children != (w.clone(), z.clone())
+            {
+                return None;
+            }
+            Some((a, b, c, d, z, w))
+        })();
+        let Some((a, b, c, d, z, w)) = accepted else {
+            receipts.push(json!({
+                "accepted":false,
+                "reason":"exact paired routing, common tag, contexts, mixed Add, or odd target mismatch",
+                "first":format!("{translated_first:?}"),
+                "second":format!("{translated_second:?}"),
+                "mixed":format!("{translated_mixed:?}"),
+                "target":format!("{translated_target:?}"),
+            }));
+            continue;
+        };
+        let (export, mut receipt) = match prove(mode) {
+            Ok(value) => value,
+            Err(error) => (
+                false,
+                json!({"analysis_error":format!("{error:?}"),"export":false}),
+            ),
+        };
+        receipt["accepted"] = json!(true);
+        receipt["source_first_component"] = json!(first_predicate.to_string());
+        receipt["source_second_component"] = json!(second_predicate.to_string());
+        receipt["source_mixed_add"] = json!(mixed_predicate.to_string());
+        receipt["source_target"] = json!(target.to_string());
+        receipt["root_scope"] = json!(root.to_string());
+        receipt["second_scope"] = json!(second_scope.to_string());
+        receipt["mixed_scope"] = json!(mixed_scope.to_string());
+        receipt["target_scope"] = json!(target_scope.to_string());
+        receipt["first_input"] = json!(first_input.to_string());
+        receipt["second_input"] = json!(second_input.to_string());
+        receipt["mixed_input"] = json!(mixed_input.to_string());
+        receipt["translated_dynamic_words"] =
+            json!(format!("a={a:?},b={b:?},c={c:?},d={d:?},z={z:?},w={w:?}"));
+        receipts.push(receipt);
+        if export {
+            exports.push(target.clone());
+        }
+    }
+    if let Ok(directory) = std::env::var("EGGCC_SCOPED_EVIDENCE") {
+        std::fs::create_dir_all(&directory).unwrap();
+        let path = Path::new(&directory).join(format!("boundary-{boundary:04}.json"));
+        assert!(!path.exists());
+        std::fs::write(
+            path,
+            serde_json::to_vec_pretty(&json!({
+                "boundary":boundary,
+                "mode":format!("{mode:?}"),
+                "queries":receipts,
+                "exports":exports.len(),
+            }))
+            .unwrap(),
+        )
+        .unwrap();
+    }
+    exports
+}
