# ARGS: 0 1 2 1 0 0 1 0
@main(a: int, b: int, c: int, d: int, z: int, w: int, q: int, r: int) {
  zero: int = const 0;
  one: int = const 1;
  two: int = const 2;
  three: int = const 3;
  p: bool = lt q r;
  uab: int = select p a b;
  vab: int = select p b a;
  ucd: int = select p c d;
  vcd: int = select p d c;
  key0: bool = eq uab ucd;
  br key0 .key0_ok .different_key;
.key0_ok:
  key1: bool = eq vab vcd;
  jmp .key1_ok;
.key1_ok:
  cz: int = add c z;
  aw: int = add a w;
  mixed_same: bool = eq cz aw;
  br mixed_same .equal_sum .different_sum;
.different_sum:
  tz: int = mul z three;
  tw: int = mul w three;
  target: bool = eq tz tw;
  br target .unexpected .expected;
.unexpected:
  score: int = const 99;
  print score;
  ret;
.expected:
  score: int = const 7;
  print score;
  ret;
.equal_sum:
  score: int = const 5;
  print score;
  ret;
.different_key:
  score: int = const 3;
  print score;
  ret;
}
