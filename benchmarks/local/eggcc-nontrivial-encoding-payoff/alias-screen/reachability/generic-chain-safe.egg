; Finite symbolic law probe only; these are not EggCC main-graph expressions.
(sort Value)
(sort Region)
(constructor Atom (String) Value)
(constructor R () Region)
(constructor Mask (Value i64) Value)
(constructor Shift1 (Value) Value :injective)
(constructor Shift2 (Value) Value :injective)
(constructor PlainShift (Value) Value)
(constructor LiveCell (Region Value) Value :injective)
(constructor PlainCell (Region Value) Value)

(let $probe-x (Atom "$probe-x"))
(let $probe-y (Atom "$probe-y"))
(let $probe-mx (Mask $probe-x 1))
(let $probe-my (Mask $probe-y 1))
(let $probe-sx (Shift1 $probe-x))
(let $probe-sy (Shift1 $probe-y))
(let $probe-cx (LiveCell (R) $probe-sx))
(let $probe-cy (LiveCell (R) $probe-sy))
(let $probe-px (PlainShift $probe-x))
(let $probe-py (PlainShift $probe-y))
(let $probe-cpx (LiveCell (R) $probe-px))
(let $probe-cpy (LiveCell (R) $probe-py))
(let $probe-pcx (PlainCell (R) $probe-sx))
(let $probe-pcy (PlainCell (R) $probe-sy))
(let $probe-other-shift (Shift2 $probe-y))

; Different primitive metadata on unmarked Atom does not establish disequality.
(fail (check (known-disequal? $probe-x $probe-y)))
(fail (check (known-disequal? $probe-cx $probe-cy)))
(disequal $probe-mx $probe-my)
(run-schedule (saturate injectivity))
(fail (check-contradiction))
(check (known-disequal? $probe-x $probe-y))
(check (known-disequal? $probe-sx $probe-sy))
(check (known-disequal? $probe-cx $probe-cy))
; Each marked forward constructor matters to its target.
(fail (check (known-disequal? $probe-cpx $probe-cpy)))
(fail (check (known-disequal? $probe-pcx $probe-pcy)))
(fail (check (known-disequal? $probe-sx $probe-other-shift)))

; Parent disequality with both argument positions varying identifies no child.
(let $probe-z (Atom "$probe-z"))
(let $probe-w (Atom "$probe-w"))
(let $probe-mz (Mask $probe-z 1))
(let $probe-mw (Mask $probe-w 2))
(disequal $probe-mz $probe-mw)
(fail (check (known-disequal? $probe-z $probe-w)))
(fail (check-contradiction))
