diff --git a/scripts/speq_c99_diagnostic.py b/scripts/speq_c99_diagnostic.py
new file mode 100644
--- /dev/null
+++ b/scripts/speq_c99_diagnostic.py
@@ -0,0 +1,261 @@
+"""Materialize a disabled, source-pinned C99 REV candidate and native analysis gates.
+
+No native tools, source capture, settings publication or admission run here. The
+existing PHI materializer owns the original source/header checks and baseline.
+"""
+
+from __future__ import annotations
+
+import argparse
+import difflib
+import hashlib
+import json
+import re
+from pathlib import Path
+
+from scripts import speq_phi_diagnostic as phi
+from scripts.paper_benchmarks.record_speq import PARSE_IR_SHA256
+
+SUPPORT = Path(__file__).with_name("paper_benchmarks")
+ENABLE_ENV = "SPEQ_REV_C99_DIAGNOSTIC"
+
+
+def candidate_rev(original: str, function: str) -> str:
+    """Bind the exact fragment into pinned PHI-repaired REV, without modifying IR."""
+    if not re.fullmatch(r"[A-Za-z_][A-Za-z_0-9.]*", function):
+        raise ValueError("diagnostic requires one explicit simple LLVM function name")
+    repaired = phi.patched_rev(original)
+    fragment = (SUPPORT / "speq_c99_fir.inc").read_text()
+    first = repaired.index("class Lambda {")
+    last = repaired.index("Value *findLiveOut(", first)
+    before, body, after = repaired[:first], repaired[first:last], repaired[last:]
+    replacements = {
+        "DenseMap<Value *, Tensor *> &TM, DenseMap<Value *, LevelBounds> &LM)": (
+            "DenseMap<Value *, Tensor *> &TM, DenseMap<Value *, LevelBounds> &LM, Function &F)"
+        ),
+        "TensorMap(TM), LevelMap(LM) {}": "TensorMap(TM), LevelMap(LM), C99(LI, SE, MSSA.getDomTree(), F,\n"
+        f'            std::getenv("{ENABLE_ENV}") && F.getName() == "{function}") {{}}',
+        '    return Out;\n    //    llvm_unreachable("val doesn\'t exist in tensor map.");': (
+            "    std::string C99Type = C99.memoryType(I);\n"
+            "    if (!C99Type.empty()) return C99Type;\n"
+            '    return Out;\n    //    llvm_unreachable("val doesn\'t exist in tensor map.");'
+        ),
+        "    auto *Header = L.getHeader();\n": "    auto *Header = L.getHeader();\n    C99.prelude(L, OUTS);\n",
+        "        LoopBody.push_back(&*I);\n": (
+            "        LoopBody.push_back(&*I);\n        if (C99.emit(*I, OUTS)) continue;\n"
+        ),
+        "  DenseMap<Value *, LevelBounds> &LevelMap;\n": (
+            "  DenseMap<Value *, LevelBounds> &LevelMap;\n  C99AddressFIR C99;\n"
+        ),
+    }
+    for old, new in replacements.items():
+        if body.count(old) != 1:
+            raise ValueError(f"C99 REV substitution boundary changed: {old!r}")
+        body = body.replace(old, new, 1)
+    invocation = "  Lambda Lam(LI, SE, MSSA, TensorMap, LevelMap);"
+    if after.count(invocation) != 1:
+        raise ValueError("C99 Lambda invocation boundary changed")
+    after = after.replace(invocation, "  Lambda Lam(LI, SE, MSSA, TensorMap, LevelMap, F);", 1)
+    entry = "REVInfo REVPass::run(Function &F, FunctionAnalysisManager &AM) {\n"
+    if after.count(entry) != 1:
+        raise ValueError("C99 REV entry boundary changed")
+    after = after.replace(
+        entry,
+        entry + f'  if (const char *Enabled = std::getenv("{ENABLE_ENV}")) {{\n'
+        '    if (StringRef(Enabled) != "1")\n'
+        '      report_fatal_error("REV C99 diagnostic enable value must be 1");\n'
+        f'    Function *Selected = F.getParent()->getFunction("{function}");\n'
+        "    if (!Selected || Selected->isDeclaration())\n"
+        '      report_fatal_error("REV C99 selected definition is missing");\n'
+        "    // LLVM module verification requires unique global/function names.\n"
+        "  }\n",
+        1,
+    )
+    return '#include <cstdlib>\n#include "llvm/IR/Module.h"\n' + before + fragment + "\n" + body + after
+
+
+def fixture_cases() -> dict[str, tuple[str, str | None]]:
+    """Use actual LLVM mutations of one guarded kernel as discriminating controls."""
+    original = (SUPPORT / "speq_c99_fixture.ll").read_text()
+    cases: dict[str, tuple[str, str | None]] = {"guarded_stride": (original, None)}
+    mutations = {
+        "nonzero_offset": (
+            "  %element = getelementptr inbounds double, ptr %row.ptr, i64 %j64",
+            "  %shifted = add nuw nsw i64 %j64, 3\n"
+            "  %element = getelementptr inbounds double, ptr %row.ptr, i64 %shifted",
+            None,
+        ),
+        "different_stride": (
+            "%row.offset = mul nuw nsw i64 %row64, %n64",
+            "%wide.stride = add nuw nsw i64 %n64, 7\n  %row.offset = mul nuw nsw i64 %row64, %wide.stride",
+            None,
+        ),
+        "negative_offset": (
+            "ptr %row.ptr, i64 %j64",
+            "ptr %row.ptr, i64 -1",
+            "negative index",
+        ),
+        "unguarded_zext": (
+            "%row.valid = icmp sge i32 %row, 0",
+            "%row.valid = icmp sge i32 %row, -1",
+            "nonnegativity proof",
+        ),
+        "truncation": (
+            "%j64 = zext i32 %j to i64",
+            "%small = trunc i32 %j to i8\n  %j64 = zext i8 %small to i64",
+            "preserve this cast",
+        ),
+        "wrapping_sum": (
+            "%row.offset = mul nuw nsw i64 %row64, %n64",
+            "%row.offset = add i64 %row64, 9223372036854775807",
+            "may wrap",
+        ),
+        "external_load": (
+            "%n64 = zext i32 %n to i64",
+            "%n64 = load i64, ptr @stride",
+            "external definition",
+        ),
+        "mixed_memory_type": (
+            "%old = load double, ptr %element, align 8",
+            "%wrong = load i32, ptr %element, align 4\n  %old = load double, ptr %element, align 8",
+            "incompatible load",
+        ),
+        "non_inbounds": (
+            "%element = getelementptr inbounds double",
+            "%element = getelementptr double",
+            "incompatible GEP",
+        ),
+        "pointer_escape": (
+            "%old = load double, ptr %element, align 8",
+            "call void @escape(ptr %C)\n  %old = load double, ptr %element, align 8",
+            "escapes",
+        ),
+        "non_i64_index": (
+            "ptr %row.ptr, i64 %j64",
+            "ptr %row.ptr, i32 %j",
+            "index is not i64",
+        ),
+        "narrow_pointer_layout": (
+            'target datalayout = "e-p:64:64-i64:64-n8:16:32:64-S128"',
+            'target datalayout = "e-p:64:64:64:32-i64:64-n8:16:32:64-S128"',
+            "64-bit pointer index layout",
+        ),
+        "opaque_external_phi": (
+            "preheader:\n  br label %body",
+            "preheader:\n  %stride.phi = phi i64 [ %n64, %rowguard ]\n  br label %body",
+            "external definition",
+        ),
+        "reserved_name": (
+            "%row.offset",
+            "%reproduction.c99.offset.0",
+            "reserved diagnostic temporary",
+        ),
+    }
+    for name, (old, new, error) in mutations.items():
+        if old not in original:
+            raise ValueError(f"C99 fixture mutation boundary changed: {name}")
+        source = original.replace(old, new).replace("@guarded_stride(", f"@{name}(", 1)
+        if name == "external_load":
+            source += "\n@stride = external global i64\n"
+        if name == "pointer_escape":
+            source += "\ndeclare void @escape(ptr)\n"
+        if name == "opaque_external_phi":
+            source = source.replace("mul nuw nsw i64 %row64, %n64", "mul nuw nsw i64 %row64, %stride.phi")
+        cases[name] = (source, error)
+    cases["unsupported_i16"] = (
+        original.replace("i32", "i16").replace("@guarded_stride(", "@unsupported_i16("),
+        "preserve this cast",
+    )
+    return cases
+
+
+def materialize(source: Path, output: Path, function: str) -> dict:
+    """Reuse PHI evidence, retain a separate disabled candidate and exact-fragment gates."""
+    source, output = source.resolve(), output.resolve()
+    if output.exists() or output.is_relative_to(source):
+        raise ValueError("diagnostic output must be fresh and outside original source")
+    original = (source / "llvm/lib/Analysis/REVPass.cpp").read_text()
+    candidate = candidate_rev(original, function)
+    phi_record = phi.materialize(source, output / "phi")
+    template = (SUPPORT / "speq_c99_harness.cpp").read_text()
+    if template.count("// INSERT_EXACT_C99_FRAGMENT") != 1:
+        raise ValueError("C99 harness substitution boundary changed")
+    fragment = (SUPPORT / "speq_c99_fir.inc").read_text()
+    files = {
+        "candidate/llvm/lib/Analysis/REVPass.cpp": candidate,
+        "candidate/llvm/include/llvm/Analysis/REVPass.h": (output / "phi/original/REVPass.h").read_text(),
+        "candidate/llvm/include/llvm/Analysis/MemorySSA.h": (output / "phi/original/MemorySSA.h").read_text(),
+        "c99-harness.cpp": template.replace("// INSERT_EXACT_C99_FRAGMENT", fragment),
+        "c99-fragment.inc": fragment,
+        "c99-candidate.patch": "".join(
+            difflib.unified_diff(
+                phi.patched_rev(original).splitlines(True),
+                candidate.splitlines(True),
+                fromfile="phi/llvm/lib/Analysis/REVPass.cpp",
+                tofile="candidate/llvm/lib/Analysis/REVPass.cpp",
+            )
+        ),
+    }
+    cases = fixture_cases()
+    files.update({f"fixtures/{name}.ll": text for name, (text, _) in cases.items()})
+    for relative, text in files.items():
+        destination = output / relative
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        destination.write_text(text)
+    record = {
+        "status": "diagnostic-materialized-unrun",
+        "native_execution": False,
+        "corpus_admission": False,
+        "selected_function": function,
+        "candidate_default": "disabled",
+        "parser_contract_sha256": PARSE_IR_SHA256,
+        "enable_environment": {ENABLE_ENV: "1"},
+        "original_source": str(source),
+        "phi_evidence": phi_record,
+        "domain": "dominating pure closure, nonnegative bounded same-double i64 inbounds address chains, typed memory",
+        "unchanged": [
+            "source C",
+            "LLVM input module",
+            "frontend passes",
+            "other functions",
+            "reference rules",
+            "5/1/3 schedule",
+        ],
+        "gates": {
+            name: {"expected_exit": "zero" if error is None else "nonzero", "stderr_contains": error}
+            for name, (_, error) in cases.items()
+        },
+        "required_native_gates": [
+            "verify original failure and exact-fragment positive/negative fixture results",
+            "verify candidate disabled matches PHI baseline for all four reference FIR hashes",
+            "verify enabling missing selected function fails, unrelated function FIR stays unchanged",
+            "verify enabled retained GEMM has complete scalar closure, flat addresses and typed memory",
+            "original complete parent then standalone ordinary replay (separate admission)",
+        ],
+        "implementation_hashes": {
+            str(path.relative_to(Path(__file__).parent.parent)): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in (
+                Path(__file__),
+                Path(phi.__file__),
+                SUPPORT / "speq_c99_fir.inc",
+                SUPPORT / "speq_c99_harness.cpp",
+                SUPPORT / "speq_c99_fixture.ll",
+            )
+        },
+        "files": {name: hashlib.sha256((output / name).read_bytes()).hexdigest() for name in files},
+    }
+    (output / "diagnostic.json").write_text(json.dumps(record, indent=2) + "\n")
+    return record
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--function", required=True)
+    args = parser.parse_args()
+    print(json.dumps(materialize(args.source, args.output, args.function), indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/paper_benchmarks/speq_c99_fir.inc b/scripts/paper_benchmarks/speq_c99_fir.inc
new file mode 100644
--- /dev/null
+++ b/scripts/paper_benchmarks/speq_c99_fir.inc
@@ -0,0 +1,212 @@
+// Diagnostic-only serialization repair. Never changes the LLVM module.
+// The exact fragment is shared by the candidate REV and native analysis harness.
+class C99AddressFIR {
+  LoopInfo &LI;
+  ScalarEvolution &SE;
+  DominatorTree &DT;
+  Function &F;
+  bool Active = false;
+  unsigned NextOffset = 0;
+
+  [[noreturn]] void reject(const Twine &Why) const {
+    report_fatal_error(Twine("REV C99 address domain: ") + Why);
+  }
+
+  bool nonnegative(Value *V, Instruction &At) {
+    if (auto *C = dyn_cast<ConstantInt>(V))
+      return !C->isNegative();
+    return SE.isKnownPredicateAt(ICmpInst::ICMP_SGE, SE.getSCEV(V),
+                                SE.getZero(V->getType()), &At);
+  }
+
+  // FIR's Int is a mathematical signed integer; its parser erases casts.
+  // Establish a conservative range before accepting that erasure or a new sum.
+  APInt indexBound(Value *V, Instruction &At) {
+    auto *Ty = dyn_cast<IntegerType>(V->getType());
+    if (!Ty || (!Ty->isIntegerTy(8) && !Ty->isIntegerTy(32) && !Ty->isIntegerTy(64)))
+      reject("FIR supports only scalar i8/i32/i64 integer indices");
+    unsigned Width = Ty->getBitWidth();
+    APInt Limit = APInt::getSignedMaxValue(Width).zext(128);
+    if (auto *C = dyn_cast<ConstantInt>(V)) {
+      if (C->isNegative()) reject("negative index");
+      return C->getValue().zext(128);
+    }
+    if (auto *Cast = dyn_cast<CastInst>(V)) {
+      if ((!isa<SExtInst>(Cast) && !isa<ZExtInst>(Cast)) ||
+          !Cast->getSrcTy()->isIntegerTy() ||
+          Cast->getSrcTy()->getIntegerBitWidth() >= Width)
+        reject("unsupported index cast");
+      // Signed extension preserves the signed value; zero extension does so
+      // only under a use-site nonnegativity proof. This domain needs both >=0.
+      return indexBound(Cast->getOperand(0), At);
+    }
+    if (auto *Op = dyn_cast<BinaryOperator>(V)) {
+      if (Op->getOpcode() != Instruction::Add &&
+          Op->getOpcode() != Instruction::Mul)
+        reject("unsupported index arithmetic");
+      APInt A = indexBound(Op->getOperand(0), At);
+      APInt B = indexBound(Op->getOperand(1), At);
+      APInt Bound = Op->getOpcode() == Instruction::Add ? A + B : A * B;
+      if (Bound.ugt(Limit)) reject("index arithmetic may wrap");
+      return Bound;
+    }
+    if (!isa<Argument>(V) && !isa<PHINode>(V))
+      reject("index depends on memory or an unsupported instruction");
+    if (!nonnegative(V, At))
+      reject("missing use-site signed nonnegativity proof");
+    return Limit;
+  }
+
+  void checkCast(CastInst &Cast, Instruction &At) {
+    if (!Cast.getSrcTy()->isIntegerTy() || !Cast.getDestTy()->isIntegerTy() ||
+        (!isa<SExtInst>(Cast) && !isa<ZExtInst>(Cast)) ||
+        (!Cast.getSrcTy()->isIntegerTy(8) && !Cast.getSrcTy()->isIntegerTy(32)) ||
+        (!Cast.getDestTy()->isIntegerTy(32) && !Cast.getDestTy()->isIntegerTy(64)) ||
+        Cast.getSrcTy()->getIntegerBitWidth() >=
+            Cast.getDestTy()->getIntegerBitWidth())
+      reject("FIR cannot preserve this cast");
+    if (isa<ZExtInst>(Cast) && !nonnegative(Cast.getOperand(0), At))
+      reject("zero extension lacks a use-site nonnegativity proof");
+  }
+
+  void closeOperand(Value *V, Instruction &Use, raw_ostream &OS,
+                    SmallPtrSetImpl<Instruction *> &Emitted) {
+    auto *I = dyn_cast<Instruction>(V);
+    if (!I || LI.getLoopFor(I->getParent())) return;
+    if (!DT.dominates(I, &Use)) reject("external definition does not dominate use");
+    // Validate at each use, even if the same definition was already emitted.
+    if (auto *Cast = dyn_cast<CastInst>(I)) {
+      checkCast(*Cast, Use);
+    } else if (auto *Op = dyn_cast<BinaryOperator>(I)) {
+      if (!Op->getType()->isIntegerTy() ||
+          (Op->getOpcode() != Instruction::Add &&
+           Op->getOpcode() != Instruction::Mul))
+        reject("external definition is not supported pure integer arithmetic");
+      (void)indexBound(Op, Use);
+    } else {
+      reject("external definition is not a supported pure cast/add/mul");
+    }
+    for (Value *Operand : I->operands()) closeOperand(Operand, Use, OS, Emitted);
+    if (Emitted.insert(I).second) OS << *I << "\n";
+  }
+
+public:
+  C99AddressFIR(LoopInfo &LI, ScalarEvolution &SE, DominatorTree &DT,
+                Function &F, bool Selected) : LI(LI), SE(SE), DT(DT), F(F) {
+    if (!Selected) return;
+    for (Argument &A : F.args())
+      if (A.getName().starts_with("reproduction.c99."))
+        reject("reserved diagnostic temporary name already exists");
+    for (BasicBlock &BB : F)
+      for (Instruction &I : BB) {
+        if (I.getName().starts_with("reproduction.c99."))
+          reject("reserved diagnostic temporary name already exists");
+        if (auto *G = dyn_cast<GetElementPtrInst>(&I))
+          Active |= isa<GetElementPtrInst>(G->getPointerOperand());
+      }
+    if (!Active) reject("selected function has no chained GEP");
+  }
+
+  // Only fallback typing for a function needing this repair. Existing tensor
+  // metadata remains the first choice in REV; unchanged flat references bypass it.
+  std::string memoryType(Value *Root) {
+    if (!Active) return "";
+    if (!Root || !isa<Argument>(Root) ||
+        !Root->getType()->isPointerTy() || Root->getType()->getPointerAddressSpace())
+      reject("memory root is not an address-space-zero argument");
+    SmallVector<Value *> Work{Root};
+    SmallPtrSet<Value *, 16> Seen;
+    bool Accessed = false;
+    while (!Work.empty()) {
+      Value *P = Work.pop_back_val();
+      if (!Seen.insert(P).second) continue;
+      for (User *U : P->users()) {
+        if (auto *G = dyn_cast<GetElementPtrInst>(U)) {
+          if (G->getPointerOperand() != P || G->getNumIndices() != 1 ||
+              !G->getSourceElementType()->isDoubleTy() || !G->isInBounds())
+            reject("memory root has an incompatible GEP");
+          Work.push_back(G);
+        } else if (auto *L = dyn_cast<LoadInst>(U)) {
+          if (L->getPointerOperand() != P || !L->getType()->isDoubleTy() ||
+              L->isVolatile() || L->isAtomic())
+            reject("memory root has an incompatible load");
+          Accessed = true;
+        } else if (auto *S = dyn_cast<StoreInst>(U)) {
+          if (S->getPointerOperand() != P ||
+              !S->getValueOperand()->getType()->isDoubleTy() ||
+              S->isVolatile() || S->isAtomic())
+            reject("memory root has an incompatible store");
+          Accessed = true;
+        } else {
+          reject("memory root escapes or has an unsupported use");
+        }
+      }
+    }
+    if (!Accessed) reject("memory root has no typed access");
+    return "ptr 1 double";
+  }
+
+  void prelude(Loop &L, raw_ostream &OS) {
+    if (!Active) return;
+    SmallPtrSet<Instruction *, 16> Emitted;
+    for (BasicBlock *BB : L.blocks()) {
+      if (LI.getLoopFor(BB) != &L) continue;
+      for (Instruction &I : *BB) {
+        if (isa<PHINode>(&I) || I.isTerminator()) continue;
+        for (Value *Operand : I.operands()) closeOperand(Operand, I, OS, Emitted);
+      }
+    }
+  }
+
+  // Return true only when the original serializer should skip this instruction.
+  bool emit(Instruction &I, raw_ostream &OS) {
+    if (!Active) return false;
+    if (auto *Cast = dyn_cast<CastInst>(&I)) {
+      checkCast(*Cast, I);
+      return false; // Preserve the actual cast in FIR/evidence.
+    }
+    auto *G = dyn_cast<GetElementPtrInst>(&I);
+    if (!G) return false;
+    if (F.getParent()->getDataLayout().getIndexSizeInBits(0) != 64)
+      reject("requires a 64-bit pointer index layout");
+    SmallVector<Value *> Indices;
+    Value *Base = G;
+    APInt Bound(128, 0);
+    while (auto *Part = dyn_cast<GetElementPtrInst>(Base)) {
+      if (!Part->isInBounds() || Part->getNumIndices() != 1 ||
+          !Part->getSourceElementType()->isDoubleTy() ||
+          Part->getPointerAddressSpace() != 0)
+        reject("only inbounds same-double scalar GEP chains are supported");
+      Value *Index = Part->getOperand(1);
+      if (!Index->getType()->isIntegerTy(64)) reject("GEP index is not i64");
+      Bound += indexBound(Index, I);
+      if (Bound.ugt(APInt::getSignedMaxValue(64).zext(128)))
+        reject("combined GEP offset may wrap");
+      Indices.push_back(Index);
+      Base = Part->getPointerOperand();
+    }
+    if (!isa<Argument>(Base) || Base->getType()->getPointerAddressSpace())
+      reject("GEP chain has no supported argument root");
+    // Read-only roots matter too: typing only the mutable root could miss an
+    // incompatible load through A/B while flattening its address.
+    (void)memoryType(Base);
+    if (Indices.size() == 1) return false;
+    // No LLVM instruction is inserted. New FIR sums are representable integers,
+    // justified above independently of the original nsw/nuw flags.
+    std::string Offset;
+    raw_string_ostream First(Offset);
+    Indices.back()->printAsOperand(First, false);
+    for (auto It = Indices.rbegin() + 1; It != Indices.rend(); ++It) {
+      std::string Name = "%reproduction.c99.offset." + std::to_string(NextOffset++);
+      OS << "  " << Name << " = add nsw i64 " << Offset << ", ";
+      (*It)->printAsOperand(OS, false);
+      OS << "\n";
+      Offset = Name;
+    }
+    OS << "  "; I.printAsOperand(OS, false);
+    OS << " = getelementptr inbounds double, ptr ";
+    Base->printAsOperand(OS, false);
+    OS << ", i64 " << Offset << "\n";
+    return true;
+  }
+};
diff --git a/scripts/paper_benchmarks/speq_c99_harness.cpp b/scripts/paper_benchmarks/speq_c99_harness.cpp
new file mode 100644
--- /dev/null
+++ b/scripts/paper_benchmarks/speq_c99_harness.cpp
@@ -0,0 +1,59 @@
+// Analysis-only host harness: verifies LLVM IR, never executes input functions.
+#include "llvm/ADT/APInt.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/Analysis/AssumptionCache.h"
+#include "llvm/Analysis/LoopInfo.h"
+#include "llvm/Analysis/ScalarEvolution.h"
+#include "llvm/Analysis/TargetLibraryInfo.h"
+#include "llvm/IR/Dominators.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/LLVMContext.h"
+#include "llvm/IR/Module.h"
+#include "llvm/IR/Verifier.h"
+#include "llvm/IRReader/IRReader.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/SourceMgr.h"
+#include "llvm/Support/raw_ostream.h"
+using namespace llvm;
+
+// INSERT_EXACT_C99_FRAGMENT
+
+int main(int argc, char **argv) {
+  if (argc != 3) return 2;
+  LLVMContext Context;
+  SMDiagnostic Error;
+  auto M = parseIRFile(argv[1], Error, Context);
+  if (!M) { Error.print(argv[0], errs()); return 2; }
+  if (verifyModule(*M, &errs())) return 2;
+  Function *F = M->getFunction(argv[2]);
+  if (!F || F->isDeclaration()) return 2;
+  std::string Before;
+  raw_string_ostream Saved(Before);
+  M->print(Saved, nullptr);
+  DominatorTree DT(*F);
+  LoopInfo LI(DT);
+  AssumptionCache AC(*F);
+  TargetLibraryInfoImpl TLII;
+  TargetLibraryInfo TLI(TLII);
+  ScalarEvolution SE(*F, TLI, AC, DT, LI);
+  C99AddressFIR Probe(LI, SE, DT, *F, true);
+  outs() << "memory-type: " << Probe.memoryType(F->getArg(0)) << "\n";
+  for (Loop *L : LI.getLoopsInPreorder()) {
+    outs() << "loop: " << L->getName() << "\n";
+    Probe.prelude(*L, outs());
+    for (BasicBlock *BB : L->blocks()) {
+      if (LI.getLoopFor(BB) != L) continue;
+      for (Instruction &I : *BB) {
+        if (isa<PHINode>(&I) || I.isTerminator()) continue;
+        if (!Probe.emit(I, outs())) outs() << I << "\n";
+      }
+    }
+  }
+  std::string After;
+  raw_string_ostream Current(After);
+  M->print(Current, nullptr);
+  if (Before != After) return 3;
+  outs() << "LLVM module unchanged\n";
+  return 0;
+}
