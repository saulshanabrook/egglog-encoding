;; Port of the worked SMT example in
;; benchmarks/disequality/euf-solver/README.md from Zenodo artifact 13938878.
;; Each branch of the original disjunction is inconsistent once x = y.
(datatype T
  (X)
  (Y))
(datatype S
  (F T T))

(disequal (F (X) (Y)) (F (Y) (X)))
(disequal (F (Y) (Y)) (F (X) (X)))
(union (X) (Y))
(fail (check-disequalities))
