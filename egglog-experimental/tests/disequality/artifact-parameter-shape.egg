;; Small illustrative adaptation of parameter-analysis/ee from Zenodo artifact
;; 13938878. It uses Num/Add/Mul in place of the artifact's N1..N5/f/g/h
;; vocabulary while retaining mixed equality and disequality constraints.
(datatype Expr
  (Num i64)
  (Add Expr Expr)
  (Mul Expr Expr))

(disequal (Num 1) (Num 2))
(disequal (Num 1) (Num 3))
(disequal (Num 2) (Num 3))
(disequal (Add (Num 1) (Num 2)) (Add (Num 2) (Num 1)))
(disequal (Mul (Num 1) (Num 3)) (Mul (Num 2) (Num 3)))

;; This equality also makes the two multiplication terms congruent.
(union (Num 1) (Num 2))
(fail (check-disequalities))
