(sort Expr)
(constructor Num (i64) Expr)
(constructor Add (Expr Expr) Expr)
(constructor Mul (Expr Expr) Expr)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityneExprSort)
(constructor ___disequality-ne-Expr (Expr Expr) ______disequalityneExprSort)
(rule ((___disequality-ne-Expr ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-nee-contradiction-Expr")
(___disequality-ne-Expr (Num 1) (Num 2))
(___disequality-ne-Expr (Num 1) (Num 3))
(___disequality-ne-Expr (Num 2) (Num 3))
(___disequality-ne-Expr (Add (Num 1) (Num 2)) (Add (Num 2) (Num 1)))
(___disequality-ne-Expr (Mul (Num 1) (Num 3)) (Mul (Num 2) (Num 3)))
(union (Num 1) (Num 2))
(fail (run-schedule (saturate (run ___disequality))))
