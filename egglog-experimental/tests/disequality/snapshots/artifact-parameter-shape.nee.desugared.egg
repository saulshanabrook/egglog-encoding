(sort Expr)
(constructor Num (i64) Expr)
(constructor Add (Expr Expr) Expr)
(constructor Mul (Expr Expr) Expr)
(sort __disequality-support)
(ruleset __disequality)
(constructor __disequality-ne-Expr (Expr Expr) Expr :unextractable :internal-hidden)
(rule ((__disequality-ne-Expr __disequality-x __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-nee-contradiction-Expr")
(__disequality-ne-Expr (Num 1) (Num 2))
(__disequality-ne-Expr (Num 1) (Num 3))
(__disequality-ne-Expr (Num 2) (Num 3))
(__disequality-ne-Expr (Add (Num 1) (Num 2)) (Add (Num 2) (Num 1)))
(__disequality-ne-Expr (Mul (Num 1) (Num 3)) (Mul (Num 2) (Num 3)))
(union (Num 1) (Num 2))
(fail (run-schedule (saturate (run __disequality))))
