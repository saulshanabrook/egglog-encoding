(sort Expr)
(constructor Num (i64) Expr)
(constructor Add (Expr Expr) Expr)
(constructor Mul (Expr Expr) Expr)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ___disequality-truth)
(constructor ___disequality-true () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-false () ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-true) (___disequality-false)))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-contradiction")
(constructor ___disequality-eq (___disequality-truth ___disequality-truth) ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-eq ___disequality-x ___disequality-y) (___disequality-true)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-ee-lift-___disequality-truth")
(rule ((= (___disequality-eq ___disequality-x ___disequality-y) (___disequality-false)))
      ((union (___disequality-eq ___disequality-y ___disequality-x) (___disequality-false)))
        :ruleset ___disequality :name "___disequality-ee-symmetry-___disequality-truth")
(rule ((= (___disequality-eq (___disequality-eq ___disequality-x ___disequality-y) (___disequality-false)) (___disequality-false)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-ee-double-negation-___disequality-truth")
(rule ((= (___disequality-eq ___disequality-x ___disequality-y) (___disequality-false)))
      ((union (___disequality-eq ___disequality-x ___disequality-x) (___disequality-true)))
        :ruleset ___disequality :name "___disequality-ee-reflexive-left-___disequality-truth")
(rule ((= (___disequality-eq ___disequality-x ___disequality-y) (___disequality-false)))
      ((union (___disequality-eq ___disequality-y ___disequality-y) (___disequality-true)))
        :ruleset ___disequality :name "___disequality-ee-reflexive-right-___disequality-truth")
(constructor ___disequality-eq-Expr (Expr Expr) ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-eq-Expr ___disequality-x ___disequality-y) (___disequality-true)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-ee-lift-Expr")
(rule ((= (___disequality-eq-Expr ___disequality-x ___disequality-y) (___disequality-false)))
      ((union (___disequality-eq-Expr ___disequality-y ___disequality-x) (___disequality-false)))
        :ruleset ___disequality :name "___disequality-ee-symmetry-Expr")
(rule ((= (___disequality-eq (___disequality-eq-Expr ___disequality-x ___disequality-y) (___disequality-false)) (___disequality-false)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-ee-double-negation-Expr")
(rule ((= (___disequality-eq-Expr ___disequality-x ___disequality-y) (___disequality-false)))
      ((union (___disequality-eq-Expr ___disequality-x ___disequality-x) (___disequality-true)))
        :ruleset ___disequality :name "___disequality-ee-reflexive-left-Expr")
(rule ((= (___disequality-eq-Expr ___disequality-x ___disequality-y) (___disequality-false)))
      ((union (___disequality-eq-Expr ___disequality-y ___disequality-y) (___disequality-true)))
        :ruleset ___disequality :name "___disequality-ee-reflexive-right-Expr")
(union (___disequality-eq-Expr (Num 1) (Num 2)) (___disequality-false))
(union (___disequality-eq-Expr (Num 1) (Num 3)) (___disequality-false))
(union (___disequality-eq-Expr (Num 2) (Num 3)) (___disequality-false))
(union (___disequality-eq-Expr (Add (Num 1) (Num 2)) (Add (Num 2) (Num 1))) (___disequality-false))
(union (___disequality-eq-Expr (Mul (Num 1) (Num 3)) (Mul (Num 2) (Num 3))) (___disequality-false))
(union (Num 1) (Num 2))
(fail (run-schedule (saturate (run ___disequality))))
