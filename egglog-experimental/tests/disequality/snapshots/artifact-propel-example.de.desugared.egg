(sort Term)
(constructor A () Term)
(constructor B () Term)
(constructor C () Term)
(constructor D () Term)
(constructor E () Term)
(constructor F () Term)
(constructor G () Term)
(constructor H () Term)
(constructor I () Term)
(constructor Fn (Term) Term)
(function $fa () Term :no-merge :unextractable :internal-let)
(set ($fa) (Fn (A)))
(function $fb () Term :no-merge :unextractable :internal-let)
(set ($fb) (Fn (B)))
(union (A) (B))
(union (C) (D))
(union (E) (F))
(union (C) (B))
(sort __disequality-support)
(ruleset __disequality)
(sort __disequality-neighbor-set-Term (Set Term))
(function __disequality-neighbors-Term (Term) __disequality-neighbor-set-Term :merge (set-union old new) :unextractable :internal-hidden)
(rule ((set-contains (__disequality-neighbors-Term __disequality-x) __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-de-contradiction-Term")
(begin
   (set (__disequality-neighbors-Term ($fa)) (set-of ($fb)))
   (set (__disequality-neighbors-Term ($fb)) (set-of ($fa)))
)
(fail (run-schedule (saturate (run __disequality))))
