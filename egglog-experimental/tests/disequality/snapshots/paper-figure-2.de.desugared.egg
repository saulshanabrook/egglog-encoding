(sort Term)
(constructor A () Term)
(constructor B () Term)
(constructor F (Term) Term)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityedgeTermSort)
(constructor ___disequality-edge-Term (Term Term) ______disequalityedgeTermSort)
(rule ((___disequality-edge-Term ___disequality-x ___disequality-y))
      ((___disequality-edge-Term ___disequality-y ___disequality-x))
        :ruleset ___disequality :name "___disequality-de-symmetry-Term")
(rule ((___disequality-edge-Term ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-de-contradiction-Term")
(___disequality-edge-Term (F (A)) (F (B)))
(union (A) (B))
(fail (run-schedule (saturate (run ___disequality))))
