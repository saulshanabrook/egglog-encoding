(sort Term)
(constructor A () Term)
(constructor B () Term)
(constructor F (Term) Term)
(sort __disequality-support)
(ruleset __disequality)
(sort __disequality-neighbor-set-Term (Set Term))
(function __disequality-neighbors-Term (Term) __disequality-neighbor-set-Term :merge (set-union old new) :unextractable :internal-hidden)
(rule ((set-contains (__disequality-neighbors-Term __disequality-x) __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-de-contradiction-Term")
(begin
   (set (__disequality-neighbors-Term (F (A))) (set-of (F (B))))
   (set (__disequality-neighbors-Term (F (B))) (set-of (F (A))))
)
(union (A) (B))
(fail (run-schedule (saturate (run __disequality))))
