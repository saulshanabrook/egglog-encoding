(sort Expr)
(constructor N1 () Expr)
(constructor N2 () Expr)
(constructor N3 () Expr)
(constructor N4 () Expr)
(constructor N5 () Expr)
(constructor f (Expr) Expr)
(constructor g (Expr Expr) Expr)
(constructor h (Expr Expr Expr) Expr)
(sort __ParameterNumeralSort)
(constructor ParameterNumeral (i64 i64) __ParameterNumeralSort)
(sort __ParameterFSort)
(constructor ParameterF (i64 i64) __ParameterFSort)
(sort __ParameterGSort)
(constructor ParameterG (i64 i64 i64) __ParameterGSort)
(sort __ParameterHSort)
(constructor ParameterH (i64 i64 i64 i64) __ParameterHSort)
(sort __ParameterPairSort)
(constructor ParameterPair (i64 i64 i64) __ParameterPairSort)
(sort __ParameterConfigSort)
(constructor ParameterConfig (i64) __ParameterConfigSort)
(sort __TermAtSort)
(constructor TermAt (i64 Expr) __TermAtSort)
(ruleset parameter-analysis-terms)
(ruleset parameter-analysis-pairs)
(rule ((ParameterNumeral id 1))
      ((TermAt id (N1)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterNumeral id 1))
      ((TermAt id (N1)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterNumeral id 2))
      ((TermAt id (N2)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterNumeral id 2))
      ((TermAt id (N2)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterNumeral id 3))
      ((TermAt id (N3)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterNumeral id 3))
      ((TermAt id (N3)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterNumeral id 4))
      ((TermAt id (N4)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterNumeral id 4))
      ((TermAt id (N4)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterNumeral id 5))
      ((TermAt id (N5)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterNumeral id 5))
      ((TermAt id (N5)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterF id child-id)
       (TermAt child-id child))
      ((TermAt id (f child)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterF id child-id)
       (TermAt child-id child))
      ((TermAt id (f child)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterG id left-id right-id)
       (TermAt left-id left)
       (TermAt right-id right))
      ((TermAt id (g left right)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterG id left-id right-id)
       (TermAt left-id left)
       (TermAt right-id right))
      ((TermAt id (g left right)))
        :ruleset parameter-analysis-terms )")
(rule ((ParameterH id first-id second-id third-id)
       (TermAt first-id first)
       (TermAt second-id second)
       (TermAt third-id third))
      ((TermAt id (h first second third)))
        :ruleset parameter-analysis-terms :name "(rule ((ParameterH id first-id second-id third-id)
       (TermAt first-id first)
       (TermAt second-id second)
       (TermAt third-id third))
      ((TermAt id (h first second third)))
        :ruleset parameter-analysis-terms )")
(sort __disequality-support)
(ruleset __disequality)
(constructor __disequality-ne-Expr (Expr Expr) Expr :unextractable :internal-hidden)
(rule ((__disequality-ne-Expr __disequality-x __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-nee-contradiction-Expr")
(rule ((ParameterPair pair-id left-id right-id)
       (ParameterConfig cutoff)
       (< pair-id cutoff)
       (TermAt left-id left)
       (TermAt right-id right))
      ((__disequality-ne-Expr left right))
        :ruleset parameter-analysis-pairs :name "(rule ((ParameterPair pair-id left-id right-id)
       (ParameterConfig cutoff)
       (< pair-id cutoff)
       (TermAt left-id left)
       (TermAt right-id right))
      ((__disequality-ne-Expr left right))
        :ruleset parameter-analysis-pairs )")
(rule ((ParameterPair pair-id left-id right-id)
       (ParameterConfig cutoff)
       (>= pair-id cutoff)
       (TermAt left-id left)
       (TermAt right-id right))
      ((union left right))
        :ruleset parameter-analysis-pairs :name "(rule ((ParameterPair pair-id left-id right-id)
       (ParameterConfig cutoff)
       (>= pair-id cutoff)
       (TermAt left-id left)
       (TermAt right-id right))
      ((union left right))
        :ruleset parameter-analysis-pairs )")
(input ParameterNumeral "numerals.tsv")
(input ParameterF "f.tsv")
(input ParameterG "g.tsv")
(input ParameterH "h.tsv")
(input ParameterPair "pairs.tsv")
(input ParameterConfig "config.tsv")
(__disequality-ne-Expr (N1) (N2))
(__disequality-ne-Expr (N1) (N3))
(__disequality-ne-Expr (N1) (N4))
(__disequality-ne-Expr (N2) (N3))
(__disequality-ne-Expr (N2) (N4))
(__disequality-ne-Expr (N3) (N4))
(run-schedule (saturate parameter-analysis-terms))
(run-schedule (saturate parameter-analysis-pairs))
(run-schedule (saturate (run __disequality)))
