(sort T)
(constructor X () T)
(constructor Y () T)
(sort S)
(constructor F (T T) S)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityneSSort)
(constructor ___disequality-ne-S (S S) ______disequalityneSSort)
(rule ((___disequality-ne-S ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-nee-contradiction-S")
(___disequality-ne-S (F (X) (Y)) (F (Y) (X)))
(___disequality-ne-S (F (Y) (Y)) (F (X) (X)))
(union (X) (Y))
(fail (run-schedule (saturate (run ___disequality))))
