(sort T)
(constructor X () T)
(constructor Y () T)
(sort S)
(constructor F (T T) S)
(sort __disequality-support)
(ruleset __disequality)
(constructor __disequality-ne-S (S S) S :unextractable :internal-hidden)
(rule ((__disequality-ne-S __disequality-x __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-nee-contradiction-S")
(__disequality-ne-S (F (X) (Y)) (F (Y) (X)))
(__disequality-ne-S (F (Y) (Y)) (F (X) (X)))
(union (X) (Y))
(fail (run-schedule (saturate (run __disequality))))
