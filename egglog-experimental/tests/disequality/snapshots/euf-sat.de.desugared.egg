(sort EufTerm)
(constructor Atom (String) EufTerm)
(constructor x () EufTerm)
(constructor y () EufTerm)
(constructor z () EufTerm)
(constructor HostWitness (i64) EufTerm)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityedgeEufTermSort)
(constructor ___disequality-edge-EufTerm (EufTerm EufTerm) ______disequalityedgeEufTermSort)
(rule ((___disequality-edge-EufTerm ___disequality-x ___disequality-y))
      ((___disequality-edge-EufTerm ___disequality-y ___disequality-x))
        :ruleset ___disequality :name "___disequality-de-symmetry-EufTerm")
(rule ((___disequality-edge-EufTerm ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-de-contradiction-EufTerm")
(begin
   (let term0 (x))
   (let term1 (y))
   (let term2 (z))
   (let term3 (Atom "true"))
   (let term4 (Atom "false"))
   (___disequality-edge-EufTerm term3 term4)
   (union term0 term1)
   (___disequality-edge-EufTerm term1 term2)
   (union term0 (HostWitness 0))
   (union term1 (HostWitness 1))
)
(check (= (HostWitness 0) (HostWitness 1)))
(run-schedule (saturate (run ___disequality)))
