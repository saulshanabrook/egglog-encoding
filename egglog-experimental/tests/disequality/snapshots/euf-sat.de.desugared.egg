(sort EufTerm)
(constructor Atom (String) EufTerm)
(constructor x () EufTerm)
(constructor y () EufTerm)
(constructor z () EufTerm)
(constructor HostWitness (i64) EufTerm)
(sort __disequality-support)
(ruleset __disequality)
(sort __disequality-neighbor-set-EufTerm (Set EufTerm))
(function __disequality-neighbors-EufTerm (EufTerm) __disequality-neighbor-set-EufTerm :merge (set-union old new) :unextractable :internal-hidden)
(rule ((set-contains (__disequality-neighbors-EufTerm __disequality-x) __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-de-contradiction-EufTerm")
(begin
   (let term0 (x))
   (let term1 (y))
   (let term2 (z))
   (let term3 (Atom "true"))
   (let term4 (Atom "false"))
   (set (__disequality-neighbors-EufTerm term3) (set-of term4))
   (set (__disequality-neighbors-EufTerm term4) (set-of term3))
   (union term0 term1)
   (set (__disequality-neighbors-EufTerm term1) (set-of term2))
   (set (__disequality-neighbors-EufTerm term2) (set-of term1))
   (union term0 (HostWitness 0))
   (union term1 (HostWitness 1))
)
(check (= (HostWitness 0) (HostWitness 1)))
(run-schedule (saturate (run __disequality)))
