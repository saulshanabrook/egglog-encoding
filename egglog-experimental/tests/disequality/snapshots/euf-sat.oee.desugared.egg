(sort EufTerm)
(constructor Atom (String) EufTerm)
(constructor x () EufTerm)
(constructor y () EufTerm)
(constructor z () EufTerm)
(function $term0 () EufTerm :no-merge :unextractable :internal-let)
(set ($term0) (x))
(function $term1 () EufTerm :no-merge :unextractable :internal-let)
(set ($term1) (y))
(function $term2 () EufTerm :no-merge :unextractable :internal-let)
(set ($term2) (z))
(function $term3 () EufTerm :no-merge :unextractable :internal-let)
(set ($term3) (Atom "true"))
(function $term4 () EufTerm :no-merge :unextractable :internal-let)
(set ($term4) (Atom "false"))
(sort ___disequality-support)
(ruleset ___disequality)
(sort ___disequality-truth)
(constructor ___disequality-true () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-false () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-eq (___disequality-truth ___disequality-truth) ___disequality-truth :unextractable :internal-hidden)
