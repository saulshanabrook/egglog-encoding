(union (___disequality-eq-EufTerm ($term3) ($term4)) (___disequality-false))
(union ($term0) ($term1))
(union (___disequality-eq-EufTerm ($term1) ($term2)) (___disequality-false))
(run-schedule (saturate (run ___disequality)))
