(sort Term)
(constructor A () Term)
(constructor B () Term)
(sort Other)
(constructor X () Other)
(constructor Y () Other)
(sort ___PairSort)
(constructor Pair (Term Term) ___PairSort)
(ruleset ___disequality)
(sort ______disequalitycontradictionSort)
(constructor ___disequality-contradiction () ______disequalitycontradictionSort)
(sort ______disequalityneTermSort)
(constructor ___disequality-ne-Term (Term Term) ______disequalityneTermSort)
(rule ((___disequality-ne-Term x x))
      ((___disequality-contradiction))
        :ruleset ___disequality :name "______disequality-ne-self-Term")
(rule ((___disequality-ne-Term x y))
      ((___disequality-ne-Term y x))
        :ruleset injectivity :name "______disequality-ne-symmetric-Term" :internal-include-subsumed)
(rule ((Pair a b))
      ((___disequality-ne-Term a b))
         :name "(rule ((Pair a b))
      ((___disequality-ne-Term a b))
         )")
(Pair (A) (B))
(sort ______disequalityneOtherSort)
(constructor ___disequality-ne-Other (Other Other) ______disequalityneOtherSort)
(rule ((___disequality-ne-Other x x))
      ((___disequality-contradiction))
        :ruleset ___disequality :name "______disequality-ne-self-Other")
(rule ((___disequality-ne-Other x y))
      ((___disequality-ne-Other y x))
        :ruleset injectivity :name "______disequality-ne-symmetric-Other" :internal-include-subsumed)
(___disequality-ne-Other (X) (Y))
(run-schedule (repeat 1 (run)))
(union (A) (B))
(run-schedule (saturate (run ___disequality)))
(check (___disequality-contradiction))
