(sort PropelTerm)
(constructor Atom (String) PropelTerm)
(constructor Apply (PropelTerm PropelTerm) PropelTerm)
(constructor Case (PropelTerm PropelTerm) PropelTerm)
(constructor Match2 (PropelTerm PropelTerm) PropelTerm)
(constructor Match3 (PropelTerm PropelTerm PropelTerm) PropelTerm)
(constructor Lambda (PropelTerm PropelTerm) PropelTerm)
(constructor S (PropelTerm) PropelTerm)
(constructor Escaped_Unit () PropelTerm)
(constructor Z () PropelTerm)
(constructor ≛ (PropelTerm) PropelTerm)
(constructor ≟ (PropelTerm PropelTerm) PropelTerm)
(constructor Top () PropelTerm)
(constructor Bot () PropelTerm)
(constructor HostWitness (i64) PropelTerm)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ___disequality-truth)
(constructor ___disequality-true () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-false () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-eq (___disequality-truth ___disequality-truth) ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-eq ___disequality-x ___disequality-y) (___disequality-true)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-lift-___disequality-truth")
(rule ((= (___disequality-eq (___disequality-eq ___disequality-x ___disequality-y) (___disequality-false)) (___disequality-false)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-double-negation-___disequality-truth")
(rule ((= (___disequality-eq ___disequality-x ___disequality-x) (___disequality-false)))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-oee-contradiction-___disequality-truth")
(constructor ___disequality-eq-PropelTerm (PropelTerm PropelTerm) ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-eq-PropelTerm ___disequality-x ___disequality-y) (___disequality-true)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-lift-PropelTerm")
(rule ((= (___disequality-eq (___disequality-eq-PropelTerm ___disequality-x ___disequality-y) (___disequality-false)) (___disequality-false)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-double-negation-PropelTerm")
(rule ((= (___disequality-eq-PropelTerm ___disequality-x ___disequality-x) (___disequality-false)))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-oee-contradiction-PropelTerm")
(begin
   (let term0 (Atom "x"))
   (let term1 (Atom "n"))
   (let term2 (Apply term0 term1))
   (let term3 (Bot))
   (union term2 term3)
   (let term4 (Top))
   (union (___disequality-eq-PropelTerm term4 term3) (___disequality-false))
   (union (___disequality-eq-PropelTerm term2 term4) (___disequality-false))
   (union term2 (HostWitness 0))
   (union term3 (HostWitness 1))
)
(check (= (HostWitness 0) (HostWitness 1)))
(run-schedule (saturate (run ___disequality)))
