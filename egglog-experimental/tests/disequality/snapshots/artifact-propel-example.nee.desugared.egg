(sort Term)
(constructor A () Term)
(constructor B () Term)
(constructor C () Term)
(constructor D () Term)
(constructor E () Term)
(constructor F () Term)
(constructor G () Term)
(constructor H () Term)
(constructor I () Term)
(constructor Fn (Term) Term)
(function $fa () Term :no-merge :unextractable :internal-let)
(set ($fa) (Fn (A)))
(function $fb () Term :no-merge :unextractable :internal-let)
(set ($fb) (Fn (B)))
(union (A) (B))
(union (C) (D))
(union (E) (F))
(union (C) (B))
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityneTermSort)
(constructor ___disequality-ne-Term (Term Term) ______disequalityneTermSort)
(rule ((___disequality-ne-Term ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-nee-contradiction-Term")
(___disequality-ne-Term ($fa) ($fb))
(fail (run-schedule (saturate (run ___disequality))))
