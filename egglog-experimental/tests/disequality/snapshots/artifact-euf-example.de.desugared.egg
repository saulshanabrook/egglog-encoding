(sort T)
(constructor X () T)
(constructor Y () T)
(sort S)
(constructor F (T T) S)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityedgeSSort)
(constructor ___disequality-edge-S (S S) ______disequalityedgeSSort)
(rule ((___disequality-edge-S ___disequality-x ___disequality-y))
      ((___disequality-edge-S ___disequality-y ___disequality-x))
        :ruleset ___disequality :name "___disequality-de-symmetry-S")
(rule ((___disequality-edge-S ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-de-contradiction-S")
(___disequality-edge-S (F (X) (Y)) (F (Y) (X)))
(___disequality-edge-S (F (Y) (Y)) (F (X) (X)))
(union (X) (Y))
(fail (run-schedule (saturate (run ___disequality))))
