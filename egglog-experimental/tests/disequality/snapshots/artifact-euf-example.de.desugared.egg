(sort T)
(constructor X () T)
(constructor Y () T)
(sort S)
(constructor F (T T) S)
(sort __disequality-support)
(ruleset __disequality)
(sort __disequality-neighbor-set-S (Set S))
(function __disequality-neighbors-S (S) __disequality-neighbor-set-S :merge (set-union old new) :unextractable :internal-hidden)
(rule ((set-contains (__disequality-neighbors-S __disequality-x) __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-de-contradiction-S")
(begin
   (set (__disequality-neighbors-S (F (X) (Y))) (set-of (F (Y) (X))))
   (set (__disequality-neighbors-S (F (Y) (X))) (set-of (F (X) (Y))))
)
(begin
   (set (__disequality-neighbors-S (F (Y) (Y))) (set-of (F (X) (X))))
   (set (__disequality-neighbors-S (F (X) (X))) (set-of (F (Y) (Y))))
)
(union (X) (Y))
(fail (run-schedule (saturate (run __disequality))))
