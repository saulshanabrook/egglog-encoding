(sort T)
(constructor X () T)
(constructor Y () T)
(sort S)
(constructor F (T T) S)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityedge53Sort)
(constructor ___disequality-edge-53 (S S) ______disequalityedge53Sort)
(rule ((___disequality-edge-53 ___disequality-x ___disequality-y))
      ((___disequality-edge-53 ___disequality-y ___disequality-x))
        :ruleset ___disequality :name "___disequality-de-symmetry-53")
(rule ((___disequality-edge-53 ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-de-contradiction-53")
(___disequality-edge-53 (F (X) (Y)) (F (Y) (X)))
(___disequality-edge-53 (F (Y) (Y)) (F (X) (X)))
(union (X) (Y))
(fail (run-schedule (saturate (run ___disequality))))
