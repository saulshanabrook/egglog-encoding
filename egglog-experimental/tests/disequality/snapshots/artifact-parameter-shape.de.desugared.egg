(sort Expr)
(constructor Num (i64) Expr)
(constructor Add (Expr Expr) Expr)
(constructor Mul (Expr Expr) Expr)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ______disequalityedgeExprSort)
(constructor ___disequality-edge-Expr (Expr Expr) ______disequalityedgeExprSort)
(rule ((___disequality-edge-Expr ___disequality-x ___disequality-y))
      ((___disequality-edge-Expr ___disequality-y ___disequality-x))
        :ruleset ___disequality :name "___disequality-de-symmetry-Expr")
(rule ((___disequality-edge-Expr ___disequality-x ___disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-de-contradiction-Expr")
(___disequality-edge-Expr (Num 1) (Num 2))
(___disequality-edge-Expr (Num 1) (Num 3))
(___disequality-edge-Expr (Num 2) (Num 3))
(___disequality-edge-Expr (Add (Num 1) (Num 2)) (Add (Num 2) (Num 1)))
(___disequality-edge-Expr (Mul (Num 1) (Num 3)) (Mul (Num 2) (Num 3)))
(union (Num 1) (Num 2))
(fail (run-schedule (saturate (run ___disequality))))
