(sort PropelTerm)
(constructor Atom (String) PropelTerm)
(constructor Apply (PropelTerm PropelTerm) PropelTerm)
(constructor Case (PropelTerm PropelTerm) PropelTerm)
(constructor Match2 (PropelTerm PropelTerm) PropelTerm)
(constructor Match3 (PropelTerm PropelTerm PropelTerm) PropelTerm)
(constructor Lambda (PropelTerm PropelTerm) PropelTerm)
(constructor S (PropelTerm) PropelTerm)
(constructor Escaped_Unit () PropelTerm)
(constructor Z () PropelTerm)
(constructor ≛ (PropelTerm) PropelTerm)
(constructor ≟ (PropelTerm PropelTerm) PropelTerm)
(constructor Top () PropelTerm)
(constructor Bot () PropelTerm)
(constructor HostWitness (i64) PropelTerm)
(sort __disequality-support)
(ruleset __disequality)
(sort __disequality-neighbor-set-PropelTerm (Set PropelTerm))
(function __disequality-neighbors-PropelTerm (PropelTerm) __disequality-neighbor-set-PropelTerm :merge (set-union old new) :unextractable :internal-hidden)
(rule ((set-contains (__disequality-neighbors-PropelTerm __disequality-x) __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-de-contradiction-PropelTerm")
(begin
   (let term0 (Atom "x"))
   (let term1 (Atom "n"))
   (let term2 (Apply term0 term1))
   (let term3 (Bot))
   (union term2 term3)
   (let term4 (Top))
   (set (__disequality-neighbors-PropelTerm term4) (set-of term3))
   (set (__disequality-neighbors-PropelTerm term3) (set-of term4))
   (set (__disequality-neighbors-PropelTerm term2) (set-of term4))
   (set (__disequality-neighbors-PropelTerm term4) (set-of term2))
   (union term2 (HostWitness 0))
   (union term3 (HostWitness 1))
)
(check (= (HostWitness 0) (HostWitness 1)))
(run-schedule (saturate (run __disequality)))
