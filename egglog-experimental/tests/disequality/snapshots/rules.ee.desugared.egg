(sort Term)
(constructor A () Term)
(constructor B () Term)
(sort Other)
(constructor X () Other)
(constructor Y () Other)
(sort ____PairSort)
(constructor Pair (Term Term) ____PairSort)
(ruleset ____disequality)
(sort ________disequalitycontradictionSort)
(constructor ____disequality-contradiction () ________disequalitycontradictionSort)
(sort ____disequality-truth)
(constructor ____disequality-true () ____disequality-truth :unextractable :internal-hidden)
(constructor ____disequality-false () ____disequality-truth :unextractable :internal-hidden)
(rule ((= (____disequality-true) (____disequality-false)))
      ((____disequality-contradiction))
        :ruleset ____disequality :name "________disequality-truth-conflict")
(constructor ____disequality-eq (____disequality-truth ____disequality-truth) ____disequality-truth :unextractable :internal-hidden)
(rule ((= (____disequality-eq x y) (____disequality-true)))
      ((union x y))
        :ruleset ____disequality :name "________disequality-ee-lift-____disequality-truth")
(rule ((= (____disequality-eq x y) (____disequality-false)))
      ((union (____disequality-eq y x) (____disequality-false)))
        :ruleset ____disequality :name "________disequality-ee-symmetry-____disequality-truth")
(rule ((= (____disequality-eq (____disequality-eq x y) (____disequality-false)) (____disequality-false)))
      ((union x y))
        :ruleset ____disequality :name "________disequality-ee-double-negation-____disequality-truth")
(rule ((= (____disequality-eq x y) (____disequality-false)))
      ((union (____disequality-eq x x) (____disequality-true)))
        :ruleset ____disequality :name "________disequality-ee-reflexive-left-____disequality-truth")
(rule ((= (____disequality-eq x y) (____disequality-false)))
      ((union (____disequality-eq y y) (____disequality-true)))
        :ruleset ____disequality :name "________disequality-ee-reflexive-right-____disequality-truth")
(constructor ____disequality-eq-Term (Term Term) ____disequality-truth :unextractable :internal-hidden)
(rule ((= (____disequality-eq-Term x y) (____disequality-true)))
      ((union x y))
        :ruleset ____disequality :name "________disequality-ee-lift-Term")
(rule ((= (____disequality-eq-Term x y) (____disequality-false)))
      ((union (____disequality-eq-Term y x) (____disequality-false)))
        :ruleset ____disequality :name "________disequality-ee-symmetry-Term")
(rule ((= (____disequality-eq (____disequality-eq-Term x y) (____disequality-false)) (____disequality-false)))
      ((union x y))
        :ruleset ____disequality :name "________disequality-ee-double-negation-Term")
(rule ((= (____disequality-eq-Term x y) (____disequality-false)))
      ((union (____disequality-eq-Term x x) (____disequality-true)))
        :ruleset ____disequality :name "________disequality-ee-reflexive-left-Term")
(rule ((= (____disequality-eq-Term x y) (____disequality-false)))
      ((union (____disequality-eq-Term y y) (____disequality-true)))
        :ruleset ____disequality :name "________disequality-ee-reflexive-right-Term")
(rule ((Pair a b))
      ((union (____disequality-eq-Term a b) (____disequality-false)))
         :name "(rule ((Pair a b))
      ((union (____disequality-eq-Term a b) (____disequality-false)))
         )")
(Pair (A) (B))
(constructor ____disequality-eq-Other (Other Other) ____disequality-truth :unextractable :internal-hidden)
(rule ((= (____disequality-eq-Other x y) (____disequality-true)))
      ((union x y))
        :ruleset ____disequality :name "________disequality-ee-lift-Other")
(rule ((= (____disequality-eq-Other x y) (____disequality-false)))
      ((union (____disequality-eq-Other y x) (____disequality-false)))
        :ruleset ____disequality :name "________disequality-ee-symmetry-Other")
(rule ((= (____disequality-eq (____disequality-eq-Other x y) (____disequality-false)) (____disequality-false)))
      ((union x y))
        :ruleset ____disequality :name "________disequality-ee-double-negation-Other")
(rule ((= (____disequality-eq-Other x y) (____disequality-false)))
      ((union (____disequality-eq-Other x x) (____disequality-true)))
        :ruleset ____disequality :name "________disequality-ee-reflexive-left-Other")
(rule ((= (____disequality-eq-Other x y) (____disequality-false)))
      ((union (____disequality-eq-Other y y) (____disequality-true)))
        :ruleset ____disequality :name "________disequality-ee-reflexive-right-Other")
(union (____disequality-eq-Other (X) (Y)) (____disequality-false))
(run-schedule (repeat 1 (run)))
(union (A) (B))
(run-schedule (saturate (run ____disequality)))
(check (____disequality-contradiction))
