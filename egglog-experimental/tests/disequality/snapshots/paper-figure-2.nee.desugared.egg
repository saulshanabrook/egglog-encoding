(sort Term)
(constructor A () Term)
(constructor B () Term)
(constructor F (Term) Term)
(sort __disequality-support)
(ruleset __disequality)
(constructor __disequality-ne-Term (Term Term) Term :unextractable :internal-hidden)
(rule ((__disequality-ne-Term __disequality-x __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-nee-contradiction-Term")
(__disequality-ne-Term (F (A)) (F (B)))
(union (A) (B))
(fail (run-schedule (saturate (run __disequality))))
