(sort EufTerm)
(constructor Atom (String) EufTerm)
(constructor x () EufTerm)
(constructor y () EufTerm)
(constructor z () EufTerm)
(constructor HostWitness (i64) EufTerm)
(sort __disequality-support)
(ruleset __disequality)
(constructor __disequality-ne-EufTerm (EufTerm EufTerm) EufTerm :unextractable :internal-hidden)
(rule ((__disequality-ne-EufTerm __disequality-x __disequality-x))
      ((panic "disequality constraint contradicted"))
        :ruleset __disequality :name "__disequality-nee-contradiction-EufTerm")
(begin
   (let term0 (x))
   (let term1 (y))
   (let term2 (z))
   (let term3 (Atom "true"))
   (let term4 (Atom "false"))
   (__disequality-ne-EufTerm term3 term4)
   (union term0 term1)
   (__disequality-ne-EufTerm term1 term2)
   (union term0 (HostWitness 0))
   (union term1 (HostWitness 1))
)
(check (= (HostWitness 0) (HostWitness 1)))
(run-schedule (saturate (run __disequality)))
