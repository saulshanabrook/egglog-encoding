(sort T)
(constructor X () T)
(constructor Y () T)
(sort S)
(constructor F (T T) S)
(sort ___disequality-support)
(ruleset ___disequality)
(sort ___disequality-truth)
(constructor ___disequality-true () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-false () ___disequality-truth :unextractable :internal-hidden)
(constructor ___disequality-eq (___disequality-truth ___disequality-truth) ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-eq ___disequality-x ___disequality-y) (___disequality-true)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-lift-___disequality-truth")
(rule ((= (___disequality-eq (___disequality-eq ___disequality-x ___disequality-y) (___disequality-false)) (___disequality-false)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-double-negation-___disequality-truth")
(rule ((= (___disequality-eq ___disequality-x ___disequality-x) (___disequality-false)))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-oee-contradiction-___disequality-truth")
(constructor ___disequality-eq-S (S S) ___disequality-truth :unextractable :internal-hidden)
(rule ((= (___disequality-eq-S ___disequality-x ___disequality-y) (___disequality-true)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-lift-S")
(rule ((= (___disequality-eq (___disequality-eq-S ___disequality-x ___disequality-y) (___disequality-false)) (___disequality-false)))
      ((union ___disequality-x ___disequality-y))
        :ruleset ___disequality :name "___disequality-oee-double-negation-S")
(rule ((= (___disequality-eq-S ___disequality-x ___disequality-x) (___disequality-false)))
      ((panic "disequality constraint contradicted"))
        :ruleset ___disequality :name "___disequality-oee-contradiction-S")
(union (___disequality-eq-S (F (X) (Y)) (F (Y) (X))) (___disequality-false))
(union (___disequality-eq-S (F (Y) (Y)) (F (X) (X))) (___disequality-false))
(union (X) (Y))
(fail (run-schedule (saturate (run ___disequality))))
