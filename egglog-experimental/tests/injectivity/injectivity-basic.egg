; Injectivity is opt-in and runs only when its shared ruleset is scheduled.
(datatype Term (Leaf String))
(constructor Pair (Term i64 Term) Term :cost 2 :injective)
(let a (Leaf "a"))
(let b (Leaf "b"))
(let c (Leaf "c"))
(let d (Leaf "d"))
(let left (Pair a 7 c))
(let right (Pair b 7 d))
(run-schedule (saturate injectivity))
(fail (check (= a b)))
(union left right)
(fail (check (= a b)))
(run-schedule (saturate injectivity))
(check (= a b) (= c d))
