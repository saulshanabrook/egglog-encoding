; Repeated roots must not share atom identities with a variable named p2.
(include "egglog-experimental/tests/slotted/languages/toy.egg")
(let seed (F (V $0) (V $0)))
(let result (Null))
(rewrite (Null) (G (V $x) (V $y))
 :when ((= p (F (V $x) (V $x))) (= p (F (V $x) (V $x))) (= p2 (F (V $y) (V $y)))))
(run 1)
(let slot_0 $0)
(let slot_1 $1)
(check (= result (G (V slot_0) (V slot_1))))
