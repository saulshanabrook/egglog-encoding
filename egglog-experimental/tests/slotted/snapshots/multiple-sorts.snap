;;; carrier Ty: RenamesToLeader_1, EclassGroup_1, Equated_1, FreeVars_1
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(sort Ty)
(constructor SlottedVar_1 (i64) Ty)
(relation RenamesToLeader_1 (Ty Renaming Ty))
(relation Equated_1 (Ty Renaming Ty))
(function FreeVars_1 (Ty) Renaming :merge (map-intersect old new))
(relation SubstPending_1 (Ty Renaming Renaming Ty))
(function ShapeEqual_1 (Ty Renaming Ty) Unit :no-merge)
(function Invocation_1 (Ty Renaming) Ty :merge ((union old new) old))
(function EclassGroup_1 (Ty) Group :merge (set-union old new))
(function GroupReplace_1 (Ty) Group :merge new)
(function CosetReps_1 (Ty Renaming) Renamings :merge new)
(relation BigReading_1 (Ty Renaming))
(relation Reading_1 (Ty Renaming Renaming))

(set (SlottedNodeLayout "SlottedVar_1" 1) ())
(set (FreeVars_1 (SlottedVar_1 0)) (map-of 0 0))

(rule ((Equated_1 _a _m _b)
       (!= _a _b)
       (= _a (ordering-max _a _b))
       (= _csa (FreeVars_1 _a))
       (= _csb (FreeVars_1 _b)))
      ((RenamesToLeader_1 _a (compose _csa (compose _m _csb)) _b)) :ruleset slotted :name "slotted/orient-max/1")

(rule ((Equated_1 _a _m _b)
       (!= _a _b)
       (= _b (ordering-max _a _b))
       (= _csa (FreeVars_1 _a))
       (= _csb (FreeVars_1 _b)))
      ((RenamesToLeader_1 _b (compose _csb (compose (inverse _m) _csa)) _a)) :ruleset slotted :name "slotted/orient-min/1")

(rule ((Equated_1 _a _m _a)
       (= _cs (FreeVars_1 _a)))
      ((set (EclassGroup_1 _a) (set-of (compose _cs (compose _m _cs))))) :ruleset slotted :name "slotted/self-symmetry/1")

(rule ((= _cs (FreeVars_1 _c)))
      ((RenamesToLeader_1 _c _cs _c)
       (set (EclassGroup_1 _c) (set-of _cs))) :ruleset slotted :name "slotted/seed-identity/1")

(rule ((RenamesToLeader_1 _c _m _c)
       (= _cs (FreeVars_1 _c))
       (!= _m _cs))
      ((set (EclassGroup_1 _c) (set-of (compose _cs (compose _m _cs))))
       (delete (RenamesToLeader_1 _c _m _c))) :ruleset slotted :name "slotted/self-edge-symmetry/1")

(rule ((RenamesToLeader_1 _f _m _l)
