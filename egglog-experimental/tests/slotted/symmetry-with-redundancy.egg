;; Restricting a group's redundant slot must preserve its remaining symmetry.
(datatype U (V Var) (F U U U))
(let a (F (V $0) (V $1) (V $2)))
(union a (F (V $1) (V $0) (V $2)))
(union a (F (V $0) (V $1) (V $3)))
(run 2)
(let slot_1 $1)
(let slot_0 $0)
(let slot_2 $2)
(check (= a (F (V slot_1) (V slot_0) (V slot_2))))
(let slot_7 $7)
(check (= a (F (V slot_1) (V slot_0) (V slot_7))))
(let slot_9 $9)
(check (= a (F (V slot_0) (V slot_1) (V slot_9))))
(check (!= a (F (V slot_1) (V slot_2) (V slot_0))))
