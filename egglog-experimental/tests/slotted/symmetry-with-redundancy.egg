;; Restricting a group's redundant slot must preserve its remaining symmetry.
(datatype U (F U U U))
(let a (F $0 $1 $2))
(union a (F $1 $0 $2))
(union a (F $0 $1 $3))
(run 2)
(let slot_1 $1)
(let slot_0 $0)
(let slot_2 $2)
(check (= a (F slot_1 slot_0 slot_2)))
(let slot_7 $7)
(check (= a (F slot_1 slot_0 slot_7)))
(let slot_9 $9)
(check (= a (F slot_0 slot_1 slot_9)))
(check (!= a (F slot_1 slot_2 slot_0)))
