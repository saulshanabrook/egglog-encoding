;;; An explicit variable term on either side of a union retains its occurrence's
;;; coordinate: `(V $3)` denotes the variable at slot 3.
;;;
;;; `(union (Let (V $1) $2 (V $3)) (V $3))` makes slot 1 redundant in the
;;; let's class. Losing the variable occurrence's renaming would instead identify
;;; disjoint coordinates and make every slot redundant. The binder remains a
;;; rigid Var name throughout.
(sort U)
(constructor V (Var) U)
(constructor Let (U Var U) U :binder 1)
(constructor Get (U U) U)

(let t (Get (Let (V $1) $2 (V $3)) (V $4)))
(union (Let (V $1) $2 (V $3)) (V $3))
(run 1)

;; the let is variable 3, whatever sits in slot 1
(let slot_1 $1)
(let slot_3 $3)
(check (= (Let (V slot_1) $2 (V slot_3)) (V slot_3)) (not-free $2 (V slot_1) (V slot_3)))
(let slot_5 $5)
(check (= (Let (V slot_5) $2 (V slot_3)) (V slot_3)) (not-free $2 (V slot_5) (V slot_3)))
(let slot_4 $4)
(check (= t (Get (V slot_3) (V slot_4))))
;; and variables stay distinct
(fail (check (= (V slot_3) (V slot_4))))
(fail (check (= (Get (V slot_3) (V slot_4)) (Get (V slot_4) (V slot_3)))))
