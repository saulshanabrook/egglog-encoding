;;; Table 1's slotted row: 5 iterations, 30 nodes, 15 classes, saturated.

(include "egglog-experimental/tests/slotted/languages/sdql-rules.egg")
(let paper-input
  (Lambda $1000
    (Lambda $1001
      (Sum
        (V $1000)
        $1002
        $1003
        (Sum
          (V $1003)
          $1004
          $1005
          (Sum (Get (V $1001) (V $1002)) $1006 $1007 (Mult (V $1005) (V $1007))))))))
;;; Saturate the input alone, for as many iterations as the artifact allowed it.
(run 30)
;;; The target arrives only now; `(run 0)` installs it without running SDQL rules.
(let paper-target
  (Lambda $1
    (Lambda $2
      (Sum (V $1) $3 $4 (Mult (Sum (V $4) $5 $6 (V $6)) (Sum (Get (V $2) (V $3)) $5 $6 (V $6)))))))
(run 0)
(check (= paper-input paper-target))
