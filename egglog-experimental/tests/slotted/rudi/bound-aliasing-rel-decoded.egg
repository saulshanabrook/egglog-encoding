(sort U)
(constructor V (Var) U)

(constructor Lam (U U) U)
(constructor App (U U) U)
(constructor Truth () U)
(constructor GG (U U) U)

(let t (Truth))

(let l0 (Lam (V $0) (V $0)))
(let l1 (Lam (V $1) (V $1)))
(union l0 l1)

(let g (App (Lam (V $0) (V $0)) (V $0)))

(rewrite
    (Truth)
    (GG a (V $0))
    :when ((App (Lam a a) (V $0)))
)

(run 10)

(let slot_0 $0)
(check (= t (GG (V slot_0) (V slot_0))))
(let slot_1 $1)
(check (= t (GG (V slot_0) (V slot_1))))
