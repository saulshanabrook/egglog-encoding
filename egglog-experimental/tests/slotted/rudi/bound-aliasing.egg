(sort U)
(constructor V (Var) U)

(constructor Lam (U U) U)
(constructor App (U U) U)
(constructor GG (U) U)

(let l0 (Lam (V $0) (V $0)))
(let l1 (Lam (V $1) (V $1)))
(union l0 l1)

(let g (App (Lam (V $0) (V $0)) (V $0)))

(rewrite
    (App (Lam a a) (V $0))
    (GG a)
)

(run 10)

(let slot_0 $0)
(check (= g (GG (V slot_0))))
