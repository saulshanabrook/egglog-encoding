; This file emulates the use of rules / relations.

(sort U)
(constructor Thingy (U U U) U)

(constructor RelA (U) U)
(constructor RelB (U U) U)
(constructor Truth () U)

(let truth (Truth))

(union truth (RelA (Thingy $0 $1 $2)))

(rewrite
    (Truth)
    (RelB x y)
    :when ((= Truth (RelA x))
           (= Truth (RelA y)))
)

(run 10)

(let slot_0 $0)
(let slot_1 $1)
(let slot_2 $2)
(let slot_3 $3)
(let slot_4 $4)
(let slot_5 $5)
(check (= (Truth) (RelB (Thingy slot_0 slot_1 slot_2) (Thingy slot_3 slot_4 slot_5))))

(check (= (Truth) (RelB (Thingy slot_0 slot_1 slot_2) (Thingy slot_0 slot_4 slot_5))))
(check (= (Truth) (RelB (Thingy slot_0 slot_1 slot_2) (Thingy slot_3 slot_0 slot_5))))
(check (= (Truth) (RelB (Thingy slot_0 slot_1 slot_2) (Thingy slot_3 slot_4 slot_0))))

(check (= (Truth) (RelB (Thingy slot_0 slot_1 slot_2) (Thingy slot_2 slot_1 slot_0))))

(check (free-names-are (Thingy slot_0 slot_1 slot_2) slot_0 slot_1 slot_2))
