;;; The paper artifact's BATAX second-pass input and published baseline extraction.
;;;
;;; Provenance (artifact commit 83f2e5bee2b3aa45bf97ef1e3a8abe953790c735):
;;;   input:  sdql/slotted/progs/batax_2nd.sexp
;;;   target: sdql/baseline/progs/batax_2nd_esat.sexp
;;;
;;; The artifact runs the fine-grained `sdql_rules()` with a 12-iteration limit for
;;; this workload. Its surface order is `(sum $k $v range body)` and
;;; `(let $x value body)`; this language declares the same nodes as
;;; `(Sum range $k $v body)` and `(Let value $x body)`. Numeric slot names below are
;;; the alpha-renaming `$var_01` ... `$var_12` to `$1` ... `$12`.

;;; This is a goal/reachability regression, not a reproduction of Table 1's search-space
;;; metrics: BATAX under all 44 rules does not saturate and is too costly for the ordinary
;;; test suite, so this uses the goal-directed subset of the artifact's fine-grained rules
;;; needed by this witness. The workloads the suite can afford run under all 44 rules in
;;; `egglog-experimental/tests/slotted/sdql-paper/`; `slotted/eval.py` runs every workload, BATAX included, with all of them.
;;; `slotted/checks/check-paper-sdql.py` keeps these definitions semantically identical to the
;;; corresponding rules in `languages/sdql.egg` and checks both fixture transcriptions.
(sort U)
(constructor V (Var) U)

(constructor Lambda (Var U) U :binder 0)
(constructor Sing (U U) U)
(constructor Add (U U) U)
(constructor Mult (U U) U)
(constructor Sub (U U) U)
(constructor Equality (U U) U)
(constructor Get (U U) U)
(constructor Range (U U) U)
(constructor IfThen (U U) U)
(constructor SubArray (U U U) U)
(constructor Unique (U) U)
(constructor Sum (U Var Var U) U :binder 1 2)
(constructor Let (U Var U) U :binder 1)
(constructor Num (i64) U)

(rewrite (Let t $x body) (subst body $x t) :name "beta")
(rewrite (Sub e e) (Num 0) :name "sub-identity")
(rewrite (Add e (Num 0)) e :name "add-zero")
(rewrite (Sub e (Num 0)) e :name "sub-zero")
(rewrite (Equality a b) (Equality b a) :name "eq-comm")
(rewrite (Sum (Sum R $k2 $v2 (Sing (V $k2) body1)) $k1 $v1 body2)
         (Sum R $k2 $v2 (Let (V $k2) $k1 (Let body1 $v1 body2)))
         :name "sum-sum-vert-fuse-1"
    :when ((not-free $k1 body1) (not-free $k2 body2) (not-free $v2 body2)))
(rewrite (Sum (Sum R $k2 $v2 (Sing (Unique key) body1)) $k1 $v1 body2)
         (Sum R $k2 $v2 (Let (Unique key) $k1 (Let body1 $v1 body2)))
         :name "sum-sum-vert-fuse-2"
    :when ((not-free $k1 body1) (not-free $k2 body2) (not-free $v2 body2)))
(rewrite (Sum (Range st en) $k $v (IfThen (Equality (V $v) key) body))
         (Sum (Range st en) $k $v
           (IfThen (Equality (V $k) (Sub key (Sub st (Num 1)))) body))
         :name "sum-range-1"
    :when ((not-free $k st) (not-free $v st)))
(rewrite (Get dict key)
         (Sum dict $k $v (IfThen (Equality (V $k) key) (V $v)))
         :name "get-to-sum")
(rewrite (Sum dict $k $v (IfThen (Equality (V $k) key) body))
         (Let key $k (Let (Get dict (V $k)) $v body))
         :name "sum-to-get"
         :when ((not-free $k dict) (not-free $k key) (not-free $v key)))
(rewrite (Get (Range st en) idx)
         (Add idx (Sub st (Num 1)))
         :name "get-range")
(rewrite (Unique e) e :name "unique-rm")

(let paper-input
  (Lambda $1
    (Lambda $2
      (Lambda $3
        (Lambda $4
          (Lambda $5
            (Lambda $6
              (Mult (V $1)
                (Sum
                  (Sum (V $2) $7 $8
                    (Let
                      (Get (V $2) (Add (V $7) (Num 1)))
                      $9
                      (Sing (V $7)
                        (Sum
                          (SubArray (V $3) (V $8) (Sub (V $9) (Num 1)))
                          $10 $11
                          (Sing (Unique (V $11)) (Get (V $4) (V $10)))))))
                  $7 $8
                  (Mult (V $8)
                    (Sum (V $8) $9 $10
                      (Mult (V $10)
                        (Get
                          (Sum (Range (Num 1) (V $6)) $11 $12
                            (Sing (Unique (V $12)) (Get (V $5) (V $12))))
                          (V $9))))))))))))))

;;; Saturate the input alone: declaring the target before this point would seed the
;;; graph with the answer and test joinability rather than the artifact's reachability.
(run 12)

;;; The target is introduced only after the bounded user-rule phase. `(run 0)` below
;;; installs/canonicalizes its nodes with machinery rules, without running SDQL rules
;;; on the target.
(let paper-target
  (Lambda $1
    (Lambda $2
      (Lambda $3
        (Lambda $4
          (Lambda $5
            (Lambda $6
              (Mult (V $1)
                (Sum (V $2) $7 $8
                  (Mult
                    (Sum
                      (SubArray (V $3) (V $8)
                        (Sub (Get (V $2) (Add (V $7) (Num 1))) (Num 1)))
                      $9 $10
                      (Sing (V $10) (Get (V $4) (V $9))))
                    (Sum
                      (SubArray (V $3) (V $8)
                        (Sub (Get (V $2) (Add (V $7) (Num 1))) (Num 1)))
                      $9 $10
                      (Mult (Get (V $4) (V $9)) (Get (V $5) (V $10))))))))))))))

(run 0)
(check (= paper-input paper-target))
