; Source-level cancellation, upward propagation, closure, and scoped declarations.
(datatype Expr (V Var) (A) (B) (C) (D) (Pair Expr Expr) (Wrap Expr) (Plain Expr Expr))
(separately-injective Pair)
(separately-injective Wrap)
(let left (Pair (A) (C)))
(let right (Pair (B) (C)))
(fail (check (known-disequal left right)))
(disequal (A) (B))
(check (known-disequal left right))
(check (known-disequal right left))
(let outer-left (Wrap left))
(let outer-right (Wrap right))
(check (known-disequal outer-left outer-right))

; Two varying coordinates do not imply cancellation or upward propagation.
(let both-left (Pair (A) (A)))
(let both-right (Pair (B) (B)))
(fail (check (known-disequal both-left both-right)))
(push)
(union both-left both-right)
(fail (check (= (A) (B))))
(pop)
(let plain-left (Plain (A) (C)))
(let plain-right (Plain (B) (C)))
(fail (check (known-disequal plain-left plain-right)))

; Output disequality alone does not imply input disequality.
(disequal (Wrap (C)) (Wrap (D)))
(fail (check (known-disequal (C) (D))))
(push)
(union (Wrap (C)) (Wrap (D)))
(check (= (C) (D)))
(check (contradiction))
(pop)
(fail (check (= (C) (D))))
(fail (check (contradiction)))

; The private closure must not consume a user rewrite iteration.
(rewrite (C) (D))
(run 0)
(fail (check (= (C) (D))))
(run 1)
(check (= (C) (D)))
(check (contradiction))
