;;; A nested reading maps node slots into the parent's frame. The shared $0
;;; pins an image of that permutation. Grouping by its input loses this match.
(include "egglog-experimental/tests/slotted/languages/sdql.egg")
(union (Binop (V $0) (V $1) (V $2)) (Binop (V $1) (V $0) (V $2)))
(union (Binop (V $0) (V $1) (V $2)) (Binop (V $1) (V $2) (V $0)))
(let start (App (V $0) (Binop (V $0) (V $1) (V $2))))
(rewrite (App (V $a) (Binop (V $b) (V $c) (V $a))) (Null))
(run 1)
(check (= start (Null)))
