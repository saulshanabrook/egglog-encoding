;;; Free-name predicates have the same meaning in checks and rewrite guards.
(datatype Expr (Pair Expr Expr) (Lam Expr Expr :binder 0) (Null) (Hit))
(let open (Lam $bound $a))
(let closed (Lam $bound $bound))
(let pair (Pair $a $b))
(run 0)
(let slot_a $a)
(check (free slot_a open closed))
(let slot_b $b)
(check (not-free slot_b open closed))
(check (free-names-are open slot_a))
(check (free-names-are closed))
(check (free-names-are pair slot_a slot_b))
(fail (check (free slot_b open closed)))
(fail (check (not-free slot_a open closed)))
(fail (check (free-names-are pair slot_a)))
(fail (check (free-names-are open slot_b)))

(push)
(let yes (Pair $a open))
(let no (Pair $b open))
(rewrite (Pair $x body) (Hit) :when ((free $x body)))
(run 1)
(check (__internal-holds yes Hit))
(check (__internal-not-holds no Hit))
(pop)

(push)
(let no (Pair $a open))
(let yes (Pair $b open))
(rewrite (Pair $x body) (Hit) :when ((not-free $x body)))
(run 1)
(check (__internal-holds yes Hit))
(check (__internal-not-holds no Hit))
(pop)

(push)
(let yes (Pair $a open))
(let no (Pair $b open))
(let extra (Pair $a pair))
(rewrite (Pair $x body) (Hit) :when ((free-names-are body $x)))
(run 1)
(check (__internal-holds yes Hit))
(check (__internal-not-holds no Hit))
(check (__internal-not-holds extra Hit))
(pop)

(push)
(rewrite (Lam $x body) (Hit) :when ((free-names-are (Lam $x body))))
(run 1)
(check (__internal-holds closed Hit))
(check (__internal-not-holds open Hit))
(pop)

;;; Redundant names disappear, including through the term's renaming.
(union (Pair $a $b) (Pair $a $c))
(run 0)
(check (free-names-are pair slot_a))
(check (not-free slot_b pair))
(check (free slot_a pair))
(fail (check (free-names-are pair slot_a slot_b)))
