(datatype U (V Var) (Pair U U) (F U) (G U) (K U U) (Lam Var U :binder 0))

(push)
(union (F (V $a)) (G (V $a)))
(let input (Pair (F (V $a)) (G (V $b))))
(rewrite (Pair x y) (K x y) :when ((renaming-= x y)) :name "same-class")
(run 1)
(check (= input (K (F (V $a)) (G (V $b)))))
(pop)

(push)
(union (F (V $a)) (G (V $a)))
(let input (Pair (V $a) (V $b)))
(let side (G (V $b)))
(rewrite (Pair (V $x) (V $y)) (K (V $x) (V $y))
  :when ((renaming-= (F (V $x)) (G (V $y)))) :name "nested-guard")
(run 1)
(check (= input (K (V $a) (V $b))))
(pop)

(push)
(let input (Pair (Lam $a (F (V $a))) (Lam $b (F (V $b)))))
(rewrite (Pair x y) (K x y) :when ((renaming-= x y)) :name "bound-names")
(run 1)
(check (= input (K (Lam $a (F (V $a))) (Lam $b (F (V $b))))))
(pop)

(push)
(let input (Pair (F (V $a)) (G (V $b))))
(let same (Pair (F (V $a)) (F (V $b))))
(rewrite (Pair x y) (K x y) :when ((renaming-!= x y)) :name "different-classes")
(run 1)
(check (= input (K (F (V $a)) (G (V $b)))))
(fail (check (= same (K (F (V $a)) (F (V $b))))))
(pop)

(push)
(let input (Pair (F (V $a)) (F (V $b))))
(rewrite (Pair x y) (K x y) :when ((!= x y)) :name "different-invocations")
(run 1)
(union (F (V $a)) (F (V $b)))
(run 0)
(check (= input (K (F (V $a)) (F (V $b)))))
(pop)
