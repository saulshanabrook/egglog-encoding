(datatype U (Pair U U) (F U) (G U) (K U U) (Lam U U :binder 0))

(push)
(union (F $a) (G $a))
(let input (Pair (F $a) (G $b)))
(rewrite (Pair x y) (K x y) :when ((renaming-= x y)) :name "same-class")
(run 1)
(check (= input (K (F $a) (G $b))))
(pop)

(push)
(union (F $a) (G $a))
(let input (Pair $a $b))
(let side (G $b))
(rewrite (Pair $x $y) (K $x $y)
  :when ((renaming-= (F $x) (G $y))) :name "nested-guard")
(run 1)
(check (= input (K $a $b)))
(pop)

(push)
(let input (Pair (Lam $a (F $a)) (Lam $b (F $b))))
(rewrite (Pair x y) (K x y) :when ((renaming-= x y)) :name "bound-names")
(run 1)
(check (= input (K (Lam $a (F $a)) (Lam $b (F $b)))))
(pop)

(push)
(let input (Pair (F $a) (G $b)))
(let same (Pair (F $a) (F $b)))
(rewrite (Pair x y) (K x y) :when ((renaming-!= x y)) :name "different-classes")
(run 1)
(check (= input (K (F $a) (G $b))))
(fail (check (= same (K (F $a) (F $b)))))
(pop)

(push)
(let input (Pair (F $a) (F $b)))
(rewrite (Pair x y) (K x y) :when ((!= x y)) :name "different-invocations")
(run 1)
(union (F $a) (F $b))
(run 0)
(check (= input (K (F $a) (F $b))))
(pop)
