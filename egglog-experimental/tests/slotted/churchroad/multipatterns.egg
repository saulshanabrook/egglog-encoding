; Multi-output recognition must preserve one joint wiring environment.
(include "egglog-experimental/tests/slotted/languages/churchroad.egg")
(let a $a)
(let b $b)
(let c $c)
(let good (OutputCons 1 (Xor 1 a b) (OutputCons 1 (And 1 a b) (NoOutputs))))
(let bad (OutputCons 1 (Xor 1 a b) (OutputCons 1 (And 1 a c) (NoOutputs))))
(let aliased (OutputCons 1 (Xor 1 a a) (OutputCons 1 (And 1 a a) (NoOutputs))))
(let slices (OutputCons 4 (Extract 4 3 0 a)
              (OutputCons 4 (Extract 4 7 4 a) (NoOutputs))))
(let wrong_slices (OutputCons 4 (Extract 4 3 0 a)
                    (OutputCons 4 (Extract 4 7 4 b) (NoOutputs))))
(run 1)
(check (= good (HalfAdder 0 a b)))
(check (= aliased (HalfAdder 0 a a)))
(fail (check (= bad (HalfAdder 0 a b))))
(check (= slices (SlicePair 4 4 3 0 7 4 a)))
(fail (check (= wrong_slices (SlicePair 4 4 3 0 7 4 a))))
