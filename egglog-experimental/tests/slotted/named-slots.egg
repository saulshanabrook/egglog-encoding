;;; Every carrier accepts slot literals; :binder gives a slot scope.
(datatype Expr (VExpr Var)
  (Lam Var Expr :binder 0)
  (Pair Expr Expr)
  (Occurrence Expr)
  (Done))

(let a (Done))
(let identity (Lam $a (VExpr $a)))
(let constant (Lam $a (VExpr $a0)))
(let mixed (Pair (VExpr $a) (VExpr $0)))
(let limits (Pair (VExpr $a) (VExpr $-9223372036854775808)))
(let numbered (Pair (VExpr $01) (VExpr $+1)))
(let variable (Occurrence (VExpr $a)))
(let compound (Occurrence (Done)))
(let pattern (Pair (VExpr $a) (VExpr $a0)))
(let positive (Pair pattern (VExpr $a)))
(let negative (Pair pattern (VExpr $a0)))
(let slot_a $a)
(rewrite (Pair pattern (VExpr slot_a)) (Done) :name "shared-named-slot")
(rewrite (Occurrence (VExpr $s)) (Pair (VExpr $s) (VExpr $s)) :name "slot-occurrence")
(run 1)
(check (= identity (Lam $b (VExpr $b))))
(check (!= identity constant))
(check (free-names-are identity))
(let slot_a0 $a0)
(check (free-names-are constant slot_a0))
(let slot_0 $0)
(check (free-names-are mixed slot_a slot_0))
(let slot_minus_9223372036854775808 $-9223372036854775808)
(check (free-names-are limits slot_a slot_minus_9223372036854775808))
(let slot_1 $1)
(check (free-names-are numbered slot_1))
(check (free-names-are variable slot_a))
(check (free-names-are compound))
(check (= variable (Pair (VExpr slot_a) (VExpr slot_a))))
(check (= positive (Done)))
(check (!= negative (Done)))

;;; Bound names shadow locally, while ordinary children may contain free slots.
(push)
(let nested (Lam $a (Lam $a (Occurrence (VExpr $a)))))
(run 0)
(check (= nested (Lam $outer (Lam $inner (Occurrence (VExpr $inner))))))
(pop)
