;;; Every carrier accepts slot literals; :binder gives a slot scope.
(datatype Expr
  (Lam Expr Expr :binder 0)
  (Pair Expr Expr)
  (Occurrence Expr)
  (Done))

(let a (Done))
(let identity (Lam $a $a))
(let constant (Lam $a $a0))
(let mixed (Pair $a $0))
(let limits (Pair $a $-9223372036854775808))
(let numbered (Pair $01 $+1))
(let variable (Occurrence $a))
(let compound (Occurrence (Done)))
(let pattern (Pair $a $a0))
(let positive (Pair pattern $a))
(let negative (Pair pattern $a0))
(rewrite (Pair pattern $a) (Done) :name "shared-named-slot")
(rewrite (Occurrence $s) (Pair $s $s) :name "slot-occurrence")
(run 1)
(check (= identity (Lam $b $b)))
(check (!= identity constant))
(check (free-names-are identity))
(check (free-names-are constant $a0))
(check (free-names-are mixed $a $0))
(check (free-names-are limits $a $-9223372036854775808))
(check (free-names-are numbered $1))
(check (free-names-are variable $a))
(check (free-names-are compound))
(check (= variable (Pair $a $a)))
(check (= positive (Done)))
(check (!= negative (Done)))

;;; Bound names shadow locally, while ordinary children may contain free slots.
(push)
(let nested (Lam $a (Lam $a (Occurrence $a))))
(run 0)
(check (= nested (Lam $outer (Lam $inner (Occurrence $inner)))))
(pop)
