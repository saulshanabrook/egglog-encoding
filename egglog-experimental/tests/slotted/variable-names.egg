;;; Identifier spelling is significant in payloads, guards, and multipattern roots.
(datatype Expr (VExpr Var) (Num i64) (Pair Expr Expr) (Result Expr Expr)
               (Quad Expr Expr Expr Expr))

(push)
(rewrite (Pair (Num n) (Num ?n)) (Result (Num ?n) (Num n)))
(let pair (Pair (Num 1) (Num 2)))
(run 1)
(check (= pair (Result (Num 2) (Num 1))))
(fail (check (= pair (Result (Num 1) (Num 2)))))
(pop)

(push)
(rewrite (Pair x ?x) (Result x ?x) :when ((= x ?x)))
(let same (Pair (VExpr $a) (VExpr $a)))
(let different (Pair (VExpr $a) (VExpr $b)))
(run 1)
(let slot_a $a)
(check (= same (Result (VExpr slot_a) (VExpr slot_a))))
(let slot_b $b)
(fail (check (= different (Result (VExpr slot_a) (VExpr slot_b)))))
(pop)

(push)
(rewrite (Quad (VExpr $s) (VExpr $t) x ?x) (Result x ?x)
         :when ((free $s x) (not-free $s ?x)
                (free-names-are ?x $t) (!= x ?x)))
(let yes (Quad (VExpr $a) (VExpr $b) (Pair (VExpr $a) (VExpr $a)) (Pair (VExpr $b) (VExpr $b))))
(let no (Quad (VExpr $a) (VExpr $b) (Pair (VExpr $a) (VExpr $a)) (Pair (VExpr $a) (VExpr $b))))
(run 1)
(let slot_a_1 $a)
(let slot_b_1 $b)
(check (= yes (Result (Pair (VExpr slot_a_1) (VExpr slot_a_1)) (Pair (VExpr slot_b_1) (VExpr slot_b_1)))))
(fail (check (= no (Result (Pair (VExpr slot_a_1) (VExpr slot_a_1)) (Pair (VExpr slot_a_1) (VExpr slot_b_1))))))
(pop)

(push)
(rewrite x (Result ??x a)
         :when ((= x (Pair ?x ??x)) (= ?x (Pair a b))))
(let nested (Pair (Pair (VExpr $a) (VExpr $b)) (VExpr $c)))
(run 1)
(let slot_c $c)
(let slot_a_2 $a)
(check (= nested (Result (VExpr slot_c) (VExpr slot_a_2))))
(fail (check (= nested (Result (VExpr slot_a_2) (VExpr slot_c)))))
(pop)
