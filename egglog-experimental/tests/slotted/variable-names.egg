;;; Identifier spelling is significant in payloads, guards, and multipattern roots.
(datatype Expr (Num i64) (Pair Expr Expr) (Result Expr Expr)
               (Quad Expr Expr Expr Expr))

(push)
(rewrite (Pair (Num n) (Num ?n)) (Result (Num ?n) (Num n)))
(let pair (Pair (Num 1) (Num 2)))
(run 1)
(check (= pair (Result (Num 2) (Num 1))))
(fail (check (= pair (Result (Num 1) (Num 2)))))
(pop)

(push)
(rewrite (Pair x ?x) (Result x ?x) :when ((= x ?x)))
(let same (Pair $a $a))
(let different (Pair $a $b))
(run 1)
(let slot_a $a)
(check (= same (Result slot_a slot_a)))
(let slot_b $b)
(fail (check (= different (Result slot_a slot_b))))
(pop)

(push)
(rewrite (Quad $s $t x ?x) (Result x ?x)
         :when ((free $s x) (not-free $s ?x)
                (free-names-are ?x $t) (!= x ?x)))
(let yes (Quad $a $b (Pair $a $a) (Pair $b $b)))
(let no (Quad $a $b (Pair $a $a) (Pair $a $b)))
(run 1)
(let slot_a_1 $a)
(let slot_b_1 $b)
(check (= yes (Result (Pair slot_a_1 slot_a_1) (Pair slot_b_1 slot_b_1))))
(fail (check (= no (Result (Pair slot_a_1 slot_a_1) (Pair slot_a_1 slot_b_1)))))
(pop)

(push)
(rewrite x (Result ??x a)
         :when ((= x (Pair ?x ??x)) (= ?x (Pair a b))))
(let nested (Pair (Pair $a $b) $c))
(run 1)
(let slot_c $c)
(let slot_a_2 $a)
(check (= nested (Result slot_c slot_a_2)))
(fail (check (= nested (Result slot_a_2 slot_c))))
(pop)
