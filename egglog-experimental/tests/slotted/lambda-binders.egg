;;; The paper's `lambda` language: what a binder does to a class's slots.
;;;
;;; Written in the SLOTTED language, so `lam $5. $5` is `(Lam $5 (V $5))`.
;;; The binder is a rigid Var name; the variable occurrence is a term in U.
;;; Renamings act on both, while equality of U terms never equates Var names.
;;;
;;; `Lam` and `Let` bind their column 0. `App` binds nothing, which is what makes the
;;; last section a test rather than a tautology.

(sort U)
(constructor V (Var) U)

(constructor Lam (Var U) U :binder 0)
(constructor App (U U) U)
(constructor Let (Var U U) U :binder 0)
(constructor Null () U)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; alpha-equivalence of the identity function
;;;
;;;     lam $5. $5   =   lam $6. $6
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let id5 (Lam $5 (V $5)))
(let id6 (Lam $6 (V $6)))
(run 0)

(check (= id5 id6))
;; the bound slot is not free, so the class depends on nothing
(check (free-names-are id5))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; a binder is not vacuous: lam $5. $5 is not lam $5. $7
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let id5 (Lam $5 (V $5)))
(let const (Lam $5 (V $7)))
(run 0)

(check (!= id5 const))
;; and the constant function keeps $7 free
(let slot_7 $7)
(check (free-names-are const slot_7))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; `Let`, the arity-3 binder
;;;
;;;     let $5 = f in $5   =   let $6 = f in $6
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let f (App (Null) (Null)))
(let l5 (Let $5 (V $5) f))
(let l6 (Let $6 (V $6) f))
(run 0)

(check (= l5 l6))
(check (free-names-are l5))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; the operator is part of the identity: App and Lam over the same slots differ
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let a (App (V $5) (V $5)))
(let l (Lam $5 (V $5)))
(run 0)

(check (!= a l))
;; `App` binds nothing, so $5 stays free
(let slot_5 $5)
(check (free-names-are a slot_5))

(pop)
