Source:
(datatype U (V Var) (F U) (G U) (H U) (A))
(let input (F (G (A))))
(let side (H (A)))
(rewrite (F (G x)) (H x) :when ((= (G x) y) (H x)) :name "nested")
(run 1)
(check (= input side))

Proof:
(let prf (Fiat (= (F (G (A))) (F (G (A))))))
(Rule
  (= (F (G (A))) (H (A)))
  (name "nested")
  (premises prf (Proj (= (G (A)) (G (A))) prf 0) (Fiat (= (H (A)) (H (A)))))
  (substitution (x (A)) (y (G (A)))))
