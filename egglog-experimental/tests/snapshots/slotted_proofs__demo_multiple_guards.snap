---
source: egglog-experimental/tests/slotted_proofs.rs
expression: "format!(\"Source:\\n{source}\\n\\nProof:\\n{}\", proofs[0])"
---
Source:
(datatype U (V Var) (Pair U U) (Hit))
(let input (Pair (V $a) (V $b)))
(rewrite (Pair (V $x) (V $y)) (Hit)
  :when ((renaming-= (V $x) (V $y)) (not-free $x (V $y)) (!= (V $x) (V $y))) :name "guards")
(run 1)
(check (= input (Hit)))

Proof:
(let t (Pair (V $a) (V $b)))
(let prf (Fiat (= t t)))
(let prf_1 (Proj (= (V $a) (V $a)) prf 0))
(let prf_2 (Equivariance (= (V $b) (V $b)) prf_1 (renaming ($a $b) ($b $a))))
(let prf_3 (Fiat (= () ())))
(Rule
  (= t (Hit))
  (name "guards")
  (premises
    prf
    (RenamingEq (renaming-= (V $a) (V $b)) prf_1 prf_2)
    prf_2
    prf_3
    prf_1
    prf_2
    prf_3)
  (substitution ($x $a) ($y $b)))
