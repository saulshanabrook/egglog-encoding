Source:
(datatype U (V Var) (Pair U U) (F U) (G U) (Hit))
(union (F (V $a)) (G (V $a)))
(let input (Pair (V $a) (V $b)))
(let side (G (V $b)))
(rewrite (Pair (V $x) (V $y)) (Hit) :when ((renaming-= (F (V $x)) (G (V $y)))) :name "guard")
(run 1)
(check (= input (Hit)))

Proof:
(let t (Pair (V $a) (V $b)))
(let prf (Fiat (= (F (V $a)) (G (V $a)))))
(Rule
  (= t (Hit))
  (name "guard")
  (premises
    (Fiat (= t t))
    (RenamingEq
      (renaming-= (F (V $a)) (G (V $b)))
      (Trans (= (F (V $a)) (F (V $a))) prf (Sym (= (G (V $a)) (F (V $a))) prf))
      (Sym
        (= (G (V $b)) (F (V $b)))
        (Equivariance (= (F (V $b)) (G (V $b))) prf (renaming ($a $b) ($b $a))))))
  (substitution ($x $a) ($y $b)))
