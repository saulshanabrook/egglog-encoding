(datatype U (Pair U U) (F U) (G U) (Hit))
(union (F $a) (G $a))
(let input (Pair $a $b))
(let side (G $b))
(rewrite (Pair $x $y) (Hit) :when ((renaming-= (F $x) (G $y))) :name "guard")
(run 1)
(check (= input (Hit)))

