                  (Num 0)
                  (Sum $v15 (Load (Mem0) (Arr "a") (V $v15)))))
(let t_11 (Ret t_5 t_10))
(let t_12 (Ret t_6 t_10))
(let prop_2 (= t_11 t_12))
