                                ($v5 $v0)
                                ($v6 $j)))
                            1))
(let t_28 (Sum $v10 (Load t_15 (Arr "a") (V $v10))))
(let t_29
  (renaming
                                    ($v8 $v9)
                                    ($v9 $v6)
                                    ($v10 $v8)
