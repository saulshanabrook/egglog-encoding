                                      (Num 0)
                                      (Sum $v0 (Load (Mem0) (Arr "a") (V $v0)))))
(let t_22 (Load t_21 (Arr "a") (V $j)))
(let t_23 (Load (Mem0) (Arr "a") (V $j)))
(let t_24 (Sum $v2 (Load (Mem0) (Arr "a") (V $v2))))
(let t_25 (Store (Mem0) (Arr "out") (Num 0) t_24))
(let t_26 (Load t_25 (Arr "a") (V $j)))
(let prf_3
  (Congr
                                  (= t_22 t_26)
