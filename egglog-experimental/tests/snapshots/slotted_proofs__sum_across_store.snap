                                    (Equivariance
                                      (= t_21 t_21)
                                      (Fiat (= t_13 t_13))
                                      (renaming ($i $v0) ($v0 $v1) ($v1 $i))))
                                  0))
(let t_27
  (_disequality_disequality-ne-Expr
                                          (Arr "a")
