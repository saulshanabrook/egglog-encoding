                                      (Sum $i (Load (Mem0) (Arr "a") (V $i)))))
(let t_14 (Ret (Sum $j (Load t_13 (Arr "a") (V $j))) t_13))
(let prf (Alpha (= t_14 t_4) (Fiat (= t_14 t_14))))
(let prf_1 (Trans (= t_4 t_4) (Sym (= t_4 t_14) prf) prf))
(let t_15
  (Store
