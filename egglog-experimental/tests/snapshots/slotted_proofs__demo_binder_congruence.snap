Source:
(datatype U (V Var) (Wrap U) (Lam Var U :binder 0) (F U) (G U))
(let input (Wrap (Lam $a (F (V $a)))))
(rewrite (F x) (G x) :name "f-to-g")
(run 1)
(check (= input (Wrap (Lam $b (G (V $b))))))

Proof:
(let t (Lam $a (F (V $a))))
(let t_1 (Wrap t))
(let t_2 (Lam $a (G (V $a))))
(Claim
  (= t_1 (rename (renaming ($a $b) ($b $a)) (Wrap (Lam $b (G (V $b))))))
  (Congr
    (= t_1 (Wrap t_2))
    (Fiat (= t_1 t_1))
    (Congr
      (= t t_2)
      (Fiat (= t t))
      (Rule
        (= (F (V $a)) (G (V $a)))
        (name "f-to-g")
        (premises (Fiat (= (F (V $a)) (F (V $a)))))
        (substitution (x (V $a))))
      1)
    0))
