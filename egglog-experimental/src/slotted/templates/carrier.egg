;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; carrier {sort}: {renames}, {group}, {equated}, {free_vars}
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(sort {sort})
(constructor {var} (i64) {sort})
(relation {renames} ({sort} Renaming {sort}))
(relation {equated} ({sort} Renaming {sort}))
(function {free_vars} ({sort}) Renaming :merge (map-intersect old new))
(relation {subst_pending} ({sort} Renaming Renaming {sort}))
(function {shape_equal} ({sort} Renaming {sort}) Unit :no-merge)
{invocation_decl}
(function {group} ({sort}) Group :merge (set-union old new))
(function {group_replace} ({sort}) Group :merge new)
(function {coset_reps} ({sort} Renaming) Renamings :merge new)
(relation {big_reading} ({sort} Renaming))
(relation {reading} ({sort} Renaming Renaming))

(set (SlottedNodeLayout "{var}" 1) ())
(set ({free_vars} ({var} 0)) (map-of 0 0))

(rule (({equated} _a _m _b)
       (!= _a _b)
       (= _a (ordering-max _a _b))
       (= _csa ({free_vars} _a))
       (= _csb ({free_vars} _b)))
      (({renames} _a (compose _csa (compose _m _csb)) _b)) :ruleset slotted :name "slotted/orient-max/{index}")

(rule (({equated} _a _m _b)
       (!= _a _b)
       (= _b (ordering-max _a _b))
       (= _csa ({free_vars} _a))
       (= _csb ({free_vars} _b)))
      (({renames} _b (compose _csb (compose (inverse _m) _csa)) _a)) :ruleset slotted :name "slotted/orient-min/{index}")

(rule (({equated} _a _m _a)
       (= _cs ({free_vars} _a)))
      ((set ({group} _a) (set-of (compose _cs (compose _m _cs))))) :ruleset slotted :name "slotted/self-symmetry/{index}")

(rule ((= _cs ({free_vars} _c)))
      (({renames} _c _cs _c)
       (set ({group} _c) (set-of _cs))) :ruleset slotted :name "slotted/seed-identity/{index}")

(rule (({renames} _c _m _c)
       (= _cs ({free_vars} _c))
       (!= _m _cs))
      ((set ({group} _c) (set-of (compose _cs (compose _m _cs))))
       (delete ({renames} _c _m _c))) :ruleset slotted :name "slotted/self-edge-symmetry/{index}")

(rule (({renames} _f _m _l)
       (!= _f _l)
       (= _l (ordering-max _f _l)))
      ((delete ({renames} _f _m _l))) :ruleset slotted :name "slotted/drop-stale-edge/{index}")

(rule (({renames} _a _m _b) (= _slots ({free_vars} _a)))
      ((set ({free_vars} _b) (map-image (compose (inverse _m) _slots))))
      :ruleset slotted :name "slotted/transport-down/{index}")
(rule (({renames} _a _m _b) (= _slots ({free_vars} _b)))
      ((set ({free_vars} _a) (map-image (compose _m _slots))))
      :ruleset slotted :name "slotted/transport-up/{index}")

(rule ((= _grp ({group} _c)) (= _slots ({free_vars} _c)))
      ((set ({free_vars} _c) (group-slot-closure _grp _slots)))
      :ruleset slotted :name "slotted/slot-closure/{index}")

(rule (({renames} _e1 _m12 _e2)
       ({renames} _e2 _m23 _e3)
       (!= _e2 _e3))
      (({equated} _e1 (compose _m12 _m23) _e3)) :ruleset slotted :name "slotted/transitivity/{index}")

(rule (({renames} _a _m1 _b)
       ({renames} _a _m2 _c)
       (!= _a _c)
       (!= _a _b)
       (= _csa ({free_vars} _a))
       (= _csb ({free_vars} _b))
       (= _csc ({free_vars} _c))
       (= _m1 (compose _csa (compose _m1 _csb)))
       (= _m2 (compose _csa (compose _m2 _csc)))
       (= (ordering-max _b _c) _b)
       (guard (or (bool-!= _b _c)
                  (and (bool= _b _c)
                       (bool-!= _m1 _m2)
                       (bool= (ordering-max _m1 _m2) _m1)))))
      ((delete ({renames} _a _m1 _b))
       ({equated} _b (compose (inverse _m1) _m2) _c)) :ruleset slotted :name "slotted/one-leader/{index}")

(rule ((= _s ({group} _f))
       (> (set-length _s) 0)
       ({renames} _f _m _l)
       (!= _f _l)
       (= _f (ordering-max _f _l)))
      ((delete ({group} _f))
       (set ({group_replace} _f) (set-empty))) :ruleset slotted-empty :name "slotted/group-empty/{index}")

(rule (({renames} _f _g _f)
       ({renames} _f _m _l)
       (!= _f _l)
       (= _f (ordering-max _f _l)))
      ((delete ({renames} _f _g _f))) :ruleset slotted :name "slotted/drop-follower-identity/{index}")

(rule ((= _s ({group} _c))
       (= _cs ({free_vars} _c))
       (= _s2 (group-close (group-restrict _s _cs)))
       (!= _s _s2))
      ((delete ({group} _c))
       (set ({group_replace} _c) _s2)) :ruleset slotted-shrink :name "slotted/group-shrink/{index}")

(rule ((= _s2 ({group_replace} _c)))
      ((set ({group} _c) _s2)
       (delete ({group_replace} _c))) :ruleset slotted-restore :name "slotted/group-restore/{index}")

(rule (({renames} _f _m _l)
       (= _csf ({free_vars} _f))
       (= _csl ({free_vars} _l))
       (= _m2 (compose _csf (compose _m _csl)))
       (!= _m _m2))
      ((delete ({renames} _f _m _l))
       ({renames} _f _m2 _l)) :ruleset slotted :name "slotted/restate-edge/{index}")

(rule ((= _e ({var} _v))
       (!= _v 0))
      (({equated} _e (map-insert (map-empty) 0 _v) ({var} 0))
       (delete ({var} _v))) :ruleset slotted :name "slotted/var-normalize/{index}")

({renames} ({var} 0) (map-insert (map-empty) 0 0) ({var} 0))
(set ({group} ({var} 0)) (set-of (map-insert (map-empty) 0 0)))

(rule (({renames} _a _m _c)
       (= _grp ({group} _c))
       (= _name (coset-min _m _grp)))
      ({invocation_register}) :ruleset slotted :name "slotted/invocation/{index}")

{invocation_union}

(rule ((GroupIdxSmall _i)
       (= _s ({coset_reps} _c _pinned))
       (= _g (vec-get _s _i)))
      (({reading} _c _pinned _g)) :ruleset slotted-read :name "slotted/reading-small/{index}")

(rule ((= _s ({coset_reps} _c _pinned))
       (> (vec-length _s) 8))
      (({big_reading} _c _pinned)) :ruleset slotted-read :name "slotted/reading-big-mark/{index}")

(rule (({big_reading} _c _pinned)
       (= _s ({coset_reps} _c _pinned))
       (GroupIdx _i)
       (>= _i 8)
       (= _g (vec-get _s _i)))
      (({reading} _c _pinned _g)) :ruleset slotted-read :name "slotted/reading-big/{index}")

(rule (({reading} _c _pinned _g)
       (= _s ({coset_reps} _c _pinned))
       (vec-not-contains _s _g))
      ((delete ({reading} _c _pinned _g))) :ruleset slotted-read :name "slotted/reading-cleanup/{index}")

(rule ((= _s ({coset_reps} _c _pinned))
       (= _grp ({group} _c))
       (= _fresh (group-coset-reps _grp _pinned))
       (!= _s _fresh))
      ((set ({coset_reps} _c _pinned) _fresh)) :ruleset slotted-read :name "slotted/coset-repair/{index}")

(rule ((= _s ({coset_reps} _c _pinned))
       (> (vec-length _s) 512))
      ((panic "a class has more readings than GroupIdx indexes")) :ruleset slotted-read :name "slotted/coset-panic/{index}")

(rule (({shape_equal} _a _m _b))
      (({equated} _a _m _b)) :ruleset slotted :name "slotted/shape-equal/{index}")

(rule (({subst_pending} _root _q _mr _r)
       (= _cs ({free_vars} _r)))
      (({equated} _root (compose _q (compose _mr _cs)) _r))
      :ruleset slotted :name "slotted/subst-answer/{index}")
