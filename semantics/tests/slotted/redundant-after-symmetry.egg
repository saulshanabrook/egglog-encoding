;;; Support transport through a self-equation removes the whole redundant orbit.
(datatype U (V Var) (Pair U U) (Keep U) (Wrap U) (Zero))
(Zero)
(let x $x)
(let y $y)
(let p (Pair (V x) (V y)))
(union p (Pair (V y) (V x)))
(run 0)
(check (free-names-are p x y))
(union p (Keep (V x)))
(run 0)
(check (free-names-are p))
(let other (Pair (V $a) (V $b)))
(let wrapped (Wrap (Keep (V $z))))
(check (= p other))
(check (= wrapped (Wrap (Keep (V $w)))))
(check (!= p (Zero)))
