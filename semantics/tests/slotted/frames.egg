;;; Fresh action binders cannot capture a matched free slot. Repeated payload and
;;; term variables are joined independently; disequality has both class and map cases.
(datatype E (V Var) (Seed E) (Lam Var E :binder 0)
  (Pair E E) (Num i64) (Hit))
(let slot_0 $0)
(let slot_1 $1)
(let seed (Seed (V slot_0)))
(rewrite (Seed x) (Lam $fresh x))
(run 1)
(check (= seed (Lam $binder (V slot_0))) (not-free $binder (V slot_0)))
(fail (check (= seed (Lam $binder (V $binder)))))
(check (free-names-are seed slot_0))

(push)
(let same (Pair (V slot_0) (V slot_0)))
(let different (Pair (V slot_0) (V slot_1)))
(rewrite (Pair x x) (Hit))
(run 1)
(check (= same (Hit)))
(fail (check (= different (Hit))))
(check (!= different (Hit)))
(pop)

(push)
(let one (Num 1))
(let two (Num 2))
(let same (Pair one one))
(let different (Pair one two))
(rewrite (Pair (Num n) (Num n)) (Hit))
(run 1)
(check (= same (Hit)))
(check (!= different (Hit)))
(pop)
