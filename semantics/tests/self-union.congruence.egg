(sort Math)
(ruleset r0)
(ruleset r1)
(ruleset r2)
(ruleset r3)
(constructor A () Math)
(constructor F (Math) Math)
(relation @UF (Math Math))
(rule () ((@UF (A) (A)) (@UF (A) (A)) (@UF (A) (min (A) (A))) (@UF (A) (min (A) (A)))) :ruleset r0)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r1)
(rule ((F @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (F @a0) @y) (@UF (F @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(run-schedule (seq (run r0) (saturate (run r1))))
(rule () ((@UF (A) (A)) (@UF (F (A)) (F (A))) (@UF (A) (A)) (@UF (F (A)) (F (A))) (@UF (F (A)) (min (F (A)) (F (A)))) (@UF (F (A)) (min (F (A)) (F (A))))) :ruleset r2)
(run r2 1)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r3)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r3)
(rule ((F @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (F @a0) @y) (@UF (F @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
