(rule ((@SuccView x @v0) (@AddView @v0 y @v1) (@EvalView @v1 @v2)) ((@UF x x) (@SuccView x (Succ x)) (@UF (Succ x) (Succ x)) (@UF y y) (@AddView (Succ x) y (Add (Succ x) y)) (@UF (Add (Succ x) y) (Add (Succ x) y)) (@EvalView (Add (Succ x) y) (Eval (Add (Succ x) y))) (@UF (Eval (Add (Succ x) y)) (Eval (Add (Succ x) y))) (@UF x x) (@UF y y) (@AddView x y (Add x y)) (@UF (Add x y) (Add x y)) (@EvalView (Add x y) (Eval (Add x y))) (@UF (Eval (Add x y)) (Eval (Add x y))) (@SuccView (Eval (Add x y)) (Succ (Eval (Add x y)))) (@UF (Succ (Eval (Add x y))) (Succ (Eval (Add x y)))) (@UF (Eval (Add (Succ x) y)) (min (Eval (Add (Succ x) y)) (Succ (Eval (Add x y))))) (@UF (Succ (Eval (Add x y))) (min (Eval (Add (Succ x) y)) (Succ (Eval (Add x y)))))) :ruleset r2)
