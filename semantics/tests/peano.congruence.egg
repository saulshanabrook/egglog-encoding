(sort Math)
(ruleset r0)
(ruleset r1)
(ruleset r2)
(ruleset r3)
(constructor Zero () Math)
(constructor Succ (Math) Math)
(constructor Eval (Math) Math)
(constructor Add (Math Math) Math)
(relation @UF (Math Math))
(rule () ((@UF (Zero) (Zero)) (@UF (Succ (Zero)) (Succ (Zero))) (@UF (Succ (Succ (Zero))) (Succ (Succ (Zero)))) (@UF (Zero) (Zero)) (@UF (Succ (Zero)) (Succ (Zero))) (@UF (Add (Succ (Succ (Zero))) (Succ (Zero))) (Add (Succ (Succ (Zero))) (Succ (Zero)))) (@UF (Eval (Add (Succ (Succ (Zero))) (Succ (Zero)))) (Eval (Add (Succ (Succ (Zero))) (Succ (Zero)))))) :ruleset r0)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r1)
(rule ((Succ @a0) (Succ @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (Succ @a0) @y) (@UF (Succ @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(rule ((Eval @a0) (Eval @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (Eval @a0) @y) (@UF (Eval @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(rule ((Add @a0 @a1) (Add @b0 @b1) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @a1 @r1) (@UF @b1 @r1) (@UF (Add @a0 @a1) @y) (@UF (Add @b0 @b1) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(run-schedule (seq (run r0) (saturate (run r1))))
(rule ((Zero) (@UF (Zero) @v0) (Add @v1 @v2) (@UF @v1 @v0) (@UF @v2 y) (@UF (Add @v1 @v2) @v3) (Eval @v4) (@UF @v4 @v3)) ((@UF (Zero) (Zero)) (@UF y y) (@UF (Add (Zero) y) (Add (Zero) y)) (@UF (Eval (Add (Zero) y)) (Eval (Add (Zero) y))) (@UF y y) (@UF (Eval y) (Eval y)) (@UF (Eval (Add (Zero) y)) (min (Eval (Add (Zero) y)) (Eval y))) (@UF (Eval y) (min (Eval (Add (Zero) y)) (Eval y)))) :ruleset r2)
(rule ((Succ @v0) (@UF @v0 x) (@UF (Succ @v0) @v1) (Add @v2 @v3) (@UF @v2 @v1) (@UF @v3 y) (@UF (Add @v2 @v3) @v4) (Eval @v5) (@UF @v5 @v4)) ((@UF x x) (@UF (Succ x) (Succ x)) (@UF y y) (@UF (Add (Succ x) y) (Add (Succ x) y)) (@UF (Eval (Add (Succ x) y)) (Eval (Add (Succ x) y))) (@UF x x) (@UF y y) (@UF (Add x y) (Add x y)) (@UF (Eval (Add x y)) (Eval (Add x y))) (@UF (Succ (Eval (Add x y))) (Succ (Eval (Add x y)))) (@UF (Eval (Add (Succ x) y)) (min (Eval (Add (Succ x) y)) (Succ (Eval (Add x y))))) (@UF (Succ (Eval (Add x y))) (min (Eval (Add (Succ x) y)) (Succ (Eval (Add x y)))))) :ruleset r2)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r3)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r3)
(rule ((Succ @a0) (Succ @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (Succ @a0) @y) (@UF (Succ @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(rule ((Eval @a0) (Eval @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (Eval @a0) @y) (@UF (Eval @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(rule ((Add @a0 @a1) (Add @b0 @b1) (@UF @a0 @r0) (@UF @b0 @r0) (@UF @a1 @r1) (@UF @b1 @r1) (@UF (Add @a0 @a1) @y) (@UF (Add @b0 @b1) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(run-schedule (saturate (seq (run r2) (saturate (run r3)))))
