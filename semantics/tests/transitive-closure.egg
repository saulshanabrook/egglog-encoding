; Paths from edges, with a shared variable between two premises.
(sort Math)
(constructor N1 () Math)
(constructor N2 () Math)
(constructor N3 () Math)
(constructor N4 () Math)
(constructor Edge (Math Math) Math)
(constructor Path (Math Math) Math)
(Edge (N1) (N2))
(Edge (N2) (N3))
(Edge (N3) (N4))
(rule ((Edge a b)) ((Path a b)))
(rule ((Path a b) (Edge b c)) ((Path a c)))
(run-schedule (saturate (run)))
