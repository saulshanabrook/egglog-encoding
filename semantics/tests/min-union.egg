; A union with a minimum operand: each pair is merged with its smaller endpoint.
(sort Math)
(constructor A () Math)
(constructor B () Math)
(constructor C () Math)
(constructor Pair (Math Math) Math)
(constructor Pick (Math Math) Math)
(Pair (A) (B))
(Pair (B) (C))
(rule ((Pair x y)) ((union (Pick x y) (ordering-min x y))))
(run 1)
(rule ((Pair x y)) ((Pick y x)))
(run 1)
(check (= (Pick (A) (B)) (A)) (Pick (B) (A)))
