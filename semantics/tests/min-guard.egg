; A minimum and a disequality in a query: the pairs whose first endpoint is the smaller,
; and the pairs of one class.
(sort Math)
(constructor A () Math)
(constructor B () Math)
(constructor C () Math)
(constructor Pair (Math Math) Math)
(constructor Ordered (Math Math) Math)
(constructor Tie (Math) Math)
(Pair (A) (B))
(Pair (B) (C))
(Pair (C) (A))
(Pair (C) (C))
(rule ((Pair x y) (= x (ordering-min x y)) (!= x y)) ((Ordered x y)))
(rule ((Pair x y) (= x y)) ((Tie x)))
(run 1)
(union (A) (C))
(run 1)
(check (Ordered (A) (B)) (Tie (A)))
