; Congruence still merges hidden nodes, and their live wrappers can query their ids.
(sort Math)
(constructor A () Math)
(constructor B () Math)
(constructor F (Math) Math)
(constructor W (Math) Math)
(constructor V (Math) Math)
(constructor Equal () Math)
(W (F (A)))
(V (F (B)))
(subsume (F (A)))
(subsume (F (B)))
(union (A) (B))
(rule ((W x) (V y) (= x y)) ((Equal)))
(run 1)
(check (Equal))
