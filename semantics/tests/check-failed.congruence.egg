(sort Math)
(ruleset r0)
(ruleset r1)
(constructor F (Math) Math)
(constructor A () Math)
(relation @AView (Math))
(relation @UF (Math Math))
(relation @BView (Math))
(relation @FView (Math Math))
(rule () ((@AView (A)) (@UF (A) (A)) (@FView (A) (F (A))) (@UF (F (A)) (F (A)))) :ruleset r0)
(run r0 1)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((delete (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((delete (@UF @a @c)) (@UF @c @b)) :ruleset r1)
(rule ((@AView @e) (@UF @e @x) (!= @e @x)) ((delete (@AView @e)) (@AView @x)) :ruleset r1)
(rule ((@AView @y) (@AView @z) (= @y (min @y @z)) (!= @y @z)) ((delete (@AView @z)) (@UF @z @y)) :ruleset r1)
(rule ((@FView @c0 @e) (@UF @e @x) (!= @e @x)) ((delete (@FView @c0 @e)) (@FView @c0 @x)) :ruleset r1)
(rule ((@FView @c0 @e) (@UF @c0 @x) (!= @c0 @x)) ((delete (@FView @c0 @e)) (@FView @x @e)) :ruleset r1)
(rule ((@FView @c0 @y) (@FView @c0 @z) (= @y (min @y @z)) (!= @y @z)) ((delete (@FView @c0 @z)) (@UF @z @y)) :ruleset r1)
(rule ((@BView @e) (@UF @e @x) (!= @e @x)) ((delete (@BView @e)) (@BView @x)) :ruleset r1)
(rule ((@BView @y) (@BView @z) (= @y (min @y @z)) (!= @y @z)) ((delete (@BView @z)) (@UF @z @y)) :ruleset r1)
(run-schedule (saturate r1))
(check (@BView @v0) (@FView @v0 @v1))
