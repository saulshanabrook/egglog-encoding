(sort Math)
(ruleset r0)
(ruleset r1)
(ruleset r2)
(ruleset r3)
(constructor A () Math)
(constructor F (Math) Math)
(constructor G (Math) Math)
(constructor H (Math) Math)
(relation @UF (Math Math))
(rule () ((@UF (A) (A)) (@UF (G (A)) (G (A))) (@UF (F (G (A))) (F (G (A))))) :ruleset r0)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r1)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r1)
(rule ((F @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (F @a0) @y) (@UF (F @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(rule ((G @a0) (G @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (G @a0) @y) (@UF (G @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(rule ((H @a0) (H @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (H @a0) @y) (@UF (H @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r1)
(run-schedule (seq (run r0) (saturate (run r1))))
(rule ((G @v0) (@UF @v0 x) (@UF (G @v0) @v1) (F @v2) (@UF @v2 @v1)) ((@UF x x) (@UF (G x) (G x)) (@UF (F (G x)) (F (G x))) (@UF x x) (@UF (H x) (H x)) (@UF (F (G x)) (min (F (G x)) (H x))) (@UF (H x) (min (F (G x)) (H x)))) :ruleset r2)
(rule ((@UF @a @b) (@UF @b @c) (!= @b @c)) ((subsume (@UF @a @b)) (@UF @a @c)) :ruleset r3)
(rule ((@UF @a @b) (@UF @a @c) (= @b (min @b @c)) (!= @b @c)) ((subsume (@UF @a @c)) (@UF @c @b)) :ruleset r3)
(rule ((F @a0) (F @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (F @a0) @y) (@UF (F @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(rule ((G @a0) (G @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (G @a0) @y) (@UF (G @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(rule ((H @a0) (H @b0) (@UF @a0 @r0) (@UF @b0 @r0) (@UF (H @a0) @y) (@UF (H @b0) @z) (= @y (min @y @z)) (!= @y @z)) ((@UF @z @y)) :ruleset r3)
(run-schedule (saturate (seq (run r2) (saturate (run r3)))))
