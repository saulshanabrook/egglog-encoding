; Disequality guards in saturated rules: paths between distinct nodes, and loops.
(sort Math)
(constructor A () Math)
(constructor B () Math)
(constructor C () Math)
(constructor D () Math)
(constructor Edge (Math Math) Math)
(constructor Path (Math Math) Math)
(constructor Loop (Math) Math)
(Edge (A) (B))
(Edge (B) (C))
(Edge (C) (D))
(union (A) (D))
(rule ((Edge x y) (!= x y)) ((Path x y)))
(rule ((Path x y) (Edge y z) (!= x z)) ((Path x z)))
(rule ((Path x y) (Edge y z) (= x z)) ((Loop x)))
(run-schedule (saturate (run)))
(check (Path (A) (C)) (Loop (A)))
