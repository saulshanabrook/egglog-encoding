;;; The sdql language's rewrite rules.
;;;
;;; Split from `slotted/languages/sdql.egg`, which declares the constructors: a
;;; program that wants the rules includes this, and one that wants only the
;;; machinery compiles that.

(include "slotted/languages/sdql.egg")

(rewrite (Mult (Mult a b) c)
         (Mult a (Mult b c))
         :name "mult-assoc1")
(rewrite (Mult a (Mult b c))
         (Mult (Mult a b) c)
         :name "mult-assoc2")
(rewrite (Sub e e)
         (Num 0)
         :name "sub-identity")
(rewrite (Add e (Num 0))
         e
         :name "add-zero")
(rewrite (Sub e (Num 0))
         e
         :name "sub-zero")
(rewrite (Equality a b)
         (Equality b a)
         :name "eq-comm")
(rewrite (Mult a b)
         (Binop (Symbol "mult") a b)
         :name "mult-app1")
(rewrite (Binop (Symbol "mult") a b)
         (Mult a b)
         :name "mult-app2")
(rewrite (Add a b)
         (Binop (Symbol "add") a b)
         :name "add-app1")
(rewrite (Binop (Symbol "add") a b)
         (Add a b)
         :name "add-app2")
(rewrite (Sub a b)
         (Binop (Symbol "sub") a b)
         :name "sub-app1")
(rewrite (Binop (Symbol "sub") a b)
         (Sub a b)
         :name "sub-app2")
(rewrite (Get a b)
         (Binop (Symbol "getf") a b)
         :name "get-app1")
(rewrite (Binop (Symbol "getf") a b)
         (Get a b)
         :name "get-app2")
(rewrite (Sing a b)
         (Binop (Symbol "singf") a b)
         :name "sing-app1")
(rewrite (Binop (Symbol "singf") a b)
         (Sing a b)
         :name "sing-app2")
(rewrite (Unique a)
         (App (Symbol "uniquef") a)
         :name "unique-app1")
(rewrite (App (Symbol "uniquef") a)
         (Unique a)
         :name "unique-app2")
;; `beta` is the bench's `(let t $x body)` -> `body[(var $x) := t]`. It was left out
;; while the compiler had no substitution; `subst` is that, and
;; `slotted/tests/sdql-beta.egg` works through what it compiles to.
(rewrite (Let t $x body)
         (subst body $x t)
         :name "beta")
(rewrite (Let e1 $x (Binop f e2 e3))
         (Binop f (Let e1 $x e2) (Let e1 $x e3))
         :name "let-binop3")
(rewrite (Binop f (Let e1 $x e2) (Let e1 $x e3))
         (Let e1 $x (Binop f e2 e3))
         :name "let-binop4"
    :when ((not-free $x f)))
(rewrite (Let e1 $x (App e2 e3))
         (App e2 (Let e1 $x e3))
         :name "let-apply1")
(rewrite (App e2 (Let e1 $x e3))
         (Let e1 $x (App e2 e3))
         :name "let-apply2"
    :when ((not-free $x e2)))
(rewrite (Mult e1 (IfThen e2 e3))
         (IfThen e2 (Mult e1 e3))
         :name "if-mult2")
(rewrite (IfThen e1 e2)
         (Mult e1 e2)
         :name "if-to-mult")
(rewrite (Mult (Equality e1_1 e1_2) e2)
         (IfThen (Equality e1_1 e1_2) e2)
         :name "mult-to-if")
(rewrite (Sum R $x $y (Mult e1 e2))
         (Mult e1 (Sum R $x $y e2))
         :name "sum-fact-1"
         :when ((not-free $x e1)
                (not-free $y e1)))
(rewrite (Sum R $x $y (Mult e1 e2))
         (Mult (Sum R $x $y e1) e2)
         :name "sum-fact-2"
         :when ((not-free $x e2)
                (not-free $y e2)))
(rewrite (Sum R $x $y (Sing e1 e2))
         (Sing e1 (Sum R $x $y e2))
         :name "sum-fact-3"
         :when ((not-free $x e1)
                (not-free $y e1)))
(rewrite (Sing e1 (Mult e2 e3))
         (Mult (Sing e1 e2) e3)
         :name "sing-mult-1")
(rewrite (Sing e1 (Mult e2 e3))
         (Mult e2 (Sing e1 e3))
         :name "sing-mult-2")
(rewrite (Mult (Sing e1 e2) e3)
         (Sing e1 (Mult e2 e3))
         :name "sing-mult-3")
(rewrite (Mult e2 (Sing e1 e3))
         (Sing e1 (Mult e2 e3))
         :name "sing-mult-4")
(rewrite (Mult e1 (Sum R $k $v e2))
         (Sum R $k $v (Mult e1 e2))
         :name "sum-fact-inv-1"
    :when ((not-free $k e1) (not-free $v e1)))
(rewrite (Sing e1 (Sum R $k $v e2))
         (Sum R $k $v (Sing e1 e2))
         :name "sum-fact-inv-3"
    :when ((not-free $k e1) (not-free $v e1)))
(rewrite (Sum (Sum R $k2 $v2 (Sing $k2 body1)) $k1 $v1 body2)
         (Sum R $k2 $v2 (Let $k2 $k1 (Let body1 $v1 body2)))
         :name "sum-sum-vert-fuse-1"
    :when ((not-free $k1 body1) (not-free $k2 body2) (not-free $v2 body2)))
(rewrite (Sum (Sum R $k2 $v2 (Sing (Unique key) body1)) $k1 $v1 body2)
         (Sum R $k2 $v2 (Let (Unique key) $k1 (Let body1 $v1 body2)))
         :name "sum-sum-vert-fuse-2"
    :when ((not-free $k1 body1) (not-free $k2 body2) (not-free $v2 body2)))
(rewrite (Sum (Range st en) $k $v (IfThen (Equality $v key) body))
         (Sum (Range st en) $k $v (IfThen (Equality $k (Sub key (Sub st (Num 1)))) body))
         :name "sum-range-1"
    :when ((not-free $k st) (not-free $v st)))
(rewrite (Sum R $k1 $v1 (Sum S $k2 $v2 (IfThen (Equality $v1 $v2) body)))
         (Merge R S $k1 $k2 $v1 (Let $v1 $v2 body))
         :name "sum-merge")
(rewrite (Get dict key)
         (Sum dict $k $v (IfThen (Equality $k key) $v))
         :name "get-to-sum"
)
(rewrite (Sum dict $k $v (IfThen (Equality $k key) body))
         (Let key $k (Let (Get dict $k) $v body))
         :name "sum-to-get"
         :when ((not-free $k dict) (not-free $k key)
                (not-free $v key)))
(rewrite (Get (Range st en) idx)
         (Add idx (Sub st (Num 1)))
         :name "get-range")
(rewrite (Sum e1 $k $v (Sing $k $v))
         e1
         :name "sum-sing")
(rewrite (Unique e)
         e
         :name "unique-rm")
