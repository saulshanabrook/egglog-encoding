;;; A bound slot stays renameable even when it collides with a free one.
;;;
;;; `Bind<T>` in the reference SCOPES its slot, so renaming it is invisible. This
;;; encoding flattens the binder into an ordinary child column, so the bound slot
;;; shares a namespace with the ambient slots and two rules keep them apart:
;;;
;;;   * a binder covers ONE column -- the one after the binder slots, which is what
;;;     `Bind<T>` wrapping a single child means -- so a slot free in an UNCOVERED
;;;     column is not stripped. Without that, `let x = x in f1 x` lost the value's
;;;     occurrence too and the class came out with no slots, merging terms the
;;;     reference keeps apart.
;;;
;;;   * but then the collision blocks the strip, which would leave the bound slot in
;;;     the class's slot set and stop it being renameable -- separating two terms the
;;;     reference identifies, the opposite error. So a colliding bound slot is first
;;;     renamed to a slot the node does not use, and the strip then applies. That
;;;     fires at most once per collision: the slot it picks is by construction absent
;;;     from the uncovered column's image.
;;;
;;; Written in the SLOTTED language. The claim is about CLASSES -- which slots one
;;; depends on, and whether two are equal -- and neither needs a renaming spelled
;;; out. The encoded version of this file had to share one body class by hand, or
;;; its edges would violate Def. 4 and the case would prove nothing; the compiler
;;; cannot emit an edge whose domain is not its child's slot set, so here that is
;;; not a thing to get right.
;;;
;;;     python3 slotted/slotted-egglog.py slotted/tests/binder-scope.egg

(constructor Let (U U U) U :binder 0)
(constructor App (U U) U)
(constructor Sym (String) U)

;; `let` binds its column 0 and COVERS column 1, its body; column 2, the value, is
;; uncovered, so a slot occurring there stays free.

;; let $0 = (var $0) in f1 (var $0) -- the bound slot collides with the value's
(let l0 (Let $0 (App (Sym "f1") $0) $0))

;; let $1 = (var $0) in f1 (var $1) -- the same term, bound slot renamed
(let l1 (Let $1 (App (Sym "f1") $1) $0))

(run 0)

;; the value's occurrence keeps slot 0 free in both, and only that one
(check (slots l0 $0))
(check (slots l1 $0))

;; and renaming a bound slot changes nothing, so the two are equal
(check (= l0 l1))
