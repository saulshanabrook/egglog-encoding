(sort U)

(constructor Lam (U U) U :binder 0)
(constructor App (U U) U)
(constructor Add (U U) U)

(constructor Rel (U U) U)
(constructor Truth () U)

(let a01 (Add $0 $1))
(let a10 (Add $1 $0))
(union a01 a10)

(let example (App (Lam $0 (Lam $1 a01))
                  (Lam $0 (Lam $1 a01))))
(let t (Truth))

;;; A binder column takes a slot literal, and a literal is rigid: two different ones can
;;; never be one slot. The shared body `a` forces the second chain's bound slots onto
;;; the first chain's, straight or -- through `a01 = a10` -- swapped, so each pairing is
;;; its own rule: one literal in both chains, or the two literals swapped.
(rewrite
    (Truth)
    (Rel $x $x)
    :when ((App (Lam $x (Lam $y a))
          (Lam $x (Lam $y a))))
    :name "straight"
)
(rewrite
    (Truth)
    (Rel $x $y)
    :when ((App (Lam $x (Lam $y a))
          (Lam $y (Lam $x a))))
    :name "swapped"
)

(run 10)

(check (= (Rel $0 $0) (Truth)))
(check (= (Rel $0 $1) (Truth)))
