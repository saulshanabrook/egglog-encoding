;;; Symmetries: where they come from, and what has to happen once a class has one.
;;;
;;; A class's symmetry group is the content slotted e-graphs add over ordinary ones,
;;; and Def. 6 is what it buys: two invocations of a class AGREE when the renaming
;;; between them lies in that group. So `=` here is rarely bookkeeping -- in most
;;; sections it holds only because a union or a rule put the right renaming in the
;;; group, and the `!=` beside it is the renaming that stayed out.
;;;
;;; Standalone: run it as it stands.
;;;
;;;     python3 slotted/slotted-egglog.py slotted/tests/symmetry-tests.egg

(constructor F (U U) U)
(constructor G (U U) U)
(constructor H (U U) U)
(constructor K (U U) U)
(constructor P (U U) U)
(constructor A (U U) U)
(constructor T (U U) U)
(constructor Null () U)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; ground alpha-equivalence, with no rules at all
;;;
;;; f($20,$1) and f($7,$8) are one class invoked at different slots: equal up to
;;; renaming, not equal. Same for a bare slot, which is the variable class under
;;; a renaming rather than a class of its own.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let a (F $20 $1))
(let a2 (F $20 $1))
(let b (F $7 $8))

(run 0)

(check (= a a2))
(check (!= a b))
(check (renaming-= a b))

(check (= $3 $3))
(check (!= $3 $4))
(check (renaming-= $3 $4))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; a rule's symmetry has to reach the PARENT by congruence
;;;
;;; Commutativity is a symmetry of f's class, not a new term, so nothing rewrites
;;; `g(f($1,$2))` -- congruence has to carry the swap up on its own.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rewrite (F ?x ?y) (F ?y ?x) :name comm)

(let a (G (F $1 $2) (Null)))
(let b (G (F $2 $1) (Null)))
(let c (G (F $1 $3) (Null)))

(run 10)

(check (= a b))
(check (!= a c))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; the group is CLOSED, so one union gives every power of the renaming
;;;
;;; Unioning $a0 with $a1 records the 3-cycle [0->1,1->2,2->0]. Its square must
;;; follow from closure, giving $a2 -- while the transposition [0<->1], which the
;;; 3-cycle does not generate, must stay out.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let a0 (P (P $0 $1) $2))
(let a1 (P (P $1 $2) $0))
(let a2 (P (P $2 $0) $1))
(let a3 (P (P $1 $0) $2))
(union a0 a1)

(run 0)

(check (= a0 a2))
(check (!= a0 a3))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; a union chain whose renamings have to COMPOSE
;;;
;;; f[$1,$2] = g[$2,$1] and g[$3,$4] = h[$3,$4] give f[$4,$3] = h[$3,$4]. `h`
;;; itself gains no symmetry, so h[$4,$3] stays apart.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(union (F $1 $2) (G $2 $1))
(union (G $3 $4) (H $3 $4))

(let f43 (F $4 $3))
(let h34 (H $3 $4))
(let h43 (H $4 $3))

(run 0)

(check (= f43 h34))
(check (!= f43 h43))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; two merges of one pair at different invocations GENERATE a symmetry
;;;
;;; 3.5, step 2. Neither union alone says f is symmetric; together they do, and
;;; the new symmetry then has to reach the parent by congruence.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let f12 (F $1 $2))
(union f12 (G $1 $2))
(union f12 (G $2 $1))

(let f21 (F $2 $1))
(let f13 (F $1 $3))
(let g12 (G $1 $2))
(let g21 (G $2 $1))
(let p1 (H (F $1 $2) (Null)))
(let p2 (H (F $2 $1) (Null)))

(run 0)

(check (= f12 f21))
(check (= g12 g21))
(check (= p1 p2))
(check (!= f12 f13))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; renamings are INJECTIVE
;;;
;;; k($5,$5) and k($5,$6) are not equal, and no renaming relates them either --
;;; one would have to send $5 to both $5 and $6.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let a (K $5 $5))
(let b (K $5 $6))

(run 0)

(check (!= a b))
(check (renaming-!= a b))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; a repeated pattern variable matches up to a SYMMETRY of the child
;;;
;;; `f(?x, ?x)` demands one renamed id at both positions, and Def. 6 says the two
;;; occurrences agree when the renaming between them is a symmetry. `a` is made
;;; symmetric, so f(a[$0,$1], a[$1,$0]) matches. Matching on class identity alone
;;; would be unsound; on edge equality it would miss this.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rewrite (F ?x ?x) ?x :name idem)

(let a01 (A $0 $1))
(union a01 (A $1 $0))

(let t (F (A $0 $1) (A $1 $0)))
(let s (F (A $0 $1) (A $0 $2)))

(run 10)

(check (= t a01))
(check (!= s a01))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; the same rule WITHOUT the symmetry, which is what makes the last one a test
;;;
;;; a[$0,$1] and a[$1,$0] are one class but two different renamed ids, so
;;; `f(?x,?x)` must not match -- while `u`, whose children really are one renamed
;;; id, still must.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rewrite (F ?x ?x) ?x :name idem)

(let a01 (A $0 $1))
(let t (F (A $0 $1) (A $1 $0)))
(let u (F (A $0 $1) (A $0 $1)))

(run 10)

(check (= u a01))
(check (!= t a01))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; three occurrences of one variable at three different DEPTHS
;;;
;;; N occurrences need N-1 symmetry lookups, and the path to each has to be
;;; composed through the nesting before the two can be compared at all.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rewrite (T ?x (T ?x ?x)) ?x :name three)

(let a01 (A $0 $1))
(union a01 (A $1 $0))

(let e (T (A $0 $1) (T (A $1 $0) (A $0 $1))))
(let s (T (A $0 $1) (T (A $1 $0) (A $0 $2))))

(run 10)

(check (= e a01))
(check (!= s a01))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; rotation: both sides NEST, so every edge renaming is re-composed
;;;
;;; `f(g(x,y),z) -> g(x,f(y,z))`. The third pair repeats one slot across two
;;; distinct pattern variables, which the right-hand side has to keep repeated.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rewrite (F (G ?x ?y) ?z) (G ?x (F ?y ?z)) :name rot)

(let a (F (G $1 $2) $3))
(let b (G $1 (F $2 $3)))
(let c (F (G $5 $5) $6))
(let d (G $5 (F $5 $6)))
(let e (G $2 (F $1 $3)))

(run 10)

(check (= a b))
(check (= c d))
(check (!= a e))

(pop)
