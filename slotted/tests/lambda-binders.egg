;;; The paper's `lambda` language: what a binder does to a class's slots.
;;;
;;; Written in the SLOTTED language, so `lam $5. $5` is `(Lam $5 $5)` and not a pair of
;;; renamings into `(Var 0)`. A bound slot still rides in an edge to the variable class
;;; once compiled -- the bound slot has to be a slot of the NODE so that renamings act
;;; on it, and a node's slots come only from the images of its edges -- but that is the
;;; encoding's business, and a test of the language should not have to say it.
;;;
;;; `Lam` and `Let` bind their column 0. `App` binds nothing, which is what makes the
;;; last section a test rather than a tautology.

(constructor Lam (U U) U :binder 0)
(constructor App (U U) U)
(constructor Let (U U U) U :binder 0)
(constructor Null () U)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; alpha-equivalence of the identity function
;;;
;;;     lam $5. $5   =   lam $6. $6
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let id5 (Lam $5 $5))
(let id6 (Lam $6 $6))
(run 0)

(check (= id5 id6))
;; the bound slot is not free, so the class depends on nothing
(check (slots id5))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; a binder is not vacuous: lam $5. $5 is not lam $5. $7
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let id5 (Lam $5 $5))
(let const (Lam $5 $7))
(run 0)

(check (!= id5 const))
;; and the constant function keeps $7 free
(check (slots const $7))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; `Let`, the arity-3 binder
;;;
;;;     let $5 = f in $5   =   let $6 = f in $6
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let f (App Null Null))
(let l5 (Let $5 $5 f))
(let l6 (Let $6 $6 f))
(run 0)

(check (= l5 l6))
(check (slots l5))

(pop)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; the operator is part of the identity: App and Lam over the same slots differ
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(let a (App $5 $5))
(let l (Lam $5 $5))
(run 0)

(check (!= a l))
;; `App` binds nothing, so $5 stays free
(check (slots a $5))

(pop)
