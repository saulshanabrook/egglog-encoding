@@ -239,6 +239,44 @@
             .with_proof_testing()
             .parse_and_run_program(None, &source)
             .unwrap();
+    }
+
+    #[test]
+    fn checked_unsimplified_mode_preserves_validation_and_extracts() {
+        let source = r#"
+            (datatype E (Num i64) (Pair E E))
+            (rewrite (Pair x x) x)
+            (let p (Pair (Num 1) (Num 1)))
+            (run 2)
+            (check (= p (Num 1)))
+            (extract p)
+        "#;
+        for simplify in [false, true] {
+            let mut graph = if simplify {
+                EGraph::new_with_proofs().with_proof_testing()
+            } else {
+                EGraph::default().with_unsimplified_proof_testing()
+            };
+            assert!(graph.proof_state.proofs_enabled);
+            assert!(graph.proof_state.proof_testing);
+            assert!(graph.proof_state.verify_proofs);
+            assert_eq!(graph.proof_state.simplify_proofs, simplify);
+            let outputs = graph.parse_and_run_program(None, source).unwrap();
+            assert_eq!(
+                outputs
+                    .iter()
+                    .filter(|output| matches!(output, CommandOutput::ProveExists { .. }))
+                    .count(),
+                1
+            );
+            assert_eq!(
+                outputs
+                    .iter()
+                    .filter(|output| matches!(output, CommandOutput::ProveExtract { .. }))
+                    .count(),
+                1
+            );
+        }
     }
 
     #[test]
