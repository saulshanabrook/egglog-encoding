;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `let` binds its first child's slot
(rule ((RenamesToLeader (App3 "let" mvar0 (Var 0) m2 c2 m3 c3) ml l)
       (= v0 (map-get mvar0 0))
       (map-not-contains (map-image m3) v0))
      ((Equated (App3 "let" mvar0 (Var 0) m2 c2 m3 c3) (inverse (map-remove (inverse ml) v0)) l)) :ruleset slotted)

(rule ((= node (App3 "let" mvar0 (Var 0) m2 c2 m3 c3))
       (= v0 (map-get mvar0 0))
       (map-contains (map-image m3) v0)   ; bound slot is free here too
       (= used (map-union (map-union (map-image mvar0) (map-image m2)) (map-image m3)))
       ; the smallest slot the node does not use
       (= fresh0 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w0 (map-get fresh0 0)))
      ((union node (App3 "let" (map-of 0 w0) (Var 0) (compose (map-insert (map-image m2) v0 w0) m2) c2 m3 c3))
       (delete (App3 "let" mvar0 (Var 0) m2 c2 m3 c3))) :ruleset slotted)
