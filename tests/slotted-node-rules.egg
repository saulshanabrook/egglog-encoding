       (= e2 (Scale p1 b1 c1))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (= m1 (compose m1_o sym1))
       (= m (find-mapping m1 b1))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (and (bool= (ordering-max m1_o b1) b1) (bool-!= m1_o b1))))))
