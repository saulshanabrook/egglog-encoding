      ((union node (Merge m1 c1 m2 c2 m3 c3 m4 c4 (compose m5 m) c' m6 c6))
       (delete (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))) :ruleset slotted)

;; child-update, child 6
(rule ((RenamesToLeader c6 m c')
       (= node (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (= c6 (ordering-max c6 c'))    ; toward the leader only
