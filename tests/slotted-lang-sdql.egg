;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Let :: child binder child
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor Let (Renaming U Renaming U Renaming U) U)

;; an upper bound on the class's slots; the merge narrows it
(rule ((= e1 (Let m1 c1 m2 c2 m3 c3)))
      ((set (ClassSlots e1) (map-union (map-image m1) (map-union (map-image m2) (map-image m3))))) :ruleset slotted)

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (Let m1 c1 m2 c2 m3 c3))
       (= m (map-union (map-image m1) (map-union (map-image m2) (map-image m3)))))
      ((RenamesToLeader e1 m e1)) :ruleset slotted)

;; alpha-finder: two nodes equal up to renaming, one eliminated
(rule ((= e1 (Let m1_o c1 m2_o c2 m3_o c3))
       (= e2 (Let b1 c1 b2 c2 b3 c3))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= m (find-mapping m1 m2 m3 b1 b2 b3))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (or (and (bool= (ordering-max m1_o b1) b1) (bool-!= m1_o b1))
              (and (bool= m1_o b1)
                   (or (and (bool= (ordering-max m2_o b2) b2) (bool-!= m2_o b2))
              (and (bool= m2_o b2)
                   (and (bool= (ordering-max m3_o b3) b3) (bool-!= m3_o b3))))))))))
      ((Equated e1 m e2)
       (delete (Let m1_o c1 m2_o c2 m3_o c3))) :ruleset slotted)

;; the same solve kept as a symmetry, non-destructively
(rule ((= e (Let m1_o c1 m2_o c2 m3_o c3))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= sym_out (find-mapping m1_o m2_o m3_o m1 m2 m3))
       (= cs (ClassSlots e)))
      ((RenamesToLeader e (compose cs (compose sym_out cs)) e)) :ruleset slotted)

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (Let m1 c1 m2 c2 m3 c3))
       (!= e1 e2)
       (= e2 (ordering-max e1 e2))       ; toward the leader only
       (= nodeslots (map-union (map-image m1) (map-union (map-image m2) (map-image m3))))
       ; R takes the node's slots to the leader's, agreeing with m inverse where
       ; that is defined and minting a name where it is not
       (= R (find-mapping-total (map-domain m) nodeslots (map-domain m) m))
       (= n1 (compose R m1))
       (= n2 (compose R m2))
       (= n3 (compose R m3)))
      ((union e1 (Let n1 c1 n2 c2 n3 c3))
       (delete (Let m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;; child-update, child 1
(rule ((RenamesToLeader c1 m c')
       (= node (Let m1 c1 m2 c2 m3 c3))
       (= c1 (ordering-max c1 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c')
                  (bool-!= (compose m1 m) m1))))
      ((union node (Let (compose m1 m) c' m2 c2 m3 c3))
       (delete (Let m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;; child-update, child 2
(rule ((RenamesToLeader c2 m c')
       (= node (Let m1 c1 m2 c2 m3 c3))
       (= c2 (ordering-max c2 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c2 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c2 c')
                  (bool-!= (compose m2 m) m2))))
      ((union node (Let m1 c1 (compose m2 m) c' m3 c3))
       (delete (Let m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;; child-update, child 3
(rule ((RenamesToLeader c3 m c')
       (= node (Let m1 c1 m2 c2 m3 c3))
       (= c3 (ordering-max c3 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c3 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c3 c')
                  (bool-!= (compose m3 m) m3))))
      ((union node (Let m1 c1 m2 c2 (compose m3 m) c'))
       (delete (Let m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Num :: i64 -- declared by the generic encoding
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Symbol :: String
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor Symbol (String) U)

;; an upper bound on the class's slots; the merge narrows it
(rule ((= e1 (Symbol p1)))
      ((set (ClassSlots e1) (map-empty))) :ruleset slotted)

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (Symbol p1))
       (= m (map-empty)))
      ((RenamesToLeader e1 m e1)) :ruleset slotted)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; binders
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; `Lambda` binds child 1, one rule per bound slot
(rule ((RenamesToLeader (Lambda mvar0 (Var 0) m2 c2) ml l)
       (= v0 (map-get mvar0 0)))
      ((Equated (Lambda mvar0 (Var 0) m2 c2) (inverse (map-remove (inverse ml) v0)) l)) :ruleset slotted)

;; `Sum` binds child 2, 3, one rule per bound slot
(rule ((RenamesToLeader (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) ml l)
       (= v0 (map-get mvar0 0))
       (map-not-contains (map-image m1) v0))
      ((Equated (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) (inverse (map-remove (inverse ml) v0)) l)) :ruleset slotted)

(rule ((= node (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))
       (= v0 (map-get mvar0 0))
       (map-contains (map-image m1) v0)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-image m1) (map-image mvar0)) (map-image mvar1)) (map-image m4)))
       ; the smallest slot the node does not use
       (= fresh0 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w0 (map-get fresh0 0)))
      ((union node (Sum m1 c1 (map-of 0 w0) (Var 0) mvar1 (Var 0) (compose (map-insert (map-image m4) v0 w0) m4) c4))
       (delete (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))) :ruleset slotted)

(rule ((RenamesToLeader (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) ml l)
       (= v1 (map-get mvar1 0))
       (map-not-contains (map-image m1) v1))
      ((Equated (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4) (inverse (map-remove (inverse ml) v1)) l)) :ruleset slotted)

(rule ((= node (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))
       (= v1 (map-get mvar1 0))
       (map-contains (map-image m1) v1)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-image m1) (map-image mvar0)) (map-image mvar1)) (map-image m4)))
       ; the smallest slot the node does not use
       (= fresh1 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w1 (map-get fresh1 0)))
      ((union node (Sum m1 c1 mvar0 (Var 0) (map-of 0 w1) (Var 0) (compose (map-insert (map-image m4) v1 w1) m4) c4))
       (delete (Sum m1 c1 mvar0 (Var 0) mvar1 (Var 0) m4 c4))) :ruleset slotted)

;; `Merge` binds child 3, 4, 5, one rule per bound slot
(rule ((RenamesToLeader (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6) ml l)
       (= v0 (map-get mvar0 0))
       (map-not-contains (map-image m1) v0)
       (map-not-contains (map-image m2) v0))
      ((Equated (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6) (inverse (map-remove (inverse ml) v0)) l)) :ruleset slotted)

(rule ((= node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))
       (= v0 (map-get mvar0 0))
       (map-contains (map-image m1) v0)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-union (map-union (map-image m1) (map-image m2)) (map-image mvar0)) (map-image mvar1)) (map-image mvar2)) (map-image m6)))
       ; the smallest slot the node does not use
       (= fresh0 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w0 (map-get fresh0 0)))
      ((union node (Merge m1 c1 m2 c2 (map-of 0 w0) (Var 0) mvar1 (Var 0) mvar2 (Var 0) (compose (map-insert (map-image m6) v0 w0) m6) c6))
       (delete (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))) :ruleset slotted)

(rule ((= node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))
       (= v0 (map-get mvar0 0))
       (map-contains (map-image m2) v0)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-union (map-union (map-image m1) (map-image m2)) (map-image mvar0)) (map-image mvar1)) (map-image mvar2)) (map-image m6)))
       ; the smallest slot the node does not use
       (= fresh0 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w0 (map-get fresh0 0)))
      ((union node (Merge m1 c1 m2 c2 (map-of 0 w0) (Var 0) mvar1 (Var 0) mvar2 (Var 0) (compose (map-insert (map-image m6) v0 w0) m6) c6))
       (delete (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))) :ruleset slotted)

(rule ((RenamesToLeader (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6) ml l)
       (= v1 (map-get mvar1 0))
       (map-not-contains (map-image m1) v1)
       (map-not-contains (map-image m2) v1))
      ((Equated (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6) (inverse (map-remove (inverse ml) v1)) l)) :ruleset slotted)

(rule ((= node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))
       (= v1 (map-get mvar1 0))
       (map-contains (map-image m1) v1)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-union (map-union (map-image m1) (map-image m2)) (map-image mvar0)) (map-image mvar1)) (map-image mvar2)) (map-image m6)))
       ; the smallest slot the node does not use
       (= fresh1 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w1 (map-get fresh1 0)))
      ((union node (Merge m1 c1 m2 c2 mvar0 (Var 0) (map-of 0 w1) (Var 0) mvar2 (Var 0) (compose (map-insert (map-image m6) v1 w1) m6) c6))
       (delete (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))) :ruleset slotted)

(rule ((= node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))
       (= v1 (map-get mvar1 0))
       (map-contains (map-image m2) v1)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-union (map-union (map-image m1) (map-image m2)) (map-image mvar0)) (map-image mvar1)) (map-image mvar2)) (map-image m6)))
       ; the smallest slot the node does not use
       (= fresh1 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w1 (map-get fresh1 0)))
      ((union node (Merge m1 c1 m2 c2 mvar0 (Var 0) (map-of 0 w1) (Var 0) mvar2 (Var 0) (compose (map-insert (map-image m6) v1 w1) m6) c6))
       (delete (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))) :ruleset slotted)

(rule ((RenamesToLeader (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6) ml l)
       (= v2 (map-get mvar2 0))
       (map-not-contains (map-image m1) v2)
       (map-not-contains (map-image m2) v2))
      ((Equated (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6) (inverse (map-remove (inverse ml) v2)) l)) :ruleset slotted)

(rule ((= node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))
       (= v2 (map-get mvar2 0))
       (map-contains (map-image m1) v2)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-union (map-union (map-image m1) (map-image m2)) (map-image mvar0)) (map-image mvar1)) (map-image mvar2)) (map-image m6)))
       ; the smallest slot the node does not use
       (= fresh2 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w2 (map-get fresh2 0)))
      ((union node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) (map-of 0 w2) (Var 0) (compose (map-insert (map-image m6) v2 w2) m6) c6))
       (delete (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))) :ruleset slotted)

(rule ((= node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))
       (= v2 (map-get mvar2 0))
       (map-contains (map-image m2) v2)   ; bound slot is free here too
       (= used (map-union (map-union (map-union (map-union (map-union (map-image m1) (map-image m2)) (map-image mvar0)) (map-image mvar1)) (map-image mvar2)) (map-image m6)))
       ; the smallest slot the node does not use
       (= fresh2 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w2 (map-get fresh2 0)))
      ((union node (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) (map-of 0 w2) (Var 0) (compose (map-insert (map-image m6) v2 w2) m6) c6))
       (delete (Merge m1 c1 m2 c2 mvar0 (Var 0) mvar1 (Var 0) mvar2 (Var 0) m6 c6))) :ruleset slotted)

;; `Let` binds child 2, one rule per bound slot
(rule ((RenamesToLeader (Let m1 c1 mvar0 (Var 0) m3 c3) ml l)
       (= v0 (map-get mvar0 0))
       (map-not-contains (map-image m1) v0))
      ((Equated (Let m1 c1 mvar0 (Var 0) m3 c3) (inverse (map-remove (inverse ml) v0)) l)) :ruleset slotted)

(rule ((= node (Let m1 c1 mvar0 (Var 0) m3 c3))
       (= v0 (map-get mvar0 0))
       (map-contains (map-image m1) v0)   ; bound slot is free here too
       (= used (map-union (map-union (map-image m1) (map-image mvar0)) (map-image m3)))
       ; the smallest slot the node does not use
       (= fresh0 (find-mapping-total used (map-of 0 0) (map-empty) (map-empty)))
       (= w0 (map-get fresh0 0)))
      ((union node (Let m1 c1 (map-of 0 w0) (Var 0) (compose (map-insert (map-image m3) v0 w0) m3) c3))
       (delete (Let m1 c1 mvar0 (Var 0) m3 c3))) :ruleset slotted)
