;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Merge :: child child binder binder binder child
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor Merge (Renaming U Renaming U Renaming U Renaming U Renaming U Renaming U) U)

;; an upper bound on the class's slots; the merge narrows it
(rule ((= e1 (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6)))
      ((set (ClassSlots e1) (map-union (map-image m1) (map-union (map-image m2) (map-union (map-image m3) (map-union (map-image m4) (map-union (map-image m5) (map-image m6)))))))) :ruleset slotted)

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (= m (map-union (map-image m1) (map-union (map-image m2) (map-union (map-image m3) (map-union (map-image m4) (map-union (map-image m5) (map-image m6))))))))
      ((RenamesToLeader e1 m e1)) :ruleset slotted)

;; alpha-finder: two nodes equal up to renaming, one eliminated
(rule ((= e1 (Merge m1_o c1 m2_o c2 m3_o c3 m4_o c4 m5_o c5 m6_o c6))
       (= e2 (Merge b1 c1 b2 c2 b3 c3 b4 c4 b5 c5 b6 c6))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (RenamesToLeader c4 sym4 c4)
       (RenamesToLeader c5 sym5 c5)
       (RenamesToLeader c6 sym6 c6)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= m4 (compose m4_o sym4))
       (= m5 (compose m5_o sym5))
       (= m6 (compose m6_o sym6))
       (= m (find-mapping m1 m2 m3 m4 m5 m6 b1 b2 b3 b4 b5 b6))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (or (and (bool= (ordering-max m1_o b1) b1) (bool-!= m1_o b1))
              (and (bool= m1_o b1)
                   (or (and (bool= (ordering-max m2_o b2) b2) (bool-!= m2_o b2))
              (and (bool= m2_o b2)
                   (or (and (bool= (ordering-max m3_o b3) b3) (bool-!= m3_o b3))
              (and (bool= m3_o b3)
                   (or (and (bool= (ordering-max m4_o b4) b4) (bool-!= m4_o b4))
              (and (bool= m4_o b4)
                   (or (and (bool= (ordering-max m5_o b5) b5) (bool-!= m5_o b5))
              (and (bool= m5_o b5)
                   (and (bool= (ordering-max m6_o b6) b6) (bool-!= m6_o b6))))))))))))))))
      ((Equated e1 m e2)
       (delete (Merge m1_o c1 m2_o c2 m3_o c3 m4_o c4 m5_o c5 m6_o c6))) :ruleset slotted)

;; the same solve kept as a symmetry, non-destructively
(rule ((= e (Merge m1_o c1 m2_o c2 m3_o c3 m4_o c4 m5_o c5 m6_o c6))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (RenamesToLeader c4 sym4 c4)
       (RenamesToLeader c5 sym5 c5)
       (RenamesToLeader c6 sym6 c6)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= m4 (compose m4_o sym4))
       (= m5 (compose m5_o sym5))
       (= m6 (compose m6_o sym6))
       (= sym_out (find-mapping m1_o m2_o m3_o m4_o m5_o m6_o m1 m2 m3 m4 m5 m6))
       (= cs (ClassSlots e)))
      ((RenamesToLeader e (compose cs (compose sym_out cs)) e)) :ruleset slotted)

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (!= e1 e2)
       (= e2 (ordering-max e1 e2))       ; toward the leader only
       (= nodeslots (map-union (map-image m1) (map-union (map-image m2) (map-union (map-image m3) (map-union (map-image m4) (map-union (map-image m5) (map-image m6)))))))
       ; R takes the node's slots to the leader's, agreeing with m inverse where
       ; that is defined and minting a name where it is not
       (= R (find-mapping-total (map-domain m) nodeslots (map-domain m) m))
       (= n1 (compose R m1))
       (= n2 (compose R m2))
       (= n3 (compose R m3))
       (= n4 (compose R m4))
       (= n5 (compose R m5))
       (= n6 (compose R m6)))
      ((union e1 (Merge n1 c1 n2 c2 n3 c3 n4 c4 n5 c5 n6 c6))
       (delete (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))) :ruleset slotted)

;; child-update, child 1
(rule ((RenamesToLeader c1 m c')
       (= node (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (= c1 (ordering-max c1 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c')
                  (bool-!= (compose m1 m) m1))))
      ((union node (Merge (compose m1 m) c' m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (delete (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))) :ruleset slotted)

;; child-update, child 2
(rule ((RenamesToLeader c2 m c')
       (= node (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (= c2 (ordering-max c2 c'))    ; toward the leader only
