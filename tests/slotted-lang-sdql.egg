      ((union node (Merge m1 c1 (compose m2 m) c' m3 c3 m4 c4 m5 c5 m6 c6))
       (delete (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))) :ruleset slotted)

;; child-update, child 3
(rule ((RenamesToLeader c3 m c')
       (= node (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (= c3 (ordering-max c3 c'))    ; toward the leader only
