;; child-update, child 5
(rule ((RenamesToLeader c5 m c')
       (= node (Merge m1 c1 m2 c2 m3 c3 m4 c4 m5 c5 m6 c6))
       (= c5 (ordering-max c5 c'))    ; toward the leader only
