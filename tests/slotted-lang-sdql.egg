       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= sym_out (find-mapping m1_o m2_o m3_o m1 m2 m3))
       (= cs (ClassSlots e)))
      ((RenamesToLeader e (compose cs (compose sym_out cs)) e)) :ruleset slotted)

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (SubArray m1 c1 m2 c2 m3 c3))
       (!= e1 e2)
       (= e2 (ordering-max e1 e2))       ; toward the leader only
       (= nodeslots (map-union (map-image m1) (map-union (map-image m2) (map-image m3))))
       ; R takes the node's slots to the leader's, agreeing with m inverse where
       ; that is defined and minting a name where it is not
       (= R (find-mapping-total (map-domain m) nodeslots (map-domain m) m))
       (= n1 (compose R m1))
       (= n2 (compose R m2))
       (= n3 (compose R m3)))
      ((union e1 (SubArray n1 c1 n2 c2 n3 c3))
       (delete (SubArray m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;; child-update, child 1
(rule ((RenamesToLeader c1 m c')
       (= node (SubArray m1 c1 m2 c2 m3 c3))
       (= c1 (ordering-max c1 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c')
                  (bool-!= (compose m1 m) m1))))
      ((union node (SubArray (compose m1 m) c' m2 c2 m3 c3))
       (delete (SubArray m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;; child-update, child 2
(rule ((RenamesToLeader c2 m c')
       (= node (SubArray m1 c1 m2 c2 m3 c3))
       (= c2 (ordering-max c2 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c2 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c2 c')
                  (bool-!= (compose m2 m) m2))))
      ((union node (SubArray m1 c1 (compose m2 m) c' m3 c3))
       (delete (SubArray m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;; child-update, child 3
(rule ((RenamesToLeader c3 m c')
       (= node (SubArray m1 c1 m2 c2 m3 c3))
       (= c3 (ordering-max c3 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c3 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c3 c')
                  (bool-!= (compose m3 m) m3))))
      ((union node (SubArray m1 c1 m2 c2 (compose m3 m) c'))
       (delete (SubArray m1 c1 m2 c2 m3 c3))) :ruleset slotted)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Unique :: child
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor Unique (Renaming U) U)

;; an upper bound on the class's slots; the merge narrows it
(rule ((= e1 (Unique m1 c1)))
      ((set (ClassSlots e1) (map-image m1))) :ruleset slotted)

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (Unique m1 c1))
       (= m (map-image m1)))
      ((RenamesToLeader e1 m e1)) :ruleset slotted)

;; alpha-finder: two nodes equal up to renaming, one eliminated
(rule ((= e1 (Unique m1_o c1))
       (= e2 (Unique b1 c1))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (= m1 (compose m1_o sym1))
       (= m (find-mapping m1 b1))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (and (bool= (ordering-max m1_o b1) b1) (bool-!= m1_o b1))))))
      ((Equated e1 m e2)
       (delete (Unique m1_o c1))) :ruleset slotted)

;; the same solve kept as a symmetry, non-destructively
(rule ((= e (Unique m1_o c1))
       (RenamesToLeader c1 sym1 c1)
       (= m1 (compose m1_o sym1))
       (= sym_out (find-mapping m1_o m1))
       (= cs (ClassSlots e)))
      ((RenamesToLeader e (compose cs (compose sym_out cs)) e)) :ruleset slotted)

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (Unique m1 c1))
       (!= e1 e2)
       (= e2 (ordering-max e1 e2))       ; toward the leader only
       (= nodeslots (map-image m1))
       ; R takes the node's slots to the leader's, agreeing with m inverse where
       ; that is defined and minting a name where it is not
       (= R (find-mapping-total (map-domain m) nodeslots (map-domain m) m))
       (= n1 (compose R m1)))
      ((union e1 (Unique n1 c1))
       (delete (Unique m1 c1))) :ruleset slotted)

;; child-update, child 1
(rule ((RenamesToLeader c1 m c')
       (= node (Unique m1 c1))
       (= c1 (ordering-max c1 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c')
                  (bool-!= (compose m1 m) m1))))
      ((union node (Unique (compose m1 m) c'))
       (delete (Unique m1 c1))) :ruleset slotted)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Sum :: child binder binder child
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(constructor Sum (Renaming U Renaming U Renaming U Renaming U) U)

;; an upper bound on the class's slots; the merge narrows it
(rule ((= e1 (Sum m1 c1 m2 c2 m3 c3 m4 c4)))
      ((set (ClassSlots e1) (map-union (map-image m1) (map-union (map-image m2) (map-union (map-image m3) (map-image m4)))))) :ruleset slotted)

;; every class holding a node has a self-loop, so a query can reach it
(rule ((= e1 (Sum m1 c1 m2 c2 m3 c3 m4 c4))
       (= m (map-union (map-image m1) (map-union (map-image m2) (map-union (map-image m3) (map-image m4))))))
      ((RenamesToLeader e1 m e1)) :ruleset slotted)

;; alpha-finder: two nodes equal up to renaming, one eliminated
(rule ((= e1 (Sum m1_o c1 m2_o c2 m3_o c3 m4_o c4))
       (= e2 (Sum b1 c1 b2 c2 b3 c3 b4 c4))
       (= e1 (ordering-max e1 e2))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (RenamesToLeader c4 sym4 c4)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= m4 (compose m4_o sym4))
       (= m (find-mapping m1 m2 m3 m4 b1 b2 b3 b4))
       (guard
         (or (bool-!= e1 e2)
             (and (bool= e1 e2)
                  (or (and (bool= (ordering-max m1_o b1) b1) (bool-!= m1_o b1))
              (and (bool= m1_o b1)
                   (or (and (bool= (ordering-max m2_o b2) b2) (bool-!= m2_o b2))
              (and (bool= m2_o b2)
                   (or (and (bool= (ordering-max m3_o b3) b3) (bool-!= m3_o b3))
              (and (bool= m3_o b3)
                   (and (bool= (ordering-max m4_o b4) b4) (bool-!= m4_o b4))))))))))))
      ((Equated e1 m e2)
       (delete (Sum m1_o c1 m2_o c2 m3_o c3 m4_o c4))) :ruleset slotted)

;; the same solve kept as a symmetry, non-destructively
(rule ((= e (Sum m1_o c1 m2_o c2 m3_o c3 m4_o c4))
       (RenamesToLeader c1 sym1 c1)
       (RenamesToLeader c2 sym2 c2)
       (RenamesToLeader c3 sym3 c3)
       (RenamesToLeader c4 sym4 c4)
       (= m1 (compose m1_o sym1))
       (= m2 (compose m2_o sym2))
       (= m3 (compose m3_o sym3))
       (= m4 (compose m4_o sym4))
       (= sym_out (find-mapping m1_o m2_o m3_o m4_o m1 m2 m3 m4))
       (= cs (ClassSlots e)))
      ((RenamesToLeader e (compose cs (compose sym_out cs)) e)) :ruleset slotted)

;; migration: move a follower's node into the leader's frame
(rule ((RenamesToLeader e2 m e1)
       (= e2 (Sum m1 c1 m2 c2 m3 c3 m4 c4))
       (!= e1 e2)
       (= e2 (ordering-max e1 e2))       ; toward the leader only
       (= nodeslots (map-union (map-image m1) (map-union (map-image m2) (map-union (map-image m3) (map-image m4)))))
       ; R takes the node's slots to the leader's, agreeing with m inverse where
       ; that is defined and minting a name where it is not
       (= R (find-mapping-total (map-domain m) nodeslots (map-domain m) m))
       (= n1 (compose R m1))
       (= n2 (compose R m2))
       (= n3 (compose R m3))
       (= n4 (compose R m4)))
      ((union e1 (Sum n1 c1 n2 c2 n3 c3 n4 c4))
       (delete (Sum m1 c1 m2 c2 m3 c3 m4 c4))) :ruleset slotted)

;; child-update, child 1
(rule ((RenamesToLeader c1 m c')
       (= node (Sum m1 c1 m2 c2 m3 c3 m4 c4))
       (= c1 (ordering-max c1 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
       (guard (or (bool-!= c1 c') (bool= (compose m m) m)))
       ; and the new node must differ from the old one
       (guard (or (bool-!= c1 c')
                  (bool-!= (compose m1 m) m1))))
      ((union node (Sum (compose m1 m) c' m2 c2 m3 c3 m4 c4))
       (delete (Sum m1 c1 m2 c2 m3 c3 m4 c4))) :ruleset slotted)

;; child-update, child 2
(rule ((RenamesToLeader c2 m c')
       (= node (Sum m1 c1 m2 c2 m3 c3 m4 c4))
       (= c2 (ordering-max c2 c'))    ; toward the leader only
       ; if the class is unchanged then m must be idempotent: no self-symmetries
