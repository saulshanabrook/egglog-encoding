       (guard (or (bool-!= c3 c')
                  (bool-!= (compose m3 m) m3))))
      ((union node (Sum m1 c1 m2 c2 (compose m3 m) c' m4 c4))
       (delete (Sum m1 c1 m2 c2 m3 c3 m4 c4))) :ruleset slotted)

;; child-update, child 4
(rule ((RenamesToLeader c4 m c')
       (= node (Sum m1 c1 m2 c2 m3 c3 m4 c4))
       (= c4 (ordering-max c4 c'))    ; toward the leader only
