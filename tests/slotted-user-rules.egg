;;; Hand-encoded *user* rules on top of the slotted machinery.  Rationale and
;;; notation are in `slotted-user-rules.md`; the short version:
;;;
;;;   a U-sorted rule variable is a renamed id `m * c`, not an e-class, so each
;;;   user variable `x` compiles to a leader `X` plus a renaming
;;;   `mx : slots(X) -> slots(pattern)`.  slots(pattern) is the slot space of
;;;   whichever atom matching starts from, so that atom's `mp` is the identity.
;;;
;;;   (compose a b)           = a . b, b first:  (compose a b)[x] = a[b[x]]
;;;   (App f m1 c1 m2 c2)     = f(m1*c1, m2*c2),  mi : slots(ci) -> slots(node)
;;;   (RenamesToLeader a m b) = a = m*b,          m  : slots(b)  -> slots(a)
;;;   (RenamesToLeader c m c) = m is in G(c)
;;;
;;; Each (push) block re-declares its rules so sections do not interfere.

(include "tests/slotted-egraph-encoding-11.egg")


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; U1.  (rule ((= e (App "f" a b))) ((union e (App "f" b a))))
;;;
;;; One atom, no repeated variable, so nothing to check: the stored edges are
;;; already the pattern-slot renamings.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule ((= e (App "f" ma a mb b)))
      ((union e (App "f" mb b ma a))))

(let $f01 (App "f" (map-insert (map-empty) 0 0) (Var 0)
                   (map-insert (map-empty) 1 1) (Var 1)))
(run 15)

;; commutativity == the e-class gains the swap symmetry
(check (RenamesToLeader $f01 m $f01)
       (= (map-get m 0) 1)
       (= (map-get m 1) 0))

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; U2.  (rule ((= e (App "f" x x))) ((union e x)))
;;;
;;; `x` twice in one atom gives two renamed ids of one leader.  Def. 6: they
;;; agree iff m1^-1 . m2 is in G(X).  Both renamings are bound, so the group
;;; element is determined -- compute it and look it up rather than enumerating.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; TODO this is wrong because RenamesToLeader needs to be oriented to smaller
;; ids.  Could use a TodoRenameToLeader or an egglog primitive.
(rule ((= e (App "f" m1 x m2 x))
       (= sym (compose (inverse m1) m2))
       (RenamesToLeader x sym x))
      ((RenamesToLeader e m1 x)))        ; renamed union: e = m1*X

;; the enumerate-then-compare spelling, as a cross-check
(relation Enum (U U))
(rule ((= e (App "f" m1 x m2 x))
       (RenamesToLeader x sym x)
       (= m2 (compose m1 sym)))
      ((Enum e x)))

;; what a naive encoding would do: demand the two edges be *equal*
(relation NaiveHit (U U))
(rule ((= e (App "f" m1 x m1 x))) ((NaiveHit e x)))

;; (a) trivial symmetry, edges literally equal
(push)
(let $ff (App "f" (map-insert (map-empty) 7 7) (Var 7)
                  (map-insert (map-empty) 7 7) (Var 7)))
(run 15)
(check (RenamesToLeader $ff m (Var 0)) (= (map-get m 0) 7))
(check (Enum $ff (Var 0)))
(pop)

;; (b) negative: distinct slots, so distinct renamed ids
(push)
(let $fg (App "f" (map-insert (map-empty) 7 7) (Var 7)
                  (map-insert (map-empty) 8 8) (Var 8)))
(run 15)
(fail (check (RenamesToLeader $fg m (Var 0))))
(fail (check (Enum $fg x)))
(pop)

;; (c) f(a[$0,$1], a[$1,$0]) matches f(x,x) only because a is symmetric, and
;;     the machinery never normalizes the two edges to be equal -- so NaiveHit
;;     stays empty while the Def. 6 check fires.
(push)
(let $a01 (App "a" (map-insert (map-empty) 0 0) (Var 0)
                   (map-insert (map-empty) 1 1) (Var 1)))
(let $a10 (App "a" (map-insert (map-empty) 1 1) (Var 1)
                   (map-insert (map-empty) 0 0) (Var 0)))
(union $a01 $a10)                        ; a[$0,$1] = a[$1,$0]
(run 20)

(let $t (App "f" (map-insert (map-insert (map-empty) 0 0) 1 1) $a01
                 (map-insert (map-insert (map-empty) 0 1) 1 0) $a01))
(run 20)
(check (RenamesToLeader $t m $a01))
(check (Enum $t $a01))
(fail (check (NaiveHit $t $a01)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; U3.  (rule ((= p (App "f" x y)) (= q (App "g" x y))) ((union p q)))
;;;
;;; Two atoms binding the same variables.  Atom 1 is the initial atom; atom 2's
;;; root is fresh, so we solve for the paper's `mp'` -- the least renaming with
;;; mp' . p2 = p1 . sx  and  mp' . q2 = q1 . sy.  That is `find-mapping`, whose
;;; injectivity check is the paper's "mp union mp' is bijective".
;;;
;;; From Rudi: with N occurrences of a variable you need N-1 symmetries.
;;; Here N = 2.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

;; Rudi's version, NOT ENABLED -- it does not typecheck as written, in two ways
;; worth resolving:
;;
;;   (rule ((= p (App "f" p1 x q1 y))
;;          (= q (App "g" p2 x q2 y))
;;          ;; p1 * x = p2 * x,  so  x = p1^(-1) * p2 * x
;;          (RenamesToLeader x (compose (inverse p1) p2) x)
;;          (RenamesToLeader y (compose (inverse q1) q2) y)
;;          ;; want r * p2 = p1, r * q2 = q1, but with symmetry
;;          (= r (find-mapping (compose p1 sx) (compose q1 sy) p2 q2)))
;;         ((TodoSetRenamesToLeader q r p)))
;;
;;   1. sx / sy are unbound -- the probe form replaced them in the constraints
;;      but find-mapping still needs them to enumerate the candidate glues.
;;   2. (compose (inverse p1) p2) mixes slot spaces: inverse p1 maps slots(p)
;;      to slots(x), p2 maps slots(x) to slots(q).  It only lands anywhere if
;;      p and q happen to have picked the same slot names.  Relating x's two
;;      occurrences has to go through mp', which is what makes mp' the unknown.
;;
;; Worked example the shorthand above is about:
;;      f(x, y)  with edges {0->x} {0->y}
;;      g(z, j)  with edges {0->z} {0->j}
;;   -> f(x, y) = {x->z, y->j} * g(z, j)

(rule ((= p (App "f" p1 x q1 y))
       (= q (App "g" p2 x q2 y))
       (RenamesToLeader x sx x)
       (RenamesToLeader y sy y)
       (= mp' (find-mapping (compose p1 sx) (compose q1 sy) p2 q2)))
      ((RenamesToLeader p mp' q)))      ; p = mp' * q

;; build mp' from x alone, then try to *check* y against it.  Incomplete: until
;; the last shared variable is in, mp' is partial and the rest cannot be
;; evaluated.
(relation TooEager (U U))
(rule ((= p (App "f" p1 x q1 y))
       (= q (App "g" p2 x q2 y))
       (RenamesToLeader x sx x)
       (= mp' (compose (compose p1 sx) (inverse p2)))
       (= sy (compose (inverse q1) (compose mp' q2)))
       (RenamesToLeader y sy y))
      ((TooEager p q)))

;; same e-classes, same edges, no mp'
(relation NaiveHit (U U))
(rule ((= p (App "f" p1 x q1 y))
       (= q (App "g" p1 x q1 y)))
      ((NaiveHit p q)))

;; (a) positive, mp' = identity.  im(p2) = {$0} misses q's slot $1, so TooEager
;;     loses the match.
(push)
(let $P (App "f" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $Q (App "g" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(run 20)
(check (RenamesToLeader $P m $Q))
(fail (check (TooEager $P $Q)))
(pop)

;; (b) negative: g's children are one renamed id, f's are two -- no mp' fits
(push)
(let $P (App "f" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $Q (App "g" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 0 0) (Var 0)))
(run 20)
(fail (check (RenamesToLeader $P m $Q)))
(fail (check (RenamesToLeader $Q m $P)))
(pop)

;; (c) f(a[$0,$1], v[$0]) vs g(a[$1,$0], v[$0]): v pins mp'[$0] = $0, so sx must
;;     be the swap.  Here im(p2) covers all of q's slots, so TooEager happens to
;;     work -- a property of the data, not of the rule.
(push)
(let $a01 (App "a" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $a10 (App "a" (map-insert (map-empty) 1 1) (Var 1) (map-insert (map-empty) 0 0) (Var 0)))
(union $a01 $a10)
(run 20)

(let $P (App "f" (map-insert (map-insert (map-empty) 0 0) 1 1) $a01
                 (map-insert (map-empty) 0 0) (Var 0)))
(let $Q (App "g" (map-insert (map-insert (map-empty) 0 1) 1 0) $a01
                 (map-insert (map-empty) 0 0) (Var 0)))
(run 20)
(check (RenamesToLeader $P m $Q))
(check (TooEager $P $Q))
(fail (check (NaiveHit $P $Q)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; U4. eta:  (lam $s (app ?f (var $s))) -> ?f   if $s not in slots(?f)
;;;
;;; `b` is a child of atom 1 and the root of atom 2, so atom 2's `mp` is `mb`
;;; composed with an element of G(b) -- that join *is* the Def. 6 check for b's
;;; second occurrence.  `$s` needs no special handling: (var $s) is a (Var 0)
;;; child, so "argument = bound slot" is the ordinary Def. 6 check.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(rule ((= e (App "lambda" mvar (Var 0) mb b))
       (= v (map-get mvar 0))                     ; the bound slot
       (= b (App "app" mf f mv (Var 0)))
       (RenamesToLeader b symb b)
       (= m2 (compose mb symb))                   ; atom 2's mp
       (= (compose m2 mv) mvar)                   ; argument = bound slot
       (map-not-contains (inverse (compose m2 mf)) v))   ; $s not free in ?f
      ((RenamesToLeader e (compose m2 mf) f)))

;; positive: (lam $5 (app c (var $5))) -> c
(push)
(let $c    (App "c" (map-empty) (Null) (map-empty) (Null)))
(let $body (App "app" (map-empty) $c (map-insert (map-empty) 5 5) (Var 5)))
(let $lam  (App "lambda" (map-insert (map-empty) 5 5) (Var 5)
                         (map-insert (map-empty) 5 5) $body))
(run 30)
(check (RenamesToLeader $lam m $c))
(pop)

;; negative: side condition fails -- (lam $5 (app (var $5) (var $5)))
(push)
(let $body (App "app" (map-insert (map-empty) 5 5) (Var 5)
                      (map-insert (map-empty) 5 5) (Var 5)))
(let $lam  (App "lambda" (map-insert (map-empty) 5 5) (Var 5)
                         (map-insert (map-empty) 5 5) $body))
(run 30)
(fail (check (RenamesToLeader $lam m (Var 0))))
(pop)

;; negative: wrong slot -- (lam $5 (app c (var $6)))
(push)
(let $c    (App "c" (map-empty) (Null) (map-empty) (Null)))
(let $body (App "app" (map-empty) $c (map-insert (map-empty) 6 6) (Var 6)))
(let $lam  (App "lambda" (map-insert (map-empty) 5 5) (Var 5)
                         (map-insert (map-insert (map-empty) 5 5) 6 6) $body))
(run 30)
(fail (check (RenamesToLeader $lam m $c)))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; U5.  (rule ((= p (App "f" x y)) (= q (App "g" x z)))
;;;            ((union p (App "h" y z))))
;;;
;;; Only `x` is shared, so mp' is pinned only on im(p2) and a slot of q outside
;;; that gets no name at all.  The paper picks a fresh slot (end of S3.6); a
;;; renaming is just a map, so the encoding drops it -- which asserts the slot
;;; is redundant.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; (a) unguarded: unsound
(push)
(rule ((= p (App "f" p1 x q1 y))
       (= q (App "g" p2 x q2 z))
       (RenamesToLeader x sx x)
       (= mp' (compose (compose p1 sx) (inverse p2))))
      ((union p (App "h" q1 y (compose mp' q2) z))))

(let $P (App "f" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $Q (App "g" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 5 5) (Var 5)))
(run 20)
;; h(y, z) got an empty edge to z, and unioning it into p forced p's slot $0
;; redundant: the self-map lost a slot
(check (RenamesToLeader $P m $P) (= (map-length m) 1))
(pop)

;; (b) guarded: every action-used variable must keep all its slots.  Sound but
;;     incomplete -- the rule just does not fire.
(push)
(rule ((= p (App "f" p1 x q1 y))
       (= q (App "g" p2 x q2 z))
       (RenamesToLeader x sx x)
       (= mp' (compose (compose p1 sx) (inverse p2)))
       (= mz (compose mp' q2))
       (= (map-length mz) (map-length q2)))       ; totality guard
      ((union p (App "h" q1 y mz z))))

(push)
(let $P (App "f" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $Q (App "g" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 5 5) (Var 5)))
(run 20)
(fail (check (RenamesToLeader $P m $P) (= (map-length m) 1)))
(pop)

;; z's slots are determined here, so it fires and the slot sets line up
(push)
(let $P (App "f" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $Q (App "g" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 0 0) (Var 0)))
(run 20)
(check (RenamesToLeader $P m $P) (= (map-length m) 2))
(pop)

(pop)


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; U6. Same rule as U3, but with a union that takes renamed ids.
;;;
;;;   (rule ((= p (App "f" x y)) (= q (App "g" x y))) ((Union' p q)))
;;;
;;; `(Union' s p r q)` asserts s*p = r*q -- the paper's union (S3.5), which
;;; egglog's cannot express.  Stating it covariantly in G(p) (joining s and
;;; composing it onto r) avoids having to pick an orientation here, which is
;;; the TODO in U2.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(push)

(relation Union' (Renaming U Renaming U))

;; prototype rule- does this work?
(rule ((= p (App "f" p1 x q1 y))
       (= q (App "g" p2 x q2 y))
       (RenamesToLeader x sx x)
       (RenamesToLeader y sy y)
       (RenamesToLeader p s p)
       (= r (find-mapping (compose p1 sx) (compose q1 sy) p2 q2)))
      ((Union' s p (compose s r) q)))

(let $P (App "f" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(let $Q (App "g" (map-insert (map-empty) 0 0) (Var 0) (map-insert (map-empty) 1 1) (Var 1)))
(run 20)
(check (Union' s $P r $Q))

(pop)
