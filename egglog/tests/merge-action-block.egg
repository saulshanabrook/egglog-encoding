; A value-producing `:merge` action block. Syntax: `:merge (<action>* <result-expr>)` — the
; actions run first (with `old`/`new` bound), then the trailing expression is the merged value.
; Actions may be `let`, `set`, or `union`.
;
; Here, on a conflict `f` binds the smaller/larger values with `let`, records the discarded
; (smaller) value into a side function with `set`, and keeps the larger as the merged value.
(function discarded (i64) i64 :merge new)
(function f (i64) i64
  :merge ((let smaller (min old new))
          (let larger (max old new))
          (set (discarded smaller) 1)
          larger))

(set (f 0) 5)
(set (f 0) 3)

(check (= (f 0) 5))          ; the result kept the larger (`let`-bound) value
(check (= (discarded 3) 1))  ; the `set` action recorded the discarded (smaller) value
(fail (check (= (discarded 5) 1)))

; A merge that `union`s the two conflicting outputs of an eq-sort function: on a conflict the two
; eclasses are unified and the old value is kept.
(datatype Color (Red) (Green))
(function pick (i64) Color :merge ((union old new) old))
(set (pick 0) (Red))
(set (pick 0) (Green))
(check (= (Red) (Green)))    ; the `union` action unified the conflicting values

; A collision that leaves the value unchanged is not a conflict, so the block does not run
; and its `set` writes nothing. A real conflict runs it, and the constructor call in the
; written key resolves to the constructor's own e-class.
(datatype Math (L))
(function Log (Math) i64 :merge (min old new))
(function Dist () i64 :merge ((set (Log (L)) old) new))
(set (Dist) 2)
(set (Dist) 2)
(fail (check (= (Log (L)) 2)))
(set (Dist) 1)
(check (= (Log (L)) 2))

; A tuple-output block still runs when only some value column changes, so an unchanged column
; must not make the constructor call in the block's `set` key resolve to that column's value.
(function Idx (Math) i64 :merge (min old new))
(function T () (i64 i64)
  :merge ((set (Idx (L)) old0) (values (min old0 new0) (min old1 new1))))
(set (T) (values 5 8))
(set (T) (values 5 3))
(check (= (Idx (L)) 5))
