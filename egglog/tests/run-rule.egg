(datatype Expr
  (A)
  (B)
  (C)
  (Wrap Expr))

(relation Fired (Expr))

(rule ((= root (Wrap x)))
      ((Fired x))
      :name "mark-wrapped")

(let $a (A))
(let $b (B))
(let $wrapped-a (Wrap $a))
(let $wrapped-b (Wrap $b))

;; Each list entry completely grounds one rule invocation. The whole list is
;; one run-rule schedule leaf, and every grounding implicitly expects one match.
(run-schedule
  (run-rule
    ("mark-wrapped" ((root $wrapped-a) (x $a)))))
(check (Fired $a))
(fail (check (Fired $b)))

;; A single list can retain multiple grounded invocations.
(run-schedule
  (run-rule
    ("mark-wrapped" ((root $wrapped-a) (x $a)))
    ("mark-wrapped" ((root $wrapped-b) (x $b)))))

(check (Fired $a))
(check (Fired $b))
